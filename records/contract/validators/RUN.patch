+++ b/runner/Tests/PWRunnerCoreTests/R14ExperimentTests.swift
@@ -0,0 +1,158 @@
+import Foundation
+@testable import PWRunnerCore
+
+// TEMPORARY EXPERIMENT (r14). Not a catalog case. Builds preparation-failure
+// replies and one-change variants, records the host self-check's judgment on
+// each, and encodes each WITHOUT the self-check so the Rust and Python readers
+// can judge the same bytes.
+func runR14Experiment(outputDirectory: String) throws {
+    let out = URL(fileURLWithPath: outputDirectory, isDirectory: true)
+    try FileManager.default.createDirectory(at: out, withIntermediateDirectories: true)
+    var manifest: [[String: Any]] = []
+    func emit(_ id: String, base: String, change: String, _ reply: PWRunnerRunResult) {
+        var row: [String: Any] = ["id": id, "base": base, "change": change]
+        do {
+            try reply.validateForReporting()
+            row["s_accepts"] = true
+        } catch let failure as PWRunnerReportingValidationError {
+            row["s_accepts"] = false; row["s_diagnostic"] = failure.message
+        } catch {
+            row["s_accepts"] = false; row["s_diagnostic"] = "non-validation throw: \(error)"
+        }
+        do {
+            try pwPorcelainEncode(reply).write(to: out.appendingPathComponent("\(id).pwp"))
+            row["encoded"] = true
+        } catch {
+            row["encoded"] = false; row["encode_error"] = String(describing: error)
+        }
+        manifest.append(row)
+    }
+
+    let actorDocs = try actorShapeDocuments()
+    let baselineIndices = actorDocs.indices.filter { actorDocs[$0].preparation_failure != nil && actorDocs[$0].reporting_failure == nil }
+    var notes: [String: Any] = ["actor_shape_document_count": actorDocs.count, "baseline_indices": baselineIndices]
+
+    let readyRegion = PWRunnerAuthorityScope(actor_id: "A", actor_index: 0, required: true,
+        disposition: "ready", operations: [
+            PWRunnerAuthorityOperation(slot: 0, operation: "shm_open", role: "setup", state: "succeeded",
+                native_kind: "integer", native_rc: 64, errno: nil, detail: nil, value: nil),
+            PWRunnerAuthorityOperation(slot: 1, operation: "shm_unlink", role: "setup", state: "succeeded",
+                native_kind: "integer", native_rc: 0, errno: nil, detail: nil, value: nil),
+            PWRunnerAuthorityOperation(slot: 10, operation: "shared_clear", role: "cleanup", state: "performed",
+                native_kind: "memory", native_rc: nil, errno: nil, detail: nil, value: 4096)],
+        ownership: ["object_name":"released", "descriptor":"released", "mapping":"released", "shared_erasure":"performed"])
+    let failedRegion = PWRunnerAuthorityScope(actor_id: "A", actor_index: 0,
+        required: true, disposition: "failed", primary_operation: 1, operations: [
+            PWRunnerAuthorityOperation(slot: 0, operation: "shm_open", role: "setup", state: "succeeded",
+                native_kind: "integer", native_rc: 64, errno: nil, detail: nil, value: nil),
+            PWRunnerAuthorityOperation(slot: 1, operation: "shm_unlink", role: "setup", state: "failed",
+                native_kind: "integer", native_rc: -1, errno: 1, detail: "constructed unlink refusal", value: nil)],
+        ownership: ["object_name":"unresolved", "descriptor":"released", "mapping":"not_acquired", "shared_erasure":"not_present"],
+        cleanup_reference: PWAuthorityCleanupReference(name: "/pw-shape-owned", host_pid: 42, session_nonce: 99))
+
+    for (n, index) in baselineIndices.enumerated() {
+        let base = actorDocs[index]
+        let b = "B\(n + 1)"
+        let failure = base.preparation_failure!
+        emit(b, base: b, change: "none (control): actorShapeDocuments()[\(index)], \(failure.stage)/\(failure.code), reason \(failure.reason ?? "nil")", base)
+        func variant(_ suffix: String, _ change: String, _ mutate: (inout PWRunnerRunResult) -> Void) {
+            var reply = base
+            mutate(&reply)
+            emit("\(b)-\(suffix)", base: b, change: change, reply)
+        }
+        variant("D1a", "authority_setup.host.regions = [one row for actor A (index 0), disposition ready, as the `accounted` fixture builds it]") {
+            $0.authority_setup!.host.regions = [readyRegion] }
+        variant("D1b", "authority_setup.host.regions = [one row for actor A (index 0), disposition failed with cleanup_reference, as the `recovery` fixture builds it]") {
+            $0.authority_setup!.host.regions = [failedRegion] }
+        variant("D1c", "authority_setup.host.regions = [{actor_id A, actor_index 0, required true, disposition not_attempted, operations [], ownership {}}]") {
+            $0.authority_setup!.host.regions = [PWRunnerAuthorityScope(actor_id: "A", actor_index: 0, required: true, disposition: "not_attempted")] }
+        variant("D1d", "authority_setup.host.regions = [the D1a ready row plus succeeded cleanup operations close_original_descriptor (slot 9) and munmap (slot 11)]") {
+            var row = readyRegion
+            row.operations.insert(PWRunnerAuthorityOperation(slot: 9, operation: "close_original_descriptor", role: "cleanup", state: "succeeded",
+                native_kind: "integer", native_rc: 0, errno: nil, detail: nil, value: nil), at: 2)
+            row.operations.append(PWRunnerAuthorityOperation(slot: 11, operation: "munmap", role: "cleanup", state: "succeeded",
+                native_kind: "integer", native_rc: 0, errno: nil, detail: nil, value: nil))
+            $0.authority_setup!.host.regions = [row] }
+        variant("D1e", "authority_setup.host.regions = [the D1b failed row plus a succeeded cleanup operation close_original_descriptor (slot 9)]") {
+            var row = failedRegion
+            row.operations.append(PWRunnerAuthorityOperation(slot: 9, operation: "close_original_descriptor", role: "cleanup", state: "succeeded",
+                native_kind: "integer", native_rc: 0, errno: nil, detail: nil, value: nil))
+            $0.authority_setup!.host.regions = [row] }
+        variant("N1", "preparation_failure removed (nil); nothing else changed (candidate starting point for D13)") {
+            $0.preparation_failure = nil }
+        variant("N2", "preparation_failure removed (nil) and every phase's action_ids emptied (candidate starting point for D13)") {
+            $0.preparation_failure = nil
+            for index in $0.phases.indices { $0.phases[index].action_ids = [] } }
+        variant("D2a", "phases[0].arrival_observed false -> true (phase \(base.phases[0].phase_id), actor \(base.phases[0].actor_id ?? "nil"))") {
+            $0.phases[0].arrival_observed = true }
+        variant("D2b", "phases[2].arrival_observed false -> true (phase \(base.phases[2].phase_id), actor \(base.phases[2].actor_id ?? "nil"); predecessor is actor \(base.phases[1].actor_id ?? "nil"))") {
+            $0.phases[2].arrival_observed = true }
+        variant("D3", "phases[0].ordering (was \(base.phases[0].ordering == nil ? "nil" : "present")) = {collection_closed_before_proceed: false, proceed_set: true, proceed_observed: false, validator_disposition: not_invoked, worker_lifetime_established: false, protocol_violations: []}") {
+            $0.phases[0].ordering = PWRunnerOrdering(collection_closed_before_proceed: false, proceed_set: true,
+                proceed_observed: false, validator_disposition: "not_invoked", worker_lifetime_established: false,
+                protocol_violations: []) }
+        let firstAction = base.phases[0].action_ids.first ?? "<none>"
+        variant("D4a", "phases[0].action_ids[0] \(firstAction) -> 64 bytes of 'a'") {
+            $0.phases[0].action_ids[0] = String(repeating: "a", count: 64) }
+        variant("D4b", "phases[0].action_ids[0] \(firstAction) -> empty string") {
+            $0.phases[0].action_ids[0] = "" }
+        variant("D4c", "phases[0].action_ids[0] \(firstAction) -> \"a\\u0000b\" (contains NUL)") {
+            $0.phases[0].action_ids[0] = "a\u{0}b" }
+        variant("D5", "extension_events (was \(base.extension_events.map { "array of \($0.count)" } ?? "nil")) = nil in the typed record") {
+            $0.extension_events = nil }
+        variant("D6a", "phases[0].phase_id \(base.phases[0].phase_id) -> 64 bytes of 'p'") {
+            $0.phases[0].phase_id = String(repeating: "p", count: 64) }
+        variant("D6b", "phases[0].phase_id \(base.phases[0].phase_id) -> empty string") {
+            $0.phases[0].phase_id = "" }
+        variant("D7", "phases[0].actor_visit \(base.phases[0].actor_visit.map(String.init) ?? "nil") -> 2") {
+            $0.phases[0].actor_visit = 2 }
+        let visits = base.actors![0].visits
+        variant("D8", "actors[0].visits \(visits) -> []") { $0.actors![0].visits = [] }
+        variant("D9a", "actors[0].visits \(visits) -> \(visits + [8]) (8 is the ordinal of another actor's phase)") {
+            $0.actors![0].visits.append(8) }
+        variant("D9b", "actors[0].visits \(visits) -> \(visits + [9]) (9 exceeds the phase count \(base.phases.count))") {
+            $0.actors![0].visits.append(9) }
+        variant("D10a", "actors[0].index \(base.actors![0].index) -> 1 (repeats actors[1].index)") {
+            $0.actors![0].index = 1 }
+        variant("D10b", "actors[0].index \(base.actors![0].index) -> 3 (no actor has it; actor count \(base.actors!.count))") {
+            $0.actors![0].index = 3 }
+        // The degraded reply as PWRunnerService.pwRunnerReportData re-issues it.
+        func degrade(_ reply: inout PWRunnerRunResult) {
+            let diagnostic = "constructed reporting diagnostic"
+            reply.reporting_failure = PWRunnerReportingFailure(diagnostic: diagnostic, original_rc: reply.rc,
+                original_normalized_outcome: reply.normalized_outcome, original_error: reply.error, evidence_retained: true)
+            reply.producer = .current
+            reply.rc = 1
+            reply.normalized_outcome = NormalizedOutcome.runnerReportingFailed
+            reply.error = "runner host could not encode its result: \(diagnostic)"
+            for index in reply.steps.indices { reply.steps[index].comparison = nil }
+        }
+        variant("D12-0", "degraded as the host re-issues it: rc 1, runner_reporting_failed, error, reporting_failure{evidence_retained: true}; no defect (control for D12)") {
+            degrade(&$0) }
+        variant("D12a", "degraded as D12-0, then actors = []") { degrade(&$0); $0.actors = [] }
+        variant("D12b", "degraded as D12-0, then actors[0].index 0 -> 1") { degrade(&$0); $0.actors![0].index = 1 }
+        variant("D12c", "degraded as D12-0, then phases[0].actor_visit 1 -> 2") { degrade(&$0); $0.phases[0].actor_visit = 2 }
+    }
+
+    // D11: ordinary reply with a preparation_failure object and no other actor field.
+    let ordinary = try replyFixture()
+    emit("O0", base: "O0", change: "none (control): replyFixture(), the first ordinary shape document; execution_form \(ordinary.execution_form ?? "nil")", ordinary)
+    var d11 = ordinary
+    d11.preparation_failure = PWRunnerPreparationFailure(stage: "resolved_plan", code: "inconsistent_assignment",
+        actor_id: "A", binding_ref: 0, reason: "constructed assignment mismatch")
+    emit("O0-D11", base: "O0", change: "preparation_failure = {resolved_plan, inconsistent_assignment, actor_id A, binding_ref 0, reason} added", d11)
+
+    // D13 starting points: valid actor-form replies without preparation_failure.
+    // The null is applied to the decoded JSON on the Rust side.
+    emit("A0", base: "A0", change: "none (control): actorShapeDocuments()[0]; preparation_failure \(actorDocs[0].preparation_failure == nil ? "nil" : "present")", actorDocs[0])
+    if let first = baselineIndices.first, first > 0 {
+        let previous = actorDocs[first - 1]
+        emit("AR", base: "AR", change: "none (control): actorShapeDocuments()[\(first - 1)], the launch-refused reply the first baseline is derived from; preparation_failure \(previous.preparation_failure == nil ? "nil" : "present")", previous)
+    }
+
+    notes["producer_contract"] = actorDocs[0].producer.contract
+    let document: [String: Any] = ["notes": notes, "replies": manifest]
+    try JSONSerialization.data(withJSONObject: document, options: [.prettyPrinted, .sortedKeys])
+        .write(to: out.appendingPathComponent("swift.json"))
+    FileHandle.standardOutput.write(Data("r14 experiment: \(manifest.count) replies written to \(out.path)\n".utf8))
+}
