+def native_tool(label, args, *, timeout=90):
+    global sequence
+    sequence += 1
+    destination = out / f'{sequence:03d}-{label}'
+    native_command(destination, args, timeout=timeout)
+    return destination
+
+
+def verified_equipment(bundle, label):
+    # Real source/current seal, bytes and semantic readbacks remain independent
+    # of the public installer's inventory verifier. No service/worker launches.
+    native_tool(label + '-seal', ['/usr/bin/codesign', '--verify', '--deep', '--strict', bundle])
+    return session.equipment_inventory(bundle, out, f'{sequence:03d}-{label}', native_command)
+
+
+def reseal_fixture(bundle, label):
+    # Every caller owns a fresh never-launched copy. Ad-hoc signing preserves
+    # this suite's app+GUI equipment contract; no Developer ID is required.
+    equipment_path = bundle / 'Contents/Resources/worker-equipment.json'
+    original = json.loads(equipment_path.read_text())
+    equipment = json.loads(equipment_path.read_text())
+    for helper in ('pw-probe-runner', 'pw-probe-runner-unentitled', 'sb_api_validator'):
+        native_tool(label + '-sign-' + helper, ['/usr/bin/codesign', '--force', '--options', 'runtime',
+                    '-s', '-', bundle / 'Contents/MacOS' / helper])
+    for row in equipment['workers']:
+        binary = bundle / row['relative_path']
+        sequence_label = native_tool(label + '-verify-' + row['role'],
+            ['/usr/bin/codesign', '--verify', '--strict', binary]).name
+        signed = native_signature(binary, out / (sequence_label + '-signature'))
+        readback = native_tool(label + '-entitlements-' + row['role'],
+            ['/usr/bin/codesign', '-d', '--entitlements', '-', '--xml', binary])
+        raw = (readback / 'stdout').read_bytes()
+        observed = plistlib.loads(raw) if raw.strip() else {}
+        assert isinstance(observed, dict) and (row['role'] != 'unentitled' or not observed)
+        row.update(sha256=hashlib.sha256(binary.read_bytes()).hexdigest(), cdhash=signed['CDHash'],
+                   identifier=signed['Identifier'], team_id=None if signed['TeamIdentifier'] == 'not set' else signed['TeamIdentifier'],
+                   entitlements_xml=plistlib.dumps(observed).decode())
+    assert equipment['worker_identity'] == original['worker_identity']
+    assert equipment['unsigned_worker_sha256'] == original['unsigned_worker_sha256']
+    equipment_path.write_text(json.dumps(equipment, indent=2) + '\n')
+    native_tool(label + '-seal', ['/usr/bin/codesign', '--force', '--options', 'runtime', '-s', '-', bundle])
+    current = verified_equipment(bundle, label + '-current')
+    assert current == equipment
+    save(out / (label + '-inventory.json'), dict(source=original, current=current,
+         retained_build_identity=True, retained_common_presign_hash=True, service_executed=False, worker_launched=False))
+
+
