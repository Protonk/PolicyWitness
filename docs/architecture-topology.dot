digraph topology {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="Process topology", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_app {
        label="app top level"; style=dashed; color="#888888"; fontsize=10;
        controller;
        client;
        sbpl_check;
    }
    subgraph cluster_xpc {
        label="inside the XPC bundle"; style=dashed; color="#888888"; fontsize=10;
        host;
        worker;
        validator;
        issuer;
    }
    subgraph cluster_os {
        label="macOS"; style=dashed; color="#888888"; fontsize=10;
        launchd;
    }
    user [shape="plaintext", label="the caller\nuser", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="user: the caller | a shell or a harness; owns the request file and reads the envelope "];
    controller [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="policy-witness\ncontroller", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="controller: policy-witness | Rust; app top level; the caller; no; none; one run "];
    client [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-runner-client\nclient", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="client: pw-runner-client | Swift; app top level; the controller; no; none; one helper per request; effect-free reservation attempts and the single execution invocation share one absolute deadline "];
    host [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="PWRunner\nhost", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="host: PWRunner | Swift; inside the XPC bundle; launchd: XPC service lookup, or a Mach service for BYOXPC; no; none, by the invariance rule; actor-form token custody copies, compares and erases bytes without a sandbox call; one reservation and at most one specimen; unused reservation expiry or abandonment retires the host; terminal reply flush delay 50 milliseconds is best effort All authorized connections share one locked reservation slot. Only the connection holding its grant can consume it, before specimen decoding. Stale expiry or disconnect cannot retire an executing owner; client loss after submission never permits replay."];
    worker [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="pw-probe-runner\nworker", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="worker: pw-probe-runner | C; inside the XPC bundle; the host; applies its supplied policy once; an unapplied actor declares setup without application; sandbox_compile_string, params, sandbox_apply; sandbox_extension_consume and sandbox_extension_release; sandbox_extension_issue_file in an actor; one specimen in the single-worker form, or one actor of an actor-form specimen; one application (none for an unapplied actor) and all of its ordered visits; parked between visits; terminal publication exits without host permission "];
    exec_child [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="exec helper children\nexec_child", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="exec_child: exec helper children | caller-supplied; the caller's path; the worker; inherit the worker's sandbox; none of PolicyWitness's; the worker bounds collection and leader reap; ordinary completion and worker death can leave same-group descendants alive; escaped descendants are not contained "];
    validator [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sb_api_validator\nvalidator", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="validator: sb_api_validator | C; inside the XPC bundle; the host at each eligible phase arrival; no; sandbox_check; one phase collection "];
    sbpl_check [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sbpl-check\nsbpl_check", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="sbpl_check: sbpl-check | Rust; app top level; the controller, only for an admitted client terminal xpc_error; no; sandbox_compile_string and params; never applies; one compile per helper process; the controller invokes a helper for the held request and one for each selected actor policy, potentially before host admission "];
    launchd [shape="ellipse", style="dashed", color="#666666", label="launchd\nlaunchd", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="launchd: launchd | OS; system; no; none "];
    issuer [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-extension-issuer\nissuer", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="issuer: pw-extension-issuer | inside the XPC bundle; one declaration before worker creation; confirmed clean reap required for delivery; C; the host; outside the specimen policy; ordinary process authority; sandbox_extension_issue_file "];
    user -> controller [style="dashed", color="#2f5597", label="T1 argv in, envelope out", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T1: argv in; one JSON envelope on stdout |  "];
    controller -> client [style="bold", color="#222222", label="T2 spawn; stdin, stdout", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T2: spawn once; held request on stdin, read to EOF; versioned client capture on stdout |  "];
    client -> host [style="dashed", color="#2f5597", label="T3 NSXPC reservation and submission", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T3: effect-free NSXPC reservation, then one runReservedSpecimen call and its reply |  "];
    launchd -> host [style="bold", color="#666666", arrowhead="vee", label="T4 launch", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T4: start on XPC lookup, or as a Mach service (BYOXPC) |  "];
    host -> worker [style="bold", color="#222222", label="T5 posix_spawn; fds 0, 3, 4; optional 5", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T5: posix_spawn; fd 0 policy pipe, fd 3 shared region, fd 4 ready pipe; optional fd 5 transient token channel |  Policy delivery uses nonblocking writes under one absolute monotonic deadline (the worker_policy_transfer limit) beginning after spawn. Expiry closes input and enters cleanup before readiness or sentinel polling. The pipe carries no framing: the host writes the submission's byte count into the shared header before spawn, and the worker at EOF publishes the count it read and refuses a different length before compiling."];
    host -> validator [style="bold", color="#222222", label="T6 fresh collection per phase", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T6: fresh posix_spawn --batch <pid> per eligible phase; bundle-local default or explicit override; bounded NDJSON |  "];
    validator -> worker [style="dotted", color="#9a5b00", label="T7 sandbox_check(pid)", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T7: sandbox_check against the worker PID, with SANDBOX_CHECK_NO_REPORT |  "];
    worker -> host [style="dashed", color="#2f5597", label="T8 evidence and reciprocal release", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T8: shared-region worker arrivals, acknowledgements, completions and native observations; reciprocal host numbered releases hold requested actions |  "];
    worker -> exec_child [style="bold", color="#222222", label="T9 exec action after setup", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T9: posix_spawn inside an exec action after setup (after apply when supplied); stdout/stderr pipes into bounded slot buffers; excluded for authority-participating actors |  "];
    controller -> sbpl_check [style="bold", color="#222222", label="T12 spawn on xpc_error only", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T12: spawn only for an admitted client terminal xpc_error; held-request diagnostic plus independently associated actor-policy diagnostics; host request admission may not have occurred |  "];
    host -> issuer [style="bold", color="#222222", label="T13 spawn issuer; fd 3", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T13: fresh ordinary-authority issuer; fd 3 token mapping, stdio /dev/null, empty environment |  Declaration form only: issuer wait 5,000 milliseconds; cleanup may overrun. Missing capability refuses declaration-form extension specimens."];
    issuer -> host [style="dashed", color="#2f5597", label="T14 transient token and publication", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T14: native issuance publication and bounded transient token bytes; host owns cleanup and delivery eligibility |  Token storage 16,384 bytes; raw bytes never enter reply fields."];
    host -> worker [style="bold", color="#222222", label="T15 actor launch; fd 5 authority region", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T15: actor form: posix_spawn with an empty environment, stdin policy pipe, null stdout/stderr and CLOEXEC_DEFAULT; fd 5 the actor's own authority region; activation ordinal and shared lifetime cutoff in the evidence header |  One region per actor, mapped by the host before launch and by that actor before application; a validator or another actor never maps it. Setup allowance 10,000 milliseconds; lifetime cutoff 180,000 milliseconds."];
    worker -> host [style="dashed", color="#2f5597", label="T16 issue publication and transfer request", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T16: one-shot outbound publication per admitted issue and a distinct request/answer cell per transfer; the host owns published outbound bytes until copying or rejection and erasure |  Exchange allowance 5,000 milliseconds on each side; expiry is a transport status, never a native result. A later operation cannot reuse the expired operation's payload or answer cell. Host answer and completed source action are separate observations; a source timeout can still complete its phase."];
    host -> worker [style="dashed", color="#2f5597", label="T17 delivery and acknowledgement", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T17: delivery into the recipient's assigned inbound slot; the parked recipient validates framing and its preassigned source/action/delivery before acknowledging without consuming |  Recipient framing acknowledgement precedes host byte equality and usable/failed settlement, then the source answer. Consumption requires committed, accepted, usable settlement. Private custody erases at last declared transfer use, including failed delivery; shared teardown erasure requires a reaped or never-launched owner."];
}
