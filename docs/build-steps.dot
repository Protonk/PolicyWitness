digraph build_steps {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="One build in time", labelloc=t, pad=0.3, nodesep=0.2, ranksep=0.25];
    node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f2f2f2", color="#444444"];
    edge [fontname="Helvetica", fontsize=9, color="#444444"];
    make_build [label="make_build\\n[build] build, sign and embed evidence into …/PolicyWitness.app\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="make_build: reads IDENTITY and DIST_DIR from the make command line; writes nothing; runs build.sh with them", fillcolor="#fff4e0"];
    admission [label="admission\\n(before the first banner)\\n2 refusal(s)", URL="BUILD.md#build-steps", tooltip="admission: reads BUILD_XPC, PW_INSPECTION and the argument list; writes nothing"];
    check_limits [label="check_limits\\nChecking limits documentation\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="check_limits: reads docs/limits.json and the documents it renders; writes nothing"];
    check_contract [label="check_contract\\nChecking contract versions\\n2 refusal(s)", URL="BUILD.md#build-steps", tooltip="check_contract: reads docs/contract.json, docs/architecture.json and their generated copies; writes nothing"];
    check_build_doc [label="check_build_doc\\nChecking build documentation\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="check_build_doc: reads docs/build.json, build.sh, meson.build, the Makefile, the inventories, the baseline and the generated copies; writes nothing"];
    check_identity [label="check_identity\\nChecking host/worker identity\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="check_identity: reads the identity inputs and the three generated copies; writes nothing"];
    stamp [label="stamp\\nBuild stamp: … (…) …", URL="BUILD.md#build-steps", tooltip="stamp: reads git describe, rev-parse and rev-list, or PW_VERSION and PW_BUILD_NUMBER from the environment; writes the four stamp variables for Cargo and the plists"];
    minimum [label="minimum\\nSupported macOS (Info.plist LSMinimumSystemVersion): …\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="minimum: reads LSMinimumSystemVersion in Info.plist; writes MACOSX_DEPLOYMENT_TARGET for Cargo"];
    sdk [label="sdk\\nSelecting the macOS SDK (xcrun --sdk macosx)\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="sdk: reads the SDK path xcrun reports under DEVELOPER_DIR; writes SDKROOT for Cargo and Meson"];
    builddir [label="builddir\\nChecking the native build directory: …\\n2 refusal(s)", URL="BUILD.md#build-steps", tooltip="builddir: reads builddir/meson-info/meson-info.json when the directory is configured; writes nothing"];
    identity [label="identity\\nChecking the signing identity\\n3 refusal(s)", URL="BUILD.md#build-steps", tooltip="identity: reads IDENTITY and the keychain listing; the two knobs, for Meson's options and RUSTFLAGS; writes RUSTFLAGS, when inspection is on and it was unset or empty"];
    cargo [label="cargo\\nBuilding Rust controller + tools\\n5 refusal(s)", URL="BUILD.md#build-steps", tooltip="cargo: reads controller/ sources, the stamp variables, MACOSX_DEPLOYMENT_TARGET, SDKROOT and RUSTFLAGS; writes controller/target/release/, the pinned output directory"];
    toolchain [label="toolchain\\nChecking the native toolchain (meson, ninja … or newer)\\n2 refusal(s)", URL="BUILD.md#build-steps", tooltip="toolchain: reads meson and ninja on PATH and ninja's version; writes nothing"];
    configure [label="configure\\nConfiguring native build (meson configure, existing directory): …\\n22 refusal(s)", URL="BUILD.md#build-steps", tooltip="configure: reads whether builddir/build.ninja exists, meson.build, meson.options and the two knobs as Meson options; writes builddir/ configuration"];
    compile [label="compile\\nCompiling native executables\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="compile: reads the native sources through builddir/; writes builddir/ outputs and the Swift module cache under it"];
    native_check [label="native_check\\nChecking the configured native source lists and the identity closure against the tree\\n4 refusal(s)", URL="BUILD.md#build-steps", tooltip="native_check: reads Meson's introspection of builddir/, Ninja's dependency log, the identity inputs and the Meson outputs' load commands; writes nothing"];
    assemble [label="assemble\\nAssembling app bundle: …\\n2 refusal(s)", URL="BUILD.md#build-steps", tooltip="assemble: reads Info.plist, the three Rust outputs, runner/augments/, dist/README.md and dist/AGENTS.md; writes the two documents under DIST_DIR; removes the previous app, ZIP and guide; the stamped Info.plist, the three Rust executables and the augments under the new app"];
    embed_client [label="embed_client\\nEmbedding PW runner client\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="embed_client: reads builddir/pw-runner-client; writes Contents/MacOS/pw-runner-client and its dSYM in inspection builds", fillcolor="#e8f0fe"];
    embed_services [label="embed_services\\nEmbedding PWRunner XPC services\\n3 refusal(s)", URL="BUILD.md#build-steps", tooltip="embed_services: reads each service's Info.plist and builddir/ host, the worker and the validator; writes each service bundle: its stamped Info.plist, the host with its dSYM in inspection builds, the worker and the validator", fillcolor="#e8f0fe"];
    skip_xpc [label="skip_xpc\\nSkipping embedded XPC build (BUILD_XPC=0)", URL="BUILD.md#build-steps", tooltip="skip_xpc: reads nothing; writes nothing", style="rounded,dashed", fillcolor="white"];
    presign [label="presign\\nChecking host/worker identity again, before signing\\n2 refusal(s)", URL="BUILD.md#build-steps", tooltip="presign: reads the identity inputs and copies, and whether PolicyWitness.entitlements exists; writes nothing"];
    sign_tools [label="sign_tools\\nCodesigning embedded MacOS tools\\n3 refusal(s)", URL="BUILD.md#build-steps", tooltip="sign_tools: reads the copied top-level helpers; writes signatures on the top-level helpers"];
    sign_services [label="sign_services\\nCodesigning embedded XPC services\\n5 refusal(s)", URL="BUILD.md#build-steps", tooltip="sign_services: reads each service's Entitlements.plist and bundle; writes signatures on the nested helpers, then each service seal", fillcolor="#e8f0fe"];
    evidence [label="evidence\\nWriting evidence manifest (signed BOM)\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="evidence: reads the signed bytes, entitlements and exported symbols of the helpers, services and augments; writes Contents/Resources/Evidence/manifest.json and symbols.json"];
    seal [label="seal\\nCodesigning app bundle\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="seal: reads PolicyWitness.entitlements; writes the app seal over everything under Contents/"];
    verify [label="verify\\nVerifying signature + entitlements\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="verify: reads the sealed app; writes nothing"];
    signer [label="signer\\nChecking every executable's signer\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="signer: reads every regular file under the app's and each service's Contents/MacOS; writes nothing"];
    sign_observer [label="sign_observer\\nCodesigning observer tool (not embedded)\\n3 refusal(s)", URL="BUILD.md#build-steps", tooltip="sign_observer: reads controller/target/release/sandbox-log-observer; writes that executable's signature, in place"];
    guide [label="guide\\nStaging checked user guide\\n1 refusal(s)", URL="BUILD.md#build-steps", tooltip="guide: reads docs/PolicyWitness.md and its inputs; writes PolicyWitness.md under DIST_DIR"];
    zip [label="zip\\nCreating zip (for notarization): …", URL="BUILD.md#build-steps", tooltip="zip: reads the sealed app; writes PolicyWitness.zip under DIST_DIR"];
    make_build -> admission;
    admission -> check_limits;
    check_limits -> check_contract;
    check_contract -> check_build_doc;
    check_build_doc -> check_identity;
    check_identity -> stamp;
    stamp -> minimum;
    minimum -> sdk;
    sdk -> builddir;
    builddir -> identity;
    identity -> cargo;
    cargo -> toolchain;
    toolchain -> configure;
    configure -> compile;
    compile -> native_check;
    native_check -> assemble;
    assemble -> embed_client;
    embed_client -> embed_services;
    embed_services -> skip_xpc;
    skip_xpc -> presign;
    presign -> sign_tools;
    sign_tools -> sign_services;
    sign_services -> evidence;
    evidence -> seal;
    seal -> verify;
    verify -> signer;
    signer -> sign_observer;
    sign_observer -> guide;
    guide -> zip;
}
