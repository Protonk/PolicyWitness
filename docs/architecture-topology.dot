digraph topology {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="Process topology", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_app {
        label="app top level"; style=dashed; color="#888888"; fontsize=10;
        controller;
        client;
        observer;
        sbpl_check;
    }
    subgraph cluster_xpc {
        label="inside the XPC bundle"; style=dashed; color="#888888"; fontsize=10;
        host;
        worker;
        validator;
    }
    subgraph cluster_os {
        label="macOS"; style=dashed; color="#888888"; fontsize=10;
        launchd;
        log_show;
    }
    user [shape="plaintext", label="the caller\nuser", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="user: the caller | a shell or a harness; owns the request file and reads the envelope "];
    controller [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="policy-witness\ncontroller", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="controller: policy-witness | Rust; app top level; the caller; no; none; one run "];
    client [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-runner-client\nclient", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="client: pw-runner-client | Swift; app top level; the controller; no; none; one run "];
    host [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="PWRunner\nhost", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="host: PWRunner | Swift; inside the XPC bundle; launchd: XPC service lookup, or a Mach service for BYOXPC; no; none, by the invariance rule; one specimen; exits 50 milliseconds after replying All authorized connections share one terminal, locked request claim. Only its owner schedules host exit; connections racing retirement can still fail before refusal."];
    worker [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="pw-probe-runner\nworker", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="worker: pw-probe-runner | C; inside the XPC bundle; the host; yes; applies the specimen policy to itself; sandbox_compile_string, params, sandbox_apply; until the host requests exit; spins after done "];
    exec_child [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="exec helper children\nexec_child", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="exec_child: exec helper children | caller-supplied; the caller's path; the worker; inherit the worker's sandbox; none of PolicyWitness's; the worker's waits are bounded by the exec deadline and the attempt budget; a descendant that leaves the child's process group is not contained "];
    validator [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sb_api_validator\nvalidator", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="validator: sb_api_validator | C; inside the XPC bundle; the host, after applied; no; sandbox_check; one batch "];
    observer [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sandbox-log-observer\nobserver", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="observer: sandbox-log-observer | Rust; app top level; the controller, after execution completes, in its own process group; no; none; one scan "];
    log_show [shape="ellipse", style="dashed", color="#666666", label="log show\nlog_show", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="log_show: log show | OS; /usr/bin/log; the observer; no; none; one query "];
    sbpl_check [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sbpl-check\nsbpl_check", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="sbpl_check: sbpl-check | Rust; app top level; the controller, only for an admitted xpc_error reply; no; sandbox_compile_string and params; never applies; one compile "];
    launchd [shape="ellipse", style="dashed", color="#666666", label="launchd\nlaunchd", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="launchd: launchd | OS; system; no; none "];
    user -> controller [style="dashed", color="#2f5597", label="T1 argv in, envelope out", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T1: argv in; one JSON envelope on stdout |  "];
    controller -> client [style="bold", color="#222222", label="T2 spawn; stdin, stdout", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T2: spawn; held request on stdin, read to EOF; reply on stdout |  "];
    client -> host [style="dashed", color="#2f5597", label="T3 NSXPC runSpecimen", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T3: NSXPC runSpecimen(Data) and its reply |  "];
    launchd -> host [style="bold", color="#666666", arrowhead="vee", label="T4 launch", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T4: start on XPC lookup, or as a Mach service (BYOXPC) |  "];
    host -> worker [style="bold", color="#222222", label="T5 posix_spawn; fds 0, 3, 4", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T5: posix_spawn; fd 0 policy pipe, fd 3 shared region, fd 4 ready pipe |  Policy delivery uses nonblocking writes under one absolute monotonic deadline (the worker_policy_transfer limit) beginning after spawn. Expiry closes input and enters cleanup before readiness or sentinel polling."];
    host -> validator [style="bold", color="#222222", label="T6 posix_spawn --batch", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T6: posix_spawn --batch <pid>; NDJSON probes in, verdicts out |  "];
    validator -> worker [style="dotted", color="#9a5b00", label="T7 sandbox_check(pid)", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T7: sandbox_check against the worker PID, with SANDBOX_CHECK_NO_REPORT |  "];
    worker -> host [style="dashed", color="#2f5597", label="T8 shared-region evidence", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T8: evidence published in the shared region with release ordering; proceed waited for before attempts |  "];
    worker -> exec_child [style="bold", color="#222222", label="T9 posix_spawn after apply", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T9: posix_spawn after apply; stdout and stderr pipes into bounded slot buffers |  "];
    controller -> observer [style="bold", color="#222222", label="T10 spawn, own process group", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T10: spawn in its own process group after execution; budget on argv; JSON report on stdout |  "];
    observer -> log_show [style="bold", color="#222222", label="T11 log show", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T11: log show over the padded client span; text on stdout, bounded |  "];
    controller -> sbpl_check [style="bold", color="#222222", label="T12 spawn on xpc_error only", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T12: spawn only for an admitted xpc_error reply; held request in; helper envelope out |  "];
}
