+                        let status = if index == 1 { "ok" } else { "compile_error" };
+                        Ok(PolicyCheckCapture {
+                            status: status.into(),
+                            tool_exit_code: if index == 1 { 0 } else { 1 },
+                            output: JsonOutputCapture::unavailable(
+                                format!("helper {index}"),
+                                crate::utils::HELPER_CAPTURE_BYTES,
