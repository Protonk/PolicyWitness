+    // TEMPORARY EXPERIMENT (r14). Not a catalog case. Decodes the replies the
+    // Swift experiment encoded, records this reader's judgment on each, applies
+    // the changes the typed Swift record cannot hold to the decoded JSON, and
+    // writes every reply with its judgment for the Python reader.
+    #[test]
+    #[ignore = "r14 experiment; needs PW_R14_DIR with the Swift experiment's output"]
+    fn r14_preparation_failure_readers() {
+        let directory = std::path::PathBuf::from(std::env::var("PW_R14_DIR").unwrap());
+        let manifest: Value =
+            serde_json::from_slice(&std::fs::read(directory.join("swift.json")).unwrap()).unwrap();
+        fn judge(reply: &Value) -> Value {
+            match serde_json::from_value::<PWRunnerRunResult>(reply.clone()) {
+                Err(error) => json!({"typed_decode_error": error.to_string()}),
+                Ok(typed) => {
+                    let diagnostics = porcelain_admission::execution_diagnostics(Some(&typed));
+                    let version = match reply_version(&typed) {
+                        ReplyVersion::Supported => "supported".to_string(),
+                        ReplyVersion::Unsupported(v) => format!("unsupported: {v}"),
+                        ReplyVersion::Malformed(e) => format!("malformed: {e}"),
+                    };
+                    // The gate run_flow applies before the semantic reader, then the
+                    // envelope as the existing tests render it from a fixture reply.
+                    let gate = match admit_reply(&client_run(Some(reply)), Some(&typed)) {
+                        ReplyAdmission::Admitted => "admitted".to_string(),
+                        ReplyAdmission::Refused { outcome, error } => {
+                            format!("refused: {outcome}: {error}")
+                        }
+                        ReplyAdmission::DeliveryFailed(error) => {
+                            format!("delivery_failed: {error}")
+                        }
+                    };
+                    let (result, data, code) = execution_envelope(complete_execution(
+                        execution_data(Some(reply.clone())),
+                    ));
+                    let wire: Value = serde_json::from_str(
+                        &json_contract::render_envelope("run", result, &data).unwrap(),
+                    )
+                    .unwrap();
+                    let normalized = serde_json::to_value(&typed).unwrap();
+                    json!({
+                        "diagnostics": serde_json::to_value(&diagnostics).unwrap(),
+                        "admission_problem": porcelain_admission::admission_problem(&typed),
+                        "reply_version": version,
+                        "run_flow_admit_reply": gate,
+                        "envelope": {
+                            "exit_code": code,
+                            "result": wire["result"],
+                            "runner_result_is_null": wire["data"]["runner_result"].is_null(),
+                            "runner_result_equals_typed_reply": wire["data"]["runner_result"] == normalized,
+                            "runner_sandbox_diagnostics": wire["data"]["runner_sandbox_diagnostics"],
+                        },
+                        "typed_round_trip_equals_json": normalized == *reply,
+                    })
+                }
+            }
+        }
+        fn presence(reply: &Value, key: &str) -> &'static str {
+            match reply.get(key) {
+                None => "absent",
+                Some(Value::Null) => "null",
+                Some(_) => "present",
+            }
+        }
+        let mut rows = Vec::new();
+        for entry in manifest["replies"].as_array().unwrap() {
+            let id = entry["id"].as_str().unwrap();
+            let mut row = json!({"id": id, "base": entry["base"], "change": entry["change"],
+                "origin": "swift_bytes", "s": {"accepts": entry["s_accepts"], "diagnostic": entry["s_diagnostic"]}});
+            if entry["encoded"] != true {
+                row["porcelain"] = json!({"encode_error": entry["encode_error"]});
+                rows.push(row);
+                continue;
+            }
+            let raw = std::fs::read(directory.join(format!("{id}.pwp"))).unwrap();
+            let typed: PWRunnerRunResult = match crate::porcelain::decode(&raw) {
+                Ok(typed) => typed,
+                Err(error) => {
+                    row["porcelain"] = json!({"decode_error": format!("{error:?}")});
+                    rows.push(row);
+                    continue;
+                }
+            };
+            let reply = serde_json::to_value(&typed).unwrap();
+            row["json_presence"] = json!({
+                "extension_events": presence(&reply, "extension_events"),
+                "preparation_failure": presence(&reply, "preparation_failure"),
+                "reporting_failure": presence(&reply, "reporting_failure"),
+                "execution_form": reply.get("execution_form"),
+            });
+            row["r"] = judge(&reply);
+            row["reply"] = reply.clone();
+            rows.push(row);
+            // Changes made on the decoded JSON: S cannot be asked about these.
+            let mut variants: Vec<(String, String, Value)> = Vec::new();
+            if ["B1", "B2", "B3"].contains(&id) {
+                let mut null = reply.clone();
+                null["extension_events"] = Value::Null;
+                variants.push((
+                    format!("{id}-D5-jnull"),
+                    "decoded JSON of the baseline with extension_events set to JSON null".into(),
+                    null,
+                ));
+                let mut absent = reply.clone();
+                absent.as_object_mut().unwrap().remove("extension_events");
+                variants.push((
+                    format!("{id}-D5-jabsent"),
+                    "decoded JSON of the baseline with the extension_events key removed".into(),
+                    absent,
+                ));
+            }
+            if id == "A0" {
+                // The constructed steps carry no attempt path diagnostics; add the
+                // fixture account reply_fixtures gives a completed file step.
+                let mut pathed = reply.clone();
+                for step in pathed["steps"].as_array_mut().unwrap() {
+                    if step["attempt"]["requested_kind"] == "file" {
+                        let path = step["attempt"]["requested_path"].as_str().unwrap().to_string();
+                        step["attempt"]["path_diagnostics"] = attempt_paths(&path);
+                    }
+                }
+                let mut null = pathed.clone();
+                null["preparation_failure"] = Value::Null;
+                variants.push((
+                    "A0p".into(),
+                    "decoded JSON of A0 with reply_fixtures::attempt_paths(requested_path) added as attempt.path_diagnostics on each file step (control for A0p-D13)".into(),
+                    pathed,
+                ));
+                variants.push((
+                    "A0p-D13".into(),
+                    "A0p with \"preparation_failure\": null".into(),
+                    null,
+                ));
+            }
+            if ["A0", "AR", "B1-N1", "B1-N2", "B2-N1", "B2-N2", "B3-N1", "B3-N2"].contains(&id) {
+                let mut null = reply.clone();
+                null["preparation_failure"] = Value::Null;
+                variants.push((
+                    format!("{id}-D13"),
+                    format!(
+                        "decoded JSON of {id} (preparation_failure key {}) with \"preparation_failure\": null",
+                        presence(&reply, "preparation_failure")
+                    ),
+                    null,
+                ));
+            }
+            for (variant_id, change, changed) in variants {
+                rows.push(json!({"id": variant_id, "base": id, "change": change, "origin": "json_change",
+                    "s": Value::Null, "r": judge(&changed), "reply": changed}));
+            }
+        }
+        std::fs::write(
+            directory.join("rust.json"),
+            serde_json::to_vec_pretty(&json!({"notes": manifest["notes"], "replies": rows})).unwrap(),
+        )
+        .unwrap();
+    }
