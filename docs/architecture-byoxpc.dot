digraph byoxpc {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="The BYOXPC apparatus", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_installation {
        label="installation"; style=dashed; color="#888888"; fontsize=10;
        bundle_copy;
        entitlements_plist;
        install;
        signing;
        plist;
        registry;
        equipment_inventory;
    }
    subgraph cluster_launch {
        label="launch and connection"; style=dashed; color="#888888"; fontsize=10;
        launchd;
        host;
        client;
        caller_auth;
    }
    subgraph cluster_selection {
        label="selection and provenance"; style=dashed; color="#888888"; fontsize=10;
        selector;
        provenance;
    }
    subgraph cluster_reached {
        label="bundle-local native helpers"; style=dashed; color="#888888"; fontsize=10;
        worker;
        validator;
        unentitled;
    }
    subgraph cluster_maintenance {
        label="maintenance"; style=dashed; color="#888888"; fontsize=10;
        verify;
        validate;
        remove;
        reconcile;
    }
    user [shape="plaintext", label="the installer\nuser", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="user: the installer | a person or a harness; a bundle copy, an identity, an entitlements plist, a scope "];
    bundle_copy [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="copied XPC bundle\nbundle_copy", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="bundle_copy: copied XPC bundle | the installer; the host, selected worker, unentitled worker and validator, each with the build's signature until the installer re-signs them; CFBundleIdentifier is the service name "];
    entitlements_plist [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="the installer's entitlements plist\nentitlements_plist", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="entitlements_plist: the installer's entitlements plist | the installer; the host executable and the embedded worker, the process the policy is applied to "];
    install [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner install\ninstall", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="install: runner install | Verifies source seal and inventory before mutation; signs selected worker with supplied entitlements and unentitled worker/validator without them; refreshes inventory, seals service, registers launchd and retains readbacks "];
    signing [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="codesign of the bundle tree\nsigning", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="signing: codesign of the bundle tree | the embedded worker with the identity and the supplied entitlements, the validator and unentitled worker with the identity alone, then the enclosing bundle with the identity and the entitlements; the sealed bundle recursively (--deep --strict) before anything is recorded "];
    plist [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="LaunchAgent or LaunchDaemon plist\nplist", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="plist: LaunchAgent or LaunchDaemon plist | MachServices, RunAtLoad, ProgramArguments with --mach-service, EnvironmentVariables from --env, ThrottleInterval of 1 second; the user's LaunchAgents or /Library/LaunchDaemons "];
    registry [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="runner registry\nregistry", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="registry: runner registry | pending, installed, pending_cleanup; service name, scope, bundle path, and separate host/selected worker/unentitled worker/validator signature and entitlement read-backs, each entitlement set with its keys and the keys granted (value true); absent helper observations in older records remain unknown "];
    launchd [shape="ellipse", style="dashed", color="#666666", label="launchd\nlaunchd", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="launchd: launchd | the host on demand for its Mach service; one launch per ThrottleInterval, 1 second in the generated plist; launchd's own default applies without the key "];
    host [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="PWRunner as a Mach service\nhost", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="host: PWRunner as a Mach service | NSXPCListener(machServiceName:) from --mach-service; the installed identity and entitlements; relative to its own bundle All authorized connections share one locked reservation slot. Only the connection holding its grant can consume it, before specimen decoding. Stale expiry or disconnect cannot retire an executing owner; client loss after submission never permits replay."];
    client [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-runner-client --mach-service\nclient", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="client: pw-runner-client --mach-service | NSXPCConnection(machServiceName:), with the privileged option for system scope "];
    caller_auth [shape="octagon", style="dashed", color="#8e24aa", label="caller authorization\ncaller_auth", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="caller_auth: caller authorization | the caller's Team ID equals the host's; an optional identifier allowlist; PWRunnerRequireSignedCaller and PWRunnerAllowedIdentifiers in the host's Info.plist, inherited by a copy "];
    selector [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="request runner selector\nselector", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="selector: request runner selector | the runner by id or service, with mode and required_entitlements; every required key present with the value true in the worker's recorded read-back; the host's entitlements are recorded, not consulted; a record without a worker read-back is refused with a reinstall message when anything is required; before XPC delivery "];
    provenance [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="runner provenance and binary baselines\nprovenance", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="provenance: runner provenance and binary baselines | runner kind, service name, registry id and separate host/selected worker/unentitled worker/validator signature and entitlement read-backs; selected binary hashes observed before invocation; historical observations remain available for recovery "];
    worker [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="pw-probe-runner in the copy\nworker", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="worker: pw-probe-runner in the copy | the installed identity and the supplied entitlements, signed before the bundle seal; the installed plist's entitlements; a require-entitlement rule consults this process "];
    validator [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sb_api_validator in the copy\nvalidator", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="validator: sb_api_validator in the copy | the installed identity alone, no entitlements "];
    verify [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner verify\nverify", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="verify: runner verify | sends a fixed allow-all request through the client and waits 5,000 milliseconds by default; one reserved host and at most one execution; subsequent acquisition can wait through occupied hosts or the generated plist throttle, without sending a specimen before its own grant "];
    validate [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner validate\nvalidate", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="validate: runner validate | Verifies service and each current role, sealed equipment inventory and signature/entitlement readbacks; legacy issuer records remain inspectable for recovery; consults no launchctl "];
    remove [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner remove\nremove", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="remove: runner remove | moves ownership to pending_cleanup, boots the service out, removes the plist, retires the record after verified absence "];
    reconcile [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner reconcile\nreconcile", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="reconcile: runner reconcile | reports launchd services and plists that look owned, changing nothing "];
    unentitled [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-probe-runner-unentitled in the copy\nunentitled", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="unentitled: pw-probe-runner-unentitled in the copy | same compiled worker, installed identity, empty entitlement dictionary; actor equipment choice independent of sandbox mode; no inherited restriction is removed Injected signer and inventory publisher establish selected entitlement input, empty-input unentitled/validator signing, inventory publication before enclosing seal, and missing-role/publication failure refusal. They supply no native codesign acceptance evidence. Constructed signing observations exercise complete two-role binding, per-actor boolean requirements, explicit fixture provenance, live path mismatch, process association and ownership/deadline refusal. They do not establish native signature validity or effective authority."];
    equipment_inventory [shape="folder", style="filled", fillcolor="#fff6c2", color="#8a7400", label="sealed worker-equipment.json\nequipment_inventory", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="equipment_inventory: sealed worker-equipment.json | source seal verified before mutation; refreshed signed-role observations retain source build identity; host verifies own service seal and both roles; controller registry is not execution authority Constructed inventories exercise current protocol, exactly two distinct roles, fixed paths, bounded entitlement text and closed keys. Native seal and signed-byte equality require the separate verification controls. Never-launched signed copies exercise changed nested code and validly resealed stale or malformed equipment inventories. Installation must refuse without registration; these controls do not establish live actor identity or execution."];
    user -> bundle_copy [style="dotted", color="#444444", label="X1 copy", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X1: copies the shipped PWRunner.xpc |  "];
    user -> install [style="dashed", color="#2f5597", label="X2 argv", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X2: runner install with --bundle, --identity, --entitlements, --scope and optional --env |  "];
    entitlements_plist -> signing [style="solid", color="#8a7400", label="X3 entitlements", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X3: supplied entitlements |  "];
    install -> signing [style="bold", color="#222222", label="X4 codesign", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X4: sign_install_tree: codesign the worker with --entitlements, the validator and unentitled worker, refresh inventory, then seal the bundle; codesign --verify --deep --strict |  "];
    signing -> host [style="bold", color="#2e7d32", label="X5 signs the host", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X5: the host executable carries the identity and entitlements; read back by entitlements_from_codesign and codesign_metadata |  "];
    signing -> worker [style="bold", color="#2e7d32", label="X6 signs the worker", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X6: the worker carries the identity and the supplied entitlements; read back by read_back |  "];
    signing -> validator [style="bold", color="#2e7d32", label="X7 signs the validator", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X7: the validator carries the identity alone; read back by read_back |  "];
    install -> plist [style="bold", color="#2e7d32", label="X8 plist", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X8: build_launchd_plist and write_launchd_plist |  "];
    plist -> launchd [style="bold", color="#666666", arrowhead="vee", label="X9 bootstrap", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X9: launchctl bootstrap into the gui or system domain |  "];
    launchd -> host [style="bold", color="#666666", arrowhead="vee", label="X10 start on demand", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X10: start on demand for the Mach service; configured ThrottleInterval 1 second paces launches without guaranteeing request-delivery time |  "];
    install -> registry [style="bold", color="#2e7d32", label="X11 record", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X11: install_record: pending before the plist, installed after the bootstrap |  "];
    user -> selector [style="dashed", color="#2f5597", label="X12 runner field", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X12: the specimen's runner field: mode, id or service, required_entitlements |  "];
    selector -> registry [style="solid", color="#8a7400", label="X13 resolve", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X13: resolve by id or service; every required entitlement must be granted (value true) in the worker's recorded read-back |  "];
    registry -> provenance [style="solid", color="#8a7400", label="X14 provenance", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X14: runner_provenance_from_target copies kind, service, id and each binary's signature and entitlements |  "];
    bundle_copy -> provenance [style="solid", color="#8a7400", label="X15 hashes before invocation", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X15: Binaries::observe hashes the service, selected worker, unentitled worker and validator files before invocation |  "];
    client -> caller_auth [style="dashed", color="#2f5597", label="X16 connect", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X16: NSXPCConnection(machServiceName:), privileged for system scope |  "];
    caller_auth -> host [style="solid", color="#2f5597", label="X17 Team ID equal", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X17: shouldAcceptNewConnection: the caller's Team ID equals the host's, and the identifier allowlist if present |  "];
    host -> worker [style="bold", color="#222222", label="X18 spawn", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X18: posix_spawn of the copy's own worker |  "];
    host -> validator [style="bold", color="#222222", label="X19 spawn", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X19: eligible collection spawns the copy’s bundle-local validator by default; an explicit override takes precedence |  "];
    verify -> client [style="dashed", color="#2f5597", label="X20 allow-all request", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X20: a fixed allow-all request on the client's stdin |  "];
    validate -> registry [style="dashed", color="#8e24aa", label="X21 re-read", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X21: verifies the bundle recursively and each binary on its own, re-reads every signature and entitlement set, reports failures |  "];
    remove -> launchd [style="bold", color="#666666", arrowhead="vee", label="X22 bootout", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X22: bootout, then re-read for up to 1,000 milliseconds of teardown |  "];
    remove -> registry [style="bold", color="#2e7d32", label="X23 retire", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X23: pending_cleanup first; retired only after verified absence of service and plist |  "];
    reconcile -> launchd [style="dashed", color="#8e24aa", label="X24 inspect", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X24: inspect_service lists candidate services without changes |  "];
    reconcile -> plist [style="dashed", color="#8e24aa", label="X25 inspect", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X25: inspect_plist lists candidate plists without changes |  "];
    signing -> unentitled [style="bold", color="#2e7d32", label="X26 sign same compiled worker without supplied entitlements", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X26: sign same compiled worker without supplied entitlements |  Injected signer and inventory publisher establish selected entitlement input, empty-input unentitled/validator signing, inventory publication before enclosing seal, and missing-role/publication failure refusal. They supply no native codesign acceptance evidence."];
    host -> unentitled [style="bold", color="#222222", label="X27 spawn the exact actor equipment binding; never substitute roles", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X27: spawn the exact actor equipment binding; never substitute roles |  Constructed signing observations exercise complete two-role binding, per-actor boolean requirements, explicit fixture provenance, live path mismatch, process association and ownership/deadline refusal. They do not establish native signature validity or effective authority."];
    unentitled -> provenance [style="solid", color="#8a7400", label="X28 retain actual path, hash, signature and entitlements independently", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X28: retain actual path, hash, signature and entitlements independently |  Constructed BYOXPC dossier input compares copied binary paths and hashes against app manifest baselines. Signature and entitlement readbacks retain their own source; this test does not attest live process identity."];
    bundle_copy -> equipment_inventory [style="solid", color="#2f5597", label="X29 verify source seal and complete inventory before changing bytes", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X29: verify source seal and complete inventory before changing bytes |  Never-launched signed copies exercise changed nested code and validly resealed stale or malformed equipment inventories. Installation must refuse without registration; these controls do not establish live actor identity or execution."];
    signing -> equipment_inventory [style="bold", color="#2e7d32", label="X30 refresh signed observations after nested signing and before service seal", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X30: refresh signed observations after nested signing and before service seal |  Injected signer and inventory publisher establish selected entitlement input, empty-input unentitled/validator signing, inventory publication before enclosing seal, and missing-role/publication failure refusal. They supply no native codesign acceptance evidence. Never-launched signed copies exercise changed nested code and validly resealed stale or malformed equipment inventories. Installation must refuse without registration; these controls do not establish live actor identity or execution."];
    equipment_inventory -> host [style="solid", color="#2f5597", label="X31 bind both production roles to compiled source/ABI identity", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X31: bind both production roles to compiled source/ABI identity |  Constructed signing observations exercise complete two-role binding, per-actor boolean requirements, explicit fixture provenance, live path mismatch, process association and ownership/deadline refusal. They do not establish native signature validity or effective authority. Constructed inventories exercise current protocol, exactly two distinct roles, fixed paths, bounded entitlement text and closed keys. Native seal and signed-byte equality require the separate verification controls."];
}
