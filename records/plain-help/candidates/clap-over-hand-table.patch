+/// Refuses a declaration in which clap's own help is reachable: a help or
+/// version flag on any command, or the built-in help subcommand.
+fn guard_declarations() -> Result<(), String> {
+    fn walk(command: &clap::Command, problems: &mut Vec<String>) {
+        for argument in command.get_arguments() {
+            if argument.get_long() == Some("help") || argument.get_short() == Some('h') {
+                problems.push(format!("{} declares a help flag", command.get_name()));
+            }
+            if argument.get_long() == Some("version") || argument.get_short() == Some('V') {
+                problems.push(format!("{} declares a version flag", command.get_name()));
+            }
+        }
+        for sub in command.get_subcommands() {
+            walk(sub, problems);
+        }
+    }
+    let mut problems = Vec::new();
+    // Every declaration the controller parses with, each as it is parsed:
+    // a setting on the root does not reach a command parsed on its own.
+    let mut parsed = vec![crate::interface::commands::root(), crate::interface::run_args::declaration()];
+    parsed.extend(Command::ALL.iter().map(|command| command.declaration()));
+    for mut command in parsed {
+        command.build();
+        if !command.is_disable_help_subcommand_set() && command.has_subcommands() {
+            problems.push(format!("{} leaves clap's help subcommand enabled", command.get_name()));
+        }
+        walk(&command, &mut problems);
+    }
+    if problems.is_empty() {
+        Ok(())
+    } else {
+        Err(problems.join("; "))
+    }
+}
