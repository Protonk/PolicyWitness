def _assign_column_widths(columns: List[Dict[str, Any]], total_width: int) -> Optional[int]:
    sep_len = 3
    total_sep = sep_len * (len(columns) - 1)
    min_total = sum(col["min"] for col in columns) + total_sep
    if total_width < min_total:
        return None
    for col in columns:
        col["width"] = col["min"]
    extra = total_width - min_total
    while extra > 0:
        progressed = False
        for col in columns:
            if col.get("flex", 0) <= 0:
                continue
            if col["width"] >= col["max"]:
                continue
            col["width"] += 1
            extra -= 1
            progressed = True
            if extra == 0:
                break
        if not progressed:
            break
    return min_total


def _build_ledger_rows(summary: Dict[str, Any]) -> List[Dict[str, str]]:
    steps = summary.get("steps", []) or []
    evidence = summary.get("evidence", {}) or {}
    sandbox_logs = evidence.get("sandbox_logs", {}) or {}
    observed_deny = sandbox_logs.get("observed_deny")
    deny_marker_obj = evidence.get("deny_marker")
    deny_marker = None
    if isinstance(deny_marker_obj, dict) and "observed" in deny_marker_obj:
        deny_marker = deny_marker_obj.get("observed")
    uncertainty = summary.get("uncertainty", {}) or {}
    confidence = uncertainty.get("confidence")

    rows = []
    for step in steps:
        rows.append(
            {
                "step_id": _format_val(step.get("step_id")),
                "probe_id": _format_val(step.get("probe_id")),
                "ok": _format_tri(step.get("ok")),
                "normalized_outcome": _format_val(step.get("normalized_outcome")),
                "rc": _format_val(step.get("rc")),
                "errno": _format_val(step.get("errno")),
                "probe_exec_overlap": _format_tri(step.get("probe_exec_overlap")),
                "observed_deny": _format_tri(observed_deny),
                "confidence": _format_val(confidence),
                "sandbox_check_outcome": _format_val(step.get("sandbox_check_outcome")),
                "deny_marker_observed": "-" if not isinstance(deny_marker_obj, dict) else _format_tri(deny_marker),
            }
        )
    return rows


def _resolve_embedded_xpc_bundle_info(app_root: Path, *, service_dir: str, variant: str) -> Optional[Dict[str, str]]:
    if variant == "injectable":
        bundle_name = f"{service_dir}__injectable.xpc"
    else:
        bundle_name = f"{service_dir}.xpc"
    plist_path = app_root / "Contents/XPCServices" / bundle_name / "Contents/Info.plist"
    if not plist_path.exists():
        return None
    try:
        with plist_path.open("rb") as fh:
            data = plistlib.load(fh)
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    bundle_id = data.get("CFBundleIdentifier")
    exe = data.get("CFBundleExecutable")
    if not isinstance(bundle_id, str) or not isinstance(exe, str):
        return None
    return {"bundle_id": bundle_id, "executable": exe, "info_plist": str(plist_path)}


def _run_pw_runner_client(
    app_root: Path,
    *,
    service_bundle_id: str,
    request_path: Path,
    out_dir: Path,
    timeout_s: int,
) -> Dict[str, Any]:
    tool = app_root / "Contents/MacOS/pw-runner-client"
    if not tool.exists():
        _die(f"missing pw-runner-client at {tool}")

    out_dir.mkdir(parents=True, exist_ok=True)
    cmd = [str(tool), "run", "--timeout-ms", str(max(1, timeout_s * 1000)), service_bundle_id, str(request_path)]
    _write_text(out_dir / "cmd.txt", _format_cmd(cmd) + "\n")

    start_ms = _now_unix_ms()
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout_s)
    end_ms = _now_unix_ms()

    _write_text(out_dir / "outputs.stdout.json", proc.stdout)
    _write_text(out_dir / "outputs.stderr.txt", proc.stderr)
    _write_text(out_dir / "outputs.exit_code.txt", str(proc.returncode) + "\n")

    parsed = None
    parse_error = None
    try:
        parsed = json.loads(proc.stdout) if proc.stdout.strip() else None
    except Exception as exc:
        parse_error = str(exc)

    _write_json(
        out_dir / "run.json",
        {
            "schema_version": 1,
            "driver": "pw-runner-client",
            "started_at_unix_ms": start_ms,
            "ended_at_unix_ms": end_ms,
            "argv": cmd,
            "exit_code": proc.returncode,
            "parse_error": parse_error,
            "parsed": parsed,
        },
    )
    return {
        "exit_code": proc.returncode,
        "started_at_unix_ms": start_ms,
        "ended_at_unix_ms": end_ms,
        "parse_error": parse_error,
        "parsed": parsed,
    }


def _capture_sandbox_logs_last(
    app_root: Path,
    *,
    pid: int,
    process_name: str,
    out_dir: Path,
    last: str,
) -> Dict[str, Any]:
    tool = app_root / "Contents/MacOS/sandbox-log-observer"
    if not tool.exists():
        return {"capture_status": "requested_unavailable", "error": f"missing {tool}"}

    out_dir.mkdir(parents=True, exist_ok=True)
    cmd = [
        str(tool),
        "--pid",
        str(pid),
        "--process-name",
        process_name,
        "--last",
        last,
        "--format",
        "json",
    ]
    _write_text(out_dir / "cmd.txt", _format_cmd(cmd) + "\n")

    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    _write_text(out_dir / "outputs.stdout.json", proc.stdout)
    _write_text(out_dir / "outputs.stderr.txt", proc.stderr)
    _write_text(out_dir / "outputs.exit_code.txt", str(proc.returncode) + "\n")

    parsed = None
    parse_error = None
    try:
        parsed = json.loads(proc.stdout) if proc.stdout.strip() else None
    except Exception as exc:
        parse_error = str(exc)
    if not isinstance(parsed, dict):
        return {"capture_status": "requested_unavailable", "error": parse_error or "stdout not json"}
    parsed["capture_status"] = "captured" if proc.returncode == 0 else "requested_unavailable"
    parsed["capture_parse_error"] = parse_error
    return parsed


def _instrument_sbpl_message_marker(sbpl: str, message: str) -> str:
    """
    Best-effort transformation: add `(with message "...")` to each `(deny ...)` form.

    This intentionally does not try to be a general SBPL rewriter; it is a narrow
    lab helper and will refuse to transform if it cannot safely identify `deny`
    forms without getting confused by quoted strings.
    """
    text = sbpl
    spans: List[Tuple[int, int]] = []
    in_string = False
    escape = False
    depth = 0

    def is_sym_char(ch: str) -> bool:
        return ch.isalnum() or ch in ("-", "_", ".")

    i = 0
    while i < len(text):
        ch = text[i]
        if in_string:
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            i += 1
            continue

        if ch == '"':
            in_string = True
            i += 1
            continue
        if ch == "(":
            depth += 1
            # Look for `(deny` token.
            j = i + 1
            while j < len(text) and text[j].isspace():
                j += 1
            k = j
            while k < len(text) and is_sym_char(text[k]):
                k += 1
            if text[j:k] == "deny":
                # Find the matching closing paren for this form.
                form_depth = 1
                m = k
                local_in_string = False
                local_escape = False
                while m < len(text):
                    c2 = text[m]
                    if local_in_string:
                        if local_escape:
                            local_escape = False
                        elif c2 == "\\":
                            local_escape = True
                        elif c2 == '"':
                            local_in_string = False
                        m += 1
                        continue
                    if c2 == '"':
                        local_in_string = True
                        m += 1
                        continue
                    if c2 == "(":
                        form_depth += 1
                    elif c2 == ")":
                        form_depth -= 1
                        if form_depth == 0:
                            spans.append((i, m))
                            break
                    m += 1
            i += 1
            continue
        if ch == ")":
            depth = max(0, depth - 1)
            i += 1
            continue
        i += 1

    # Apply insertions from right-to-left so offsets remain valid.
    out = text
    escaped = message.replace("\\", "\\\\").replace('"', '\\"')
    suffix = f' (with message "{escaped}")'
    for start, end in reversed(spans):
        segment = out[start : end + 1]
        if "with message" in segment:
            continue
        out = out[:end] + suffix + out[end:]
    return out


def cmd_specimen(args: argparse.Namespace) -> int:
    pw_path = Path(args.pw)
    if not pw_path.exists():
        _die(f"PolicyWitness binary not found: {pw_path}")

    app_root = _app_root_from_pw(pw_path)
    if not app_root:
        _die("failed to resolve app root from --pw (expected PolicyWitness.app/Contents/MacOS/policy-witness)")

    runner_info = _resolve_embedded_xpc_bundle_info(app_root, service_dir="PWRunner", variant="base")
    if not runner_info:
        _die("failed to resolve embedded PWRunner bundle info")

    service_bundle_id = runner_info["bundle_id"]
    process_name = runner_info["executable"]

    inside = _inside_probe(service_names=[service_bundle_id])
    allow_inside = os.environ.get("PW_LAB_ALLOW_INSIDE") == "1"
    if inside.get("inside") and not allow_inside:
        out_dir = Path(args.outdir) if args.outdir else Path(args.out_root) / f"{time.strftime('%Y%m%d-%H%M%S')}_specimen_blocked"
        _ensure_clean_dir(out_dir, force=args.force)
        _write_json(out_dir / "inside.json", inside)
        _write_json(
            out_dir / "lab_summary.json",
            {
                "labbook_version": LABBOOK_VERSION,
                "scenario_id": "specimen",
                "driver": "pw_runner",
                "profile": "PWRunner",
                "variant": "default",
                "status": "blocked",
                "exit_code": 3,
                "inside": inside,
                "uncertainty": {"confidence": "unknown", "reasons": ["inside"], "collector_health": {}},
                "steps": [],
                "evidence": {},
            },
        )
        return 3

    spec_path = Path(args.specimen)
    spec_obj = _load_yaml_or_json(spec_path)
    if not isinstance(spec_obj, dict):
        _die("specimen file must be an object")

    specimen_id = str(spec_obj.get("specimen_id") or "specimen")
    deny_marker = f"PW_LAB_DENY_MARKER:{specimen_id}"
    canonical_policy = spec_obj.get("policy")
    probe_plan = spec_obj.get("probe_plan")
    if not isinstance(canonical_policy, dict) or not isinstance(probe_plan, list):
        _die("specimen file must include {policy: {...}, probe_plan: [...]}")

    instrumented_policy = spec_obj.get("instrumented_policy")
    if instrumented_policy is None:
        fmt = canonical_policy.get("format")
        if fmt == "sbpl" and isinstance(canonical_policy.get("sbpl_source"), str):
            instrumented_policy = dict(canonical_policy)
            instrumented_policy["sbpl_source"] = _instrument_sbpl_message_marker(
                canonical_policy["sbpl_source"], deny_marker
            )
        else:
            _die("missing instrumented_policy (and canonical policy cannot be auto-instrumented)")

    if args.outdir:
        out_dir = Path(args.outdir)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        out_dir = Path(args.out_root) / f"{stamp}_specimen_{specimen_id}"
    _ensure_clean_dir(out_dir, force=args.force)

    _write_json(out_dir / "inside.json", inside)
    _write_json(out_dir / "specimen.json", spec_obj if isinstance(spec_obj, dict) else {"raw": spec_obj})

    # Canonical run
    canonical_req = {
        "schema_version": 1,
        "specimen_id": specimen_id,
        "run_kind": "canonical",
        "policy": canonical_policy,
        "probe_plan": probe_plan,
    }
    canonical_req_path = out_dir / "canonical.request.json"
    _write_json(canonical_req_path, canonical_req)
    canonical_run = _run_pw_runner_client(
        app_root,
        service_bundle_id=service_bundle_id,
        request_path=canonical_req_path,
        out_dir=out_dir / "canonical",
        timeout_s=args.timeout_s,
    )

    # Instrumented run (for deterministic deny markers via SBPL `message`).
    instr_req = {
        "schema_version": 1,
        "specimen_id": specimen_id,
        "run_kind": "instrumented",
        "policy": instrumented_policy,
        "probe_plan": probe_plan,
    }
    instr_req_path = out_dir / "instrumented.request.json"
    _write_json(instr_req_path, instr_req)
    instrumented_run = _run_pw_runner_client(
        app_root,
        service_bundle_id=service_bundle_id,
        request_path=instr_req_path,
        out_dir=out_dir / "instrumented",
        timeout_s=args.timeout_s,
    )

    # Channel C: unified-log deny capture (best-effort, but required for high confidence).
    canonical_pid = (canonical_run.get("parsed") or {}).get("pid") if isinstance(canonical_run.get("parsed"), dict) else None
    instrumented_pid = (instrumented_run.get("parsed") or {}).get("pid") if isinstance(instrumented_run.get("parsed"), dict) else None

    canonical_logs = None
    if isinstance(canonical_pid, int):
        canonical_logs = _capture_sandbox_logs_last(
            app_root, pid=canonical_pid, process_name=process_name, out_dir=out_dir / "canonical_sandbox_logs", last=args.log_last
        )
        _write_json(out_dir / "canonical_sandbox_logs.json", canonical_logs)

    instrumented_logs = None
    if isinstance(instrumented_pid, int):
        instrumented_logs = _capture_sandbox_logs_last(
            app_root,
            pid=instrumented_pid,
            process_name=process_name,
            out_dir=out_dir / "instrumented_sandbox_logs",
            last=args.log_last,
        )
        _write_json(out_dir / "instrumented_sandbox_logs.json", instrumented_logs)

    summary = _summarize_specimen_eval(
        specimen_id=specimen_id,
        variant="default",
        probe_plan=probe_plan,
        canonical=canonical_run.get("parsed"),
        instrumented=instrumented_run.get("parsed"),
        canonical_logs=canonical_logs,
        instrumented_logs=instrumented_logs,
        deny_marker=deny_marker,
        inside=inside,
    )
    _write_json(out_dir / "lab_summary.json", summary)
    return 0 if summary.get("status") == "pass" else 1


def _summarize_specimen_eval(
    *,
    specimen_id: str,
    variant: str,
    probe_plan: List[Any],
    canonical: Any,
    instrumented: Any,
    canonical_logs: Optional[Dict[str, Any]],
    instrumented_logs: Optional[Dict[str, Any]],
    deny_marker: str,
    inside: Dict[str, Any],
) -> Dict[str, Any]:
    steps: List[Dict[str, Any]] = []
    plan_by_step: Dict[str, Dict[str, Any]] = {}
    for entry in probe_plan:
        if not isinstance(entry, dict):
            continue
        sid = entry.get("step_id")
        if isinstance(sid, str):
            plan_by_step[sid] = entry

    canon_steps = (canonical or {}).get("steps") if isinstance(canonical, dict) else None
    instr_steps = (instrumented or {}).get("steps") if isinstance(instrumented, dict) else None

    # Channel B: deterministic marker emitted by SBPL `message` on deny.
    marker_observed = None
    if deny_marker:
        logs_obj = instrumented_logs if isinstance(instrumented_logs, dict) else canonical_logs
        if isinstance(logs_obj, dict):
            data = logs_obj.get("data") if isinstance(logs_obj.get("data"), dict) else {}
            log_stdout = data.get("log_stdout")
            if isinstance(log_stdout, str):
                marker_observed = deny_marker in log_stdout

    if isinstance(canon_steps, list):
        for s in canon_steps:
            if not isinstance(s, dict):
                continue
            sid = s.get("step_id")
            plan = plan_by_step.get(sid) if isinstance(sid, str) else None
            plan_attempt = (plan or {}).get("attempt") if isinstance(plan, dict) else None
            probe_id = "-"
            if isinstance(plan_attempt, dict):
                kind = plan_attempt.get("kind")
                action = plan_attempt.get("action")
                if isinstance(kind, str) and isinstance(action, str):
                    probe_id = f"{kind}:{action}"

            attempt = s.get("attempt") or {}
            sb = s.get("sandbox_check") or {}
            rc = attempt.get("rc")
            err = attempt.get("errno")
            sb_outcome = sb.get("outcome")

            # Classification: avoid concluding "sandbox denied" without multi-channel support.
            outcome = "ok"
            ok = rc == 0
            if rc != 0 and sb_outcome == "deny":
                outcome = "failed_predicted_deny"
                ok = False
            if rc != 0 and sb_outcome == "allow":
                outcome = "failed_predicted_allow"
                ok = False
            if rc == 0 and sb_outcome == "deny":
                outcome = "mismatch_allow_but_predicted_deny"
                ok = False

            steps.append(
                {
                    "step_id": sid,
                    "probe_id": probe_id,
                    "ok": ok,
                    "normalized_outcome": outcome,
                    "rc": rc,
                    "errno": err,
                    "probe_exec_overlap": None,
                    "sandbox_check_outcome": sb_outcome,
                    "deny_marker_observed": marker_observed,
                }
            )

    def _observed_deny_from_capture(obj: Any) -> Any:
        if not isinstance(obj, dict):
            return None
        if "observed_deny" in obj:
            return obj.get("observed_deny")
        data = obj.get("data")
        if isinstance(data, dict) and "observed_deny" in data:
            return data.get("observed_deny")
        return None

    observed_deny = _observed_deny_from_capture(canonical_logs)
    if observed_deny is not True:
        observed_deny = _observed_deny_from_capture(instrumented_logs)

    confidence = "unknown"
    reasons: List[str] = []
    if observed_deny is not True:
        reasons.append("sandbox_deny_not_observed")
    if marker_observed is not True:
        reasons.append("deny_marker_not_observed")
    if observed_deny is True and marker_observed is True and steps:
        confidence = "high"

    status = "pass" if (isinstance(canonical, dict) and canonical.get("normalized_outcome") == "ok") else "fail"
    return {
        "labbook_version": LABBOOK_VERSION,
        "scenario_id": f"specimen:{specimen_id}",
        "driver": "pw_runner",
        "profile": "PWRunner",
        "variant": variant,
        "status": status,
        "exit_code": 0 if status == "pass" else 1,
        "inside": inside,
        "uncertainty": {"confidence": confidence, "reasons": reasons, "collector_health": {}},
        "steps": steps,
        "evidence": {
            "sandbox_logs": {"observed_deny": observed_deny},
            "deny_marker": {"value": deny_marker, "observed": marker_observed},
        },
    }


def cmd_tui(args: argparse.Namespace) -> int:
    try:
        import curses
    except Exception as exc:  # pragma: no cover - import failure is platform-specific
        _die(f"curses is unavailable: {exc}")

    run_dir = Path(args.run_dir)
    summary = _load_summary(run_dir)
    log_path = _tui_log_path()
    test_out = os.environ.get("PW_LAB_TUI_TEST_OUT")
    script_spec = os.environ.get("PW_LAB_TUI_SCRIPT", "")

    def _load_optional_json(path: Path) -> Optional[Any]:
        if not path.exists():
            return None
        try:
            return _load_json(path)
        except Exception as exc:
            return {"_error": f"failed to parse {path.name}: {exc}"}

    specimen = _load_optional_json(run_dir / "specimen.json")
    canonical_run = _load_optional_json(run_dir / "canonical" / "run.json")
    instrumented_run = _load_optional_json(run_dir / "instrumented" / "run.json")
    canonical_logs = _load_optional_json(run_dir / "canonical_sandbox_logs.json")
    instrumented_logs = _load_optional_json(run_dir / "instrumented_sandbox_logs.json")

    def _json_pretty(value: Any) -> str:
        if value is None:
            return "-"
        if isinstance(value, (dict, list)):
            try:
                return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False)
            except Exception:
                return str(value)
        return str(value)

    def _preview_text(value: Any, *, max_len: int = 120) -> str:
        text = _json_pretty(value)
        text = text.replace("\r\n", "\n").replace("\r", "\n")
        text = " ".join(text.splitlines())
        if len(text) <= max_len:
            return text
        return text[: max(0, max_len - 3)] + "..."

    def _row(key: str, label: str, value: Any, *, preview: Optional[str] = None) -> Dict[str, str]:
        full = _json_pretty(value)
        if preview is None:
            preview = _preview_text(value)
        return {"key": key, "label": label, "value": full, "preview": preview}

    def _extract_pid(client_run: Any) -> Any:
        if not isinstance(client_run, dict):
            return None
        parsed = client_run.get("parsed")
        if isinstance(parsed, dict) and "pid" in parsed:
            return parsed.get("pid")
        return None

    def _extract_parse_error(client_run: Any) -> Any:
        if not isinstance(client_run, dict):
            return None
        if client_run.get("parse_error"):
            return client_run.get("parse_error")
        parsed = client_run.get("parsed")
        if isinstance(parsed, dict) and parsed.get("error"):
            return parsed.get("error")
        return None

    def _build_pages() -> List[Dict[str, Any]]:
        pages: List[Dict[str, Any]] = []

        profile_rows: List[Dict[str, str]] = []
        profile_rows.append(_row("specimen.path", "specimen", str(run_dir / "specimen.json")))
        if isinstance(specimen, dict):
            profile_rows.append(_row("specimen.specimen_id", "specimen_id", specimen.get("specimen_id") or "-"))
            policy = specimen.get("policy") or {}
            profile_rows.append(
                _row("policy.format", "policy.format", (policy.get("format") if isinstance(policy, dict) else None))
            )
            if isinstance(policy, dict) and policy.get("params") is not None:
                profile_rows.append(_row("policy.params", "policy.params", policy.get("params")))
            if isinstance(policy, dict) and policy.get("sbpl_source") is not None:
                src = policy.get("sbpl_source") or ""
                if isinstance(src, str):
                    profile_rows.append(
                        _row(
                            "policy.sbpl_source",
                            "policy.sbpl_source",
                            src,
                            preview=f"SBPL source ({len(src)} chars)",
                        )
                    )
            if isinstance(policy, dict) and policy.get("compiled_profile_b64") is not None:
                b64 = policy.get("compiled_profile_b64") or ""
                if isinstance(b64, str):
                    profile_rows.append(
                        _row(
                            "policy.compiled_profile_b64",
                            "policy.compiled_profile_b64",
                            b64,
                            preview=f"compiled b64 ({len(b64)} chars)",
                        )
                    )

            plan = specimen.get("probe_plan") or []
            if isinstance(plan, list):
                profile_rows.append(_row("probe_plan.count", "probe_plan.count", len(plan)))
                for entry in plan:
                    if not isinstance(entry, dict):
                        continue
                    step_id = str(entry.get("step_id") or "-")
                    attempt = entry.get("attempt") or {}
                    sb = entry.get("sandbox_check") or {}
                    label = f"step {step_id}"
                    preview = _preview_text({"attempt": attempt, "sandbox_check": sb}, max_len=140)
                    profile_rows.append(_row(f"probe_plan.{step_id}", label, entry, preview=preview))
        else:
            profile_rows.append(_row("specimen.missing", "note", "specimen.json missing (older run format?)"))
        pages.append({"id": "profile", "title": "Profile", "rows": profile_rows})

        program_rows: List[Dict[str, str]] = []
        program_rows.append(_row("run_dir", "run_dir", str(run_dir)))
        program_rows.append(_row("labbook_version", "labbook_version", summary.get("labbook_version")))
        program_rows.append(_row("scenario_id", "scenario_id", summary.get("scenario_id")))
        program_rows.append(_row("driver", "driver", summary.get("driver")))
        program_rows.append(_row("status", "status", summary.get("status")))
        program_rows.append(_row("exit_code", "exit_code", summary.get("exit_code")))

        inside = summary.get("inside")
        if inside is not None:
            program_rows.append(_row("inside", "inside", inside))
            if isinstance(inside, dict):
                program_rows.append(_row("inside.inside", "inside.inside", inside.get("inside")))
                program_rows.append(_row("inside.trigger", "inside.trigger", inside.get("trigger")))

        if canonical_run is not None:
            program_rows.append(
                _row(
                    "canonical.exit_code",
                    "canonical.exit_code",
                    (canonical_run.get("exit_code") if isinstance(canonical_run, dict) else None),
                )
            )
            program_rows.append(_row("canonical.pid", "canonical.pid", _extract_pid(canonical_run)))
            pe = _extract_parse_error(canonical_run)
            if pe:
                program_rows.append(_row("canonical.parse_error", "canonical.parse_error", pe))
        if instrumented_run is not None:
            program_rows.append(
                _row(
                    "instrumented.exit_code",
                    "instrumented.exit_code",
                    (instrumented_run.get("exit_code") if isinstance(instrumented_run, dict) else None),
                )
            )
            program_rows.append(_row("instrumented.pid", "instrumented.pid", _extract_pid(instrumented_run)))
            pe = _extract_parse_error(instrumented_run)
            if pe:
                program_rows.append(_row("instrumented.parse_error", "instrumented.parse_error", pe))

        if canonical_logs is not None:
            program_rows.append(_row("canonical_sandbox_logs", "canonical_sandbox_logs", canonical_logs))
        if instrumented_logs is not None:
            program_rows.append(_row("instrumented_sandbox_logs", "instrumented_sandbox_logs", instrumented_logs))

        evidence = summary.get("evidence") or {}
        if evidence:
            program_rows.append(_row("evidence", "evidence", evidence))
        pages.append({"id": "program", "title": "Program", "rows": program_rows})

        result_rows: List[Dict[str, str]] = []
        result_rows.append(_row("status", "status", summary.get("status")))
        result_rows.append(_row("uncertainty", "uncertainty", summary.get("uncertainty")))
        steps = summary.get("steps") or []
        if isinstance(steps, list):
            result_rows.append(_row("steps.count", "steps.count", len(steps)))
            for step in steps:
                if not isinstance(step, dict):
                    continue
                sid = str(step.get("step_id") or "-")
                probe = str(step.get("probe_id") or "-")
                ok = _format_tri(step.get("ok"))
                outcome = str(step.get("normalized_outcome") or "-")
                rc = step.get("rc")
                err = step.get("errno")
                sb = str(step.get("sandbox_check_outcome") or "-")
                marker = _format_tri(step.get("deny_marker_observed"))
                preview = f"{probe} ok={ok} outcome={outcome} rc={rc} errno={err} sb={sb} marker={marker}"
                result_rows.append(_row(f"step.{sid}", sid, step, preview=preview))
        pages.append({"id": "results", "title": "Results", "rows": result_rows})

        return pages

    pages = _build_pages()

    def _rows_for_page(page_idx: int) -> List[Dict[str, str]]:
        if not pages:
            return []
        return pages[page_idx].get("rows") or []

    selection_state: Dict[str, Any] = {
        "page": pages[0]["id"] if pages else None,
        "mode": "list",
        "selected_row": 0,
        "selected_col": 0,
        "total_rows": len(_rows_for_page(0)),
        "total_cols": 1,
        "field_key": None,
        "field_label": None,
        "field_value": None,
    }

    def _parse_script(spec: str) -> List[int]:
        tokens = [t for t in re.split(r"[,\s]+", spec.strip()) if t]
        keymap = {
            "UP": curses.KEY_UP,
            "DOWN": curses.KEY_DOWN,
            "TAB": 9,
            "BTAB": curses.KEY_BTAB,
            "SHIFT+TAB": curses.KEY_BTAB,
            "PGUP": curses.KEY_PPAGE,
            "PGDN": curses.KEY_NPAGE,
            "HOME": curses.KEY_HOME,
            "END": curses.KEY_END,
            "ENTER": 10,
            "ESC": 27,
        }
        keys = []
        for token in tokens:
            upper = token.upper()
            if upper in keymap:
                keys.append(keymap[upper])
                continue
            if len(token) == 1:
                keys.append(ord(token))
                continue
            _tui_log(log_path, f"unknown script token: {token}")
        return keys

    def _update_selection_state(page_idx: int, mode: str, row_idx: int) -> None:
        page = pages[page_idx] if pages else {"id": None, "title": None}
        rows = _rows_for_page(page_idx)
        selection_state["page"] = page.get("id")
        selection_state["mode"] = mode
        selection_state["selected_row"] = row_idx
        selection_state["selected_col"] = 0
        selection_state["total_rows"] = len(rows)
        selection_state["total_cols"] = 1
        if not rows:
            selection_state["field_key"] = None
            selection_state["field_label"] = None
            selection_state["field_value"] = None
            return
        row = rows[row_idx]
        selection_state["field_key"] = row.get("key")
        selection_state["field_label"] = row.get("label")
        selection_state["field_value"] = row.get("value")

    def _run(stdscr: Any) -> int:
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        stdscr.nodelay(False)
        stdscr.keypad(True)

        page_idx = 0
        selected_row = 0
        row_offset = 0
        mode = "list"  # list | detail
        detail_scroll = 0
        status_message = ""
        render_errors = 0
        last_error = ""
        script_keys = _parse_script(script_spec) if script_spec else []
        if script_keys:
            for key in reversed(script_keys):
                try:
                    curses.ungetch(key)
                except curses.error as exc:
                    render_errors += 1
                    last_error = str(exc) or "curses.error"
                    _tui_log(log_path, f"ungetch error: {last_error}")

        while True:
            try:
                stdscr.erase()
                height, width = stdscr.getmaxyx()
                view_height = height - 2  # header + status
                if height < 4 or width < 20 or view_height < 1:
                    try:
                        stdscr.addnstr(0, 0, "window too small (resize to continue)", max(0, width - 1))
                        if height > 1:
                            stdscr.addnstr(height - 1, 0, "q quit", max(0, width - 1))
                    except curses.error:
                        pass
                    stdscr.refresh()
                    key = stdscr.getch()
                    if key in (ord("q"), ord("Q")):
                        return 0
                    continue

                if not pages:
                    stdscr.addnstr(0, 0, "pw-lab tui: no pages", max(0, width - 1))
                    stdscr.addnstr(height - 1, 0, "q quit", max(0, width - 1))
                    stdscr.refresh()
                    key = stdscr.getch()
                    if key in (ord("q"), ord("Q")):
                        return 0
                    continue

                def safe_addstr(y: int, x: int, text: str, attr: int = 0) -> None:
                    nonlocal render_errors, last_error
                    if y < 0 or y >= height:
                        return
                    if x < 0 or x >= width:
                        return
                    max_width = max(0, width - x - 1)
                    if max_width <= 0:
                        return
                    try:
                        if attr:
                            stdscr.addnstr(y, x, text, max_width, attr)
                        else:
                            stdscr.addnstr(y, x, text, max_width)
                    except curses.error as exc:
                        render_errors += 1
                        last_error = str(exc) or "curses.error"
                        _tui_log(log_path, f"render error: {last_error}")

                page = pages[page_idx]
                rows = _rows_for_page(page_idx)
                total_rows = len(rows)

                header = f"{page['title']} [{page_idx+1}/3]  {run_dir.name}"
                safe_addstr(0, 0, _truncate(header, width))

                if mode == "list":
                    if total_rows > 0:
                        selected_row = max(0, min(selected_row, total_rows - 1))
                        row_offset = max(0, min(row_offset, max(total_rows - view_height, 0)))
                        if selected_row < row_offset:
                            row_offset = selected_row
                        if selected_row >= row_offset + view_height:
                            row_offset = selected_row - view_height + 1
                    else:
                        selected_row = 0
                        row_offset = 0

                    max_label = max((len(r.get("label", "")) for r in rows), default=0)
                    label_w = min(max(10, width // 3), min(max_label, 24))
                    value_w = max(0, width - label_w - 2)

                    for idx in range(view_height):
                        row_index = row_offset + idx
                        if row_index >= total_rows:
                            break
                        row = rows[row_index]
                        y = 1 + idx
                        label = str(row.get("label") or "")
                        preview = str(row.get("preview") or row.get("value") or "")
                        preview = preview.replace("\r\n", "\n").replace("\r", "\n")
                        preview = " ".join(preview.splitlines())
                        line = label.ljust(label_w)[:label_w] + "  " + _truncate(preview, value_w).rstrip()
                        attr = curses.A_REVERSE if row_index == selected_row else 0
                        safe_addstr(y, 0, _truncate(line, width), attr)

                    if total_rows == 0:
                        safe_addstr(2, 0, "no rows")

                    _update_selection_state(page_idx, mode, selected_row)
                    sel_label = selection_state.get("field_label") or "-"
                    sel_value = selection_state.get("field_value") or "-"
                    status = f"{page['title']} {selected_row+1}/{max(total_rows,1)}  {sel_label}={_preview_text(sel_value, max_len=80)}  |  1/2/3 pages  ↑↓ PgUp/PgDn  Enter detail  y copy  q quit"
                else:
                    _update_selection_state(page_idx, mode, selected_row)
                    sel_label = selection_state.get("field_label") or "-"
                    sel_value = selection_state.get("field_value") or "-"
                    wrapped = textwrap.wrap(
                        str(sel_value),
                        width=max(1, width - 1),
                        replace_whitespace=False,
                        drop_whitespace=False,
                        break_long_words=True,
                        break_on_hyphens=False,
                    )
                    wrapped = wrapped or [""]
                    detail_scroll = max(0, min(detail_scroll, max(len(wrapped) - view_height, 0)))
                    for idx in range(view_height):
                        li = detail_scroll + idx
                        if li >= len(wrapped):
                            break
                        safe_addstr(1 + idx, 0, _truncate(wrapped[li], width))
                    status = f"detail {sel_label}  line {detail_scroll+1}/{len(wrapped)}  |  ↑↓ PgUp/PgDn  Esc back  y copy  q quit"

                if status_message:
                    status = f"{status}  |  {status_message}"
                if render_errors > 0:
                    status = f"{status}  |  render_errs={render_errors}"

                safe_addstr(height - 1, 0, _truncate(status, width))
                status_message = ""

                stdscr.refresh()
                key = stdscr.getch()
            except curses.error as exc:
                render_errors += 1
                last_error = str(exc) or "curses.error"
                _tui_log(log_path, f"render loop error: {last_error}")
                try:
                    stdscr.erase()
                    stdscr.refresh()
                except curses.error:
                    pass
                continue

            if key in (ord("q"), ord("Q")):
                return 0
            if key == curses.KEY_RESIZE:
                try:
                    stdscr.nodelay(True)
                    while True:
                        ch = stdscr.getch()
                        if ch == curses.KEY_RESIZE:
                            continue
                        if ch == -1:
                            break
                        try:
                            curses.ungetch(ch)
                        except curses.error:
                            pass
                        break
                finally:
                    stdscr.nodelay(False)
                try:
                    curses.clearok(stdscr, True)
                except curses.error as exc:
                    render_errors += 1
                    last_error = str(exc) or "curses.error"
                    _tui_log(log_path, f"resize error: {last_error}")
                continue

            if mode == "list":
                if key in (ord("1"), ord("2"), ord("3")):
                    page_idx = int(chr(key)) - 1
                    page_idx = max(0, min(page_idx, len(pages) - 1))
                    selected_row = 0
                    row_offset = 0
                    detail_scroll = 0
                    continue
                if key in (9, ord("\t")):
                    page_idx = (page_idx + 1) % len(pages)
                    selected_row = 0
                    row_offset = 0
                    detail_scroll = 0
                    continue
                if key == curses.KEY_BTAB:
                    page_idx = (page_idx - 1) % len(pages)
                    selected_row = 0
                    row_offset = 0
                    detail_scroll = 0
                    continue

                rows = _rows_for_page(page_idx)
                total_rows = len(rows)
                if key in (curses.KEY_UP, ord("k")):
                    selected_row = max(0, selected_row - 1)
                elif key in (curses.KEY_DOWN, ord("j")):
                    selected_row = min(max(total_rows - 1, 0), selected_row + 1)
                elif key in (curses.KEY_PPAGE,):
                    selected_row = max(0, selected_row - view_height)
                elif key in (curses.KEY_NPAGE,):
                    selected_row = min(max(total_rows - 1, 0), selected_row + view_height)
                elif key in (curses.KEY_HOME, ord("g")):
                    selected_row = 0
                elif key in (curses.KEY_END, ord("G")):
                    selected_row = max(total_rows - 1, 0)
                elif key in (ord("y"),):
                    if total_rows > 0:
                        value = rows[selected_row].get("value", "")
                        ok, msg = _pbcopy(value)
                        status_message = msg
                elif key in (curses.KEY_ENTER, 10, 13):
                    if total_rows > 0:
                        mode = "detail"
                        detail_scroll = 0
                continue

            # detail mode
            if key in (27,):  # esc
                mode = "list"
                detail_scroll = 0
                continue
            if key in (ord("y"),):
                value = selection_state.get("field_value") or ""
                ok, msg = _pbcopy(str(value))
                status_message = msg
                continue
            if key in (curses.KEY_UP, ord("k")):
                detail_scroll = max(0, detail_scroll - 1)
            elif key in (curses.KEY_DOWN, ord("j")):
                detail_scroll = detail_scroll + 1
            elif key in (curses.KEY_PPAGE,):
                detail_scroll = max(0, detail_scroll - view_height)
            elif key in (curses.KEY_NPAGE,):
                detail_scroll = detail_scroll + view_height
            elif key in (curses.KEY_HOME, ord("g")):
                detail_scroll = 0
            elif key in (curses.KEY_END, ord("G")):
                detail_scroll = 1_000_000_000

        return 0

    _update_selection_state(0, "list", 0)
    exit_code = curses.wrapper(_run)
    if test_out:
        _write_json(Path(test_out), selection_state)
    return exit_code


def cmd_run(args: argparse.Namespace) -> int:
    scenario_path = _resolve_scenario_path(args.scenario, Path(args.scenario_dir))
    scenario = _load_scenario(scenario_path)

    if args.outdir:
        out_dir = Path(args.outdir)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        out_dir = Path(args.out_root) / f"{stamp}_{scenario.get('id')}"

    _ensure_out_dir(out_dir, force=args.force)

    plan = {
        "scenario_id": scenario.get("id"),
        "driver": scenario.get("driver"),
        "profile": scenario.get("profile"),
        "variant": scenario.get("variant"),
        "steps": scenario.get("steps"),
    }
    _write_json(out_dir / "plan.json", plan)

    if args.dry_run:
        return 0

    pw_path = Path(args.pw)
    if not pw_path.exists():
        _die(f"PolicyWitness binary not found: {pw_path}")
    sandbox_capture = None

    service_names = _service_names_for_scenario(pw_path, scenario)
    inside = _inside_probe(service_names)
    _write_json(out_dir / "inside.json", inside)
    allow_inside = os.environ.get("PW_LAB_ALLOW_INSIDE") == "1"
    if inside.get("inside") and not allow_inside:
        run = {
            "schema_version": 1,
            "run_type": "preflight",
            "scenario": {"id": scenario.get("id"), "driver": scenario.get("driver")},
            "inside": inside,
            "exit_code": 3,
            "stdout": "",
            "stderr": "blocked: inside=true (rerun outside the harness / with escalation)",
        }
        _write_json(out_dir / "run.json", run)
        summary = {
            "labbook_version": LABBOOK_VERSION,
            "scenario_id": scenario.get("id"),
            "driver": scenario.get("driver"),
            "status": "blocked",
            "exit_code": 3,
            "inside": inside,
            "uncertainty": {
                "confidence": "unknown",
                "reasons": ["inside"],
                "collector_health": {},
            },
        }
        _write_json(out_dir / "lab_summary.json", summary)
        _write_env(out_dir, scenario, pw_path, run, inside=inside)
        return 3

    if scenario.get("driver") == "shell":
        run = _run_shell_scenario(scenario, out_dir, pw_path)
        summary = {
            "labbook_version": LABBOOK_VERSION,
            "scenario_id": scenario.get("id"),
            "driver": "shell",
            "status": "pass" if run.get("exit_code") == 0 else "fail",
            "exit_code": run.get("exit_code"),
            "uncertainty": {
                "confidence": "unknown",
                "reasons": ["shell_driver"],
                "collector_health": {},
            },
        }
        summary["inside"] = inside
    else:
        run, sandbox_capture = _run_xpc_session_scenario(
            scenario,
            out_dir,
            pw_path,
            signposts=not args.no_signposts,
            wait_timeout_ms=args.wait_timeout_ms,
            fence=not args.no_fence,
            capture_sandbox_logs=args.capture_sandbox_logs,
        )
        summary = _summarize_run(scenario, run, sandbox_capture)
        summary["inside"] = inside

    _write_json(out_dir / "lab_summary.json", summary)
    _write_env(out_dir, scenario, pw_path, run, inside=inside)
    return 0


def cmd_batch(args: argparse.Namespace) -> int:
    suite_path = _resolve_suite_path(args.suite, Path(args.suite_dir))
    suite = _load_suite(suite_path)
    pw_path = Path(args.pw)
    if not args.dry_run and not pw_path.exists():
        _die(f"PolicyWitness binary not found: {pw_path}")
    results = []
    failures = 0
    allow_inside = os.environ.get("PW_LAB_ALLOW_INSIDE") == "1"
    for entry in suite.get("scenarios", []):
        if isinstance(entry, str):
            scenario_ref = entry
            overrides = {}
        elif isinstance(entry, dict):
            scenario_ref = entry.get("scenario") or entry.get("id")
            overrides = dict(entry)
        else:
            _die("invalid scenario entry in suite")
        if not scenario_ref:
            _die("suite entry missing scenario id")
        scenario_path = _resolve_scenario_path(scenario_ref, Path(args.scenario_dir))
        scenario = _load_scenario(scenario_path)
        scenario.update({k: v for k, v in overrides.items() if k not in ("scenario", "id")})

        if args.outdir:
            out_dir = Path(args.outdir) / scenario.get("id")
        else:
            stamp = time.strftime("%Y%m%d-%H%M%S")
            out_dir = Path(args.out_root) / f"{stamp}_{scenario.get('id')}"
        _ensure_out_dir(out_dir, force=args.force)

        if args.dry_run:
            _write_json(out_dir / "plan.json", {"scenario_id": scenario.get("id"), "driver": scenario.get("driver")})
            results.append({"scenario_id": scenario.get("id"), "status": "planned", "out_dir": str(out_dir)})
            continue

        if scenario.get("driver") == "shell":
            service_names = _service_names_for_scenario(pw_path, scenario)
            inside = _inside_probe(service_names)
            _write_json(out_dir / "inside.json", inside)
            if inside.get("inside") and not allow_inside:
                run = {
                    "schema_version": 1,
                    "run_type": "preflight",
                    "scenario": {"id": scenario.get("id"), "driver": scenario.get("driver")},
                    "inside": inside,
                    "exit_code": 3,
                    "stdout": "",
                    "stderr": "blocked: inside=true (rerun outside the harness / with escalation)",
                }
                _write_json(out_dir / "run.json", run)
                summary = {
                    "labbook_version": LABBOOK_VERSION,
                    "scenario_id": scenario.get("id"),
                    "driver": "shell",
                    "status": "blocked",
                    "exit_code": 3,
                    "inside": inside,
                    "uncertainty": {
                        "confidence": "unknown",
                        "reasons": ["inside"],
                        "collector_health": {},
                    },
                }
                _write_json(out_dir / "lab_summary.json", summary)
                _write_env(out_dir, scenario, pw_path, run, inside=inside)
                results.append(
                    {"scenario_id": scenario.get("id"), "status": summary.get("status"), "out_dir": str(out_dir)}
                )
                failures += 1
                if not args.continue_on_fail:
                    break
                continue

            run = _run_shell_scenario(scenario, out_dir, pw_path)
            summary = {
                "labbook_version": LABBOOK_VERSION,
                "scenario_id": scenario.get("id"),
                "driver": "shell",
                "status": "pass" if run.get("exit_code") == 0 else "fail",
                "exit_code": run.get("exit_code"),
                "inside": inside,
                "uncertainty": {
                    "confidence": "unknown",
                    "reasons": ["shell_driver"],
                    "collector_health": {},
                },
            }
        else:
            service_names = _service_names_for_scenario(pw_path, scenario)
            inside = _inside_probe(service_names)
            _write_json(out_dir / "inside.json", inside)
            if inside.get("inside") and not allow_inside:
                run = {
                    "schema_version": 1,
                    "run_type": "preflight",
                    "scenario": {"id": scenario.get("id"), "driver": scenario.get("driver")},
                    "inside": inside,
                    "exit_code": 3,
                    "stdout": "",
                    "stderr": "blocked: inside=true (rerun outside the harness / with escalation)",
                }
                _write_json(out_dir / "run.json", run)
                summary = {
                    "labbook_version": LABBOOK_VERSION,
                    "scenario_id": scenario.get("id"),
                    "driver": scenario.get("driver"),
                    "status": "blocked",
                    "exit_code": 3,
                    "inside": inside,
                    "uncertainty": {
                        "confidence": "unknown",
                        "reasons": ["inside"],
                        "collector_health": {},
                    },
                }
                _write_json(out_dir / "lab_summary.json", summary)
                _write_env(out_dir, scenario, pw_path, run, inside=inside)
                results.append(
                    {"scenario_id": scenario.get("id"), "status": summary.get("status"), "out_dir": str(out_dir)}
                )
                failures += 1
                if not args.continue_on_fail:
                    break
                continue

            run, sandbox_capture = _run_xpc_session_scenario(
                scenario,
                out_dir,
                pw_path,
                signposts=not args.no_signposts,
                wait_timeout_ms=args.wait_timeout_ms,
                fence=not args.no_fence,
                capture_sandbox_logs=args.capture_sandbox_logs,
            )
            summary = _summarize_run(scenario, run, sandbox_capture)
            summary["inside"] = inside
        _write_json(out_dir / "lab_summary.json", summary)
        _write_env(out_dir, scenario, pw_path, run, inside=inside)
        results.append({"scenario_id": scenario.get("id"), "status": summary.get("status"), "out_dir": str(out_dir)})
        if summary.get("status") != "pass":
            failures += 1
            if not args.continue_on_fail:
                break

    batch_summary = {
        "schema_version": 1,
        "suite_id": suite.get("id"),
        "failures": failures,
        "results": results,
    }
    if args.outdir:
        _write_json(Path(args.outdir) / "batch_summary.json", batch_summary)
    return 0 if failures == 0 else 1


def _load_summary(run_dir: Path) -> Dict[str, Any]:
    summary_path = run_dir / "lab_summary.json"
    if summary_path.exists():
        return _load_json(summary_path)
    run_path = run_dir / "run.json"
    if not run_path.exists():
        _die("missing run.json or lab_summary.json")
    run = _load_json(run_path)
    scenario = run.get("scenario") or {}
    if scenario.get("driver") == "shell" or run.get("run_type") == "shell":
        return {
            "labbook_version": LABBOOK_VERSION,
            "scenario_id": scenario.get("id"),
            "driver": "shell",
            "status": "pass" if run.get("exit_code") == 0 else "fail",
            "exit_code": run.get("exit_code"),
            "uncertainty": {
                "confidence": "unknown",
                "reasons": ["shell_driver"],
                "collector_health": {},
            },
        }
    scenario_obj = {
        "id": scenario.get("id"),
        "profile": scenario.get("profile"),
        "variant": scenario.get("variant"),
        "driver": "xpc_session",
        "steps": scenario.get("steps", []),
    }
    return _summarize_run(scenario_obj, run, None)


def cmd_inspect(args: argparse.Namespace) -> int:
    run_dir = Path(args.run_dir)
    summary = _load_summary(run_dir)
    if args.json:
        print(json.dumps(summary, indent=2, sort_keys=True))
    else:
        print(f"scenario={summary.get('scenario_id')} status={summary.get('status')}")
        for step in summary.get("steps", []):
            print(
                f"  step={step.get('step_id')} probe={step.get('probe_id')} ok={step.get('ok')} outcome={step.get('normalized_outcome')}"
            )
        unc = summary.get("uncertainty", {})
        print(f"confidence={unc.get('confidence')} reasons={unc.get('reasons')}")
    return 0


def _diff_summaries(left: Dict[str, Any], right: Dict[str, Any]) -> List[Dict[str, Any]]:
    changes: List[Dict[str, Any]] = []

    def add(path: str, a: Any, b: Any) -> None:
        if a != b:
            changes.append({"path": path, "left": a, "right": b})

    add("status", left.get("status"), right.get("status"))

    l_steps = left.get("steps", [])
    r_steps = right.get("steps", [])
    for idx, step in enumerate(l_steps):
        if idx >= len(r_steps):
            add(f"steps[{idx}]", step, None)
            continue
        add(f"steps[{idx}].probe_id", step.get("probe_id"), r_steps[idx].get("probe_id"))
        add(f"steps[{idx}].ok", step.get("ok"), r_steps[idx].get("ok"))
        add(
            f"steps[{idx}].normalized_outcome",
            step.get("normalized_outcome"),
            r_steps[idx].get("normalized_outcome"),
        )

    add(
        "evidence.signposts.event_count",
        (left.get("evidence", {}).get("signposts") or {}).get("event_count"),
        (right.get("evidence", {}).get("signposts") or {}).get("event_count"),
    )
    add(
        "evidence.signposts.well_formed",
        (left.get("evidence", {}).get("signposts") or {}).get("well_formed"),
        (right.get("evidence", {}).get("signposts") or {}).get("well_formed"),
    )
    add(
        "evidence.sandbox_logs.capture_status",
        (left.get("evidence", {}).get("sandbox_logs") or {}).get("capture_status"),
        (right.get("evidence", {}).get("sandbox_logs") or {}).get("capture_status"),
    )
    return changes


def cmd_diff(args: argparse.Namespace) -> int:
    left = _load_summary(Path(args.left))
    right = _load_summary(Path(args.right))
    changes = _diff_summaries(left, right)
    if args.json:
        print(json.dumps({"changes": changes}, indent=2, sort_keys=True))
    else:
        for change in changes:
            print(f"{change['path']}: {change['left']} -> {change['right']}")
    return 0 if not changes else 1


def main() -> int:
    parser = argparse.ArgumentParser(prog="pw-lab")
    sub = parser.add_subparsers(dest="command")

    signposts = sub.add_parser("signposts", help="signpost catalog and validation")
    signposts_sub = signposts.add_subparsers(dest="signposts_cmd")

    catalog_cmd = signposts_sub.add_parser("catalog", help="print the signpost catalog")
    catalog_cmd.add_argument("--catalog", default="xpc/signpost_catalog.json")
    catalog_cmd.add_argument("--json", action="store_true")
    catalog_cmd.set_defaults(func=cmd_signposts_catalog)

    validate_cmd = signposts_sub.add_parser("validate", help="validate signpost event stream")
    validate_cmd.add_argument("--input", required=True, help="path to session JSONL (or '-')")
    validate_cmd.add_argument("--catalog", default=None, help="optional catalog path")
    validate_cmd.add_argument("--strict-catalog", action="store_true")
    validate_cmd.set_defaults(func=cmd_signposts_validate)

    timeline_cmd = sub.add_parser("timeline", help="render a signpost timeline")
    timeline_cmd.add_argument("--input", required=True, help="path to session JSONL (or '-')")
    timeline_cmd.add_argument("--signposts-only", action="store_true")
    timeline_cmd.set_defaults(func=cmd_timeline)

    tui_cmd = sub.add_parser("tui", help="render a minimal evidence ledger")
    tui_cmd.add_argument("run_dir")
    tui_cmd.set_defaults(func=cmd_tui)

    inside_cmd = sub.add_parser("inside", help="detect whether the caller is sandboxed (fail-closed)")
    inside_cmd.add_argument("--pw", default=DEFAULT_PW)
    inside_cmd.add_argument("--profile", default=None, help="optional profile id (or id@variant) to check")
    inside_cmd.add_argument("--variant", default=None, help="variant to check (default: base)")
    inside_cmd.add_argument(
        "--service-name",
        action="append",
        default=[],
        help="additional mach service name(s) to check via sandbox_check",
    )
    inside_cmd.add_argument("--bare", action="store_true", help="print true/false only")
    inside_cmd.set_defaults(func=cmd_inside)

    specimen_cmd = sub.add_parser("specimen", help="run a PWRunner specimen evaluation (canonical + instrumented)")
    specimen_cmd.add_argument("specimen", help="path to specimen JSON/YAML")
    specimen_cmd.add_argument("--pw", default=DEFAULT_PW)
    specimen_cmd.add_argument("--timeout-s", type=int, default=240)
    specimen_cmd.add_argument("--log-last", default="10s", help="log show lookback window (sandbox-log-observer --last)")
    specimen_cmd.add_argument("--outdir", default=None)
    specimen_cmd.add_argument("--out-root", default=DEFAULT_OUT_ROOT)
    specimen_cmd.add_argument("--force", action="store_true")
    specimen_cmd.set_defaults(func=cmd_specimen)

    inspect_cmd = sub.add_parser("inspect", help="inspect a lab run directory")
    inspect_cmd.add_argument("run_dir")
    inspect_cmd.add_argument("--json", action="store_true")
    inspect_cmd.set_defaults(func=cmd_inspect)

    diff_cmd = sub.add_parser("diff", help="diff two lab run directories")
    diff_cmd.add_argument("left")
    diff_cmd.add_argument("right")
    diff_cmd.add_argument("--json", action="store_true")
    diff_cmd.set_defaults(func=cmd_diff)

    args = parser.parse_args()
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
