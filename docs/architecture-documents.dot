digraph documents {
    graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11, label="The document graph", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_manifests {
        label="hand-owned manifests"; style=dashed; color="#888888"; fontsize=10;
        contract_json;
        limits_json;
        matrix_json;
        architecture_json;
        catalog_json;
        prose_baseline;
    }
    subgraph cluster_generators {
        label="generators"; style=dashed; color="#888888"; fontsize=10;
        gen_contract;
        gen_limits;
        gen_identity;
        gen_architecture;
        gen_common;
    }
    subgraph cluster_docs {
        label="documents"; style=dashed; color="#888888"; fontsize=10;
        contract_md;
        limits_md;
        guide;
        questions_md;
        failure_contract;
        architecture_md;
        agents_md;
        controller_readme;
        runner_readme;
        tests_readme;
        coverage_md;
    }
    subgraph cluster_sources {
        label="sources with generated or checked regions"; style=dashed; color="#888888"; fontsize=10;
        api_swift;
        json_contract_rs;
        contract_py;
        abi_header;
        cworker_swift;
        cli_rs;
        identity_sources;
        meson_build;
        suites;
    }
    subgraph cluster_checks {
        label="checks"; style=dashed; color="#888888"; fontsize=10;
        drift_check;
        drift_limits;
        drift_contract;
        drift_architecture;
        drift_generators;
        preflight;
        build;
    }
    contract_json [shape="folder", style="filled", fillcolor="#fff6c2", color="#8a7400", label="docs/contract.json\ncontract_json", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="contract_json: docs/contract.json | the request, response and envelope version numbers "];
    limits_json [shape="folder", style="filled", fillcolor="#fff6c2", color="#8a7400", label="docs/limits.json\nlimits_json", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="limits_json: docs/limits.json | every runtime limit with its source and check citations "];
    matrix_json [shape="folder", style="filled", fillcolor="#fff6c2", color="#8a7400", label="tests/fixtures/comparison/matrix.json\nmatrix_json", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="matrix_json: tests/fixtures/comparison/matrix.json | the comparison scenario matrix "];
    architecture_json [shape="folder", style="filled", fillcolor="#fff6c2", color="#8a7400", label="docs/architecture.json\narchitecture_json", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="architecture_json: docs/architecture.json | the nodes and edges of these figures, each with its citations "];
    catalog_json [shape="folder", style="filled", fillcolor="#fff6c2", color="#8a7400", label="tests/catalog.json\ncatalog_json", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="catalog_json: tests/catalog.json | the registered suites and cases "];
    gen_contract [shape="component", style="filled", fillcolor="#e6f4ea", color="#2e7d32", label="generate_contract.py\ngen_contract", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="gen_contract: generate_contract.py | the generated contract-version regions "];
    gen_limits [shape="component", style="filled", fillcolor="#e6f4ea", color="#2e7d32", label="generate_limits.py\ngen_limits", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="gen_limits: generate_limits.py | the limits tables, the scenario matrix, the guide's copied regions and the limits spans "];
    gen_identity [shape="component", style="filled", fillcolor="#e6f4ea", color="#2e7d32", label="generate_worker_identity.py\ngen_identity", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="gen_identity: generate_worker_identity.py | the host/worker source identity regions "];
    gen_architecture [shape="component", style="filled", fillcolor="#e6f4ea", color="#2e7d32", label="generate_architecture.py\ngen_architecture", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="gen_architecture: generate_architecture.py | these figures, their dot and SVG files, the tables beside them and the architecture spans "];
    contract_md [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="docs/CONTRACT.md\ncontract_md", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="contract_md: docs/CONTRACT.md | the version sentence and table "];
    limits_md [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="docs/LIMITS.md\nlimits_md", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="limits_md: docs/LIMITS.md | the limits tables and coverage "];
    guide [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="docs/PolicyWitness.md\nguide", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="guide: docs/PolicyWitness.md | copied limits, questions and reading rules; the version sentence; the only document that ships "];
    questions_md [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="docs/QUESTIONS.md\nquestions_md", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="questions_md: docs/QUESTIONS.md | the shared questions the guide copies "];
    failure_contract [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="tests/FAILURE-PROPAGATION-CONTRACT.md\nfailure_contract", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="failure_contract: tests/FAILURE-PROPAGATION-CONTRACT.md | the generated scenario matrix and the shared reading rules "];
    architecture_md [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="docs/ARCHITECTURE.md\narchitecture_md", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="architecture_md: docs/ARCHITECTURE.md | these figures and their tables "];
    agents_md [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="AGENTS.md\nagents_md", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="agents_md: AGENTS.md | the canonical sandboxed-harness note "];
    controller_readme [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="controller/README.md\ncontroller_readme", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="controller_readme: controller/README.md | the CLI surface block and the version sentence "];
    runner_readme [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="runner/README.md\nrunner_readme", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="runner_readme: runner/README.md | the harness-note copy, the test-seam table and the version sentence "];
    tests_readme [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="tests/README.md\ntests_readme", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="tests_readme: tests/README.md | the harness-note copy and the suite table "];
    coverage_md [shape="note", style="filled", fillcolor="#ffffff", color="#444444", label="tests/COVERAGE.md\ncoverage_md", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="coverage_md: tests/COVERAGE.md | the outcome coverage matrices "];
    api_swift [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="PWRunnerAPI.swift\napi_swift", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="api_swift: PWRunnerAPI.swift | the Swift contract versions and the outcome vocabularies "];
    json_contract_rs [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="json_contract.rs\njson_contract_rs", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="json_contract_rs: json_contract.rs | the Rust contract versions; the envelope frame "];
    contract_py [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="tests/lib/contract.py\ncontract_py", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="contract_py: tests/lib/contract.py | the Python contract versions and the worker identity "];
    abi_header [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="pw_probe_runner_abi.h\nabi_header", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="abi_header: pw_probe_runner_abi.h | the C identity region and the shared-region layout "];
    cworker_swift [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="CWorker.swift\ncworker_swift", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="cworker_swift: CWorker.swift | the Swift identity region and the layout mirror "];
    cli_rs [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="cli.rs\ncli_rs", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="cli_rs: cli.rs | the usage text the controller README mirrors "];
    identity_sources [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="worker and runner sources\nidentity_sources", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="identity_sources: worker and runner sources | every byte the identity digest covers "];
    meson_build [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="meson.build\nmeson_build", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="meson_build: meson.build | the native targets and their explicit source lists "];
    suites [shape="box", style="filled", fillcolor="#f2f2f2", color="#444444", label="tests/suites/<name>/\nsuites", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="suites: tests/suites/<name>/ | one run.sh and README per suite "];
    drift_check [shape="octagon", style="dashed", color="#8e24aa", label="source_drift check.py\ndrift_check", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="drift_check: source_drift check.py | copies and vocabularies that are not generated, the Known gap index, the evidence-channel landing paths and the core ideas "];
    drift_limits [shape="octagon", style="dashed", color="#8e24aa", label="source_drift limits.py\ndrift_limits", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="drift_limits: source_drift limits.py | the limits generator's copies and every local documentation link "];
    drift_contract [shape="octagon", style="dashed", color="#8e24aa", label="source_drift contract.py\ndrift_contract", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="drift_contract: source_drift contract.py | the contract and identity generators' copies "];
    drift_architecture [shape="octagon", style="dashed", color="#8e24aa", label="source_drift architecture.py\ndrift_architecture", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="drift_architecture: source_drift architecture.py | this manifest against its dot, SVG and document copies "];
    gen_common [shape="component", style="filled", fillcolor="#e6f4ea", color="#2e7d32", label="generator_common.py\ngen_common", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="gen_common: generator_common.py | the citation forms, the duration pattern, the limits formatter and the span rules the two document generators share "];
    prose_baseline [shape="folder", style="filled", fillcolor="#fff6c2", color="#8a7400", label="tests/fixtures/docs/prose_baseline.json\nprose_baseline", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="prose_baseline: tests/fixtures/docs/prose_baseline.json | every prose site that still states a value, a count or a citation in an unverified form "];
    drift_generators [shape="octagon", style="dashed", color="#8e24aa", label="source_drift generators.py\ndrift_generators", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="drift_generators: source_drift generators.py | the uniform generator invariants, the baseline's consistency, the drift node's rule list and the form table's copy "];
    preflight [shape="octagon", style="dashed", color="#8e24aa", label="release_preflight.py\npreflight", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="preflight: release_preflight.py | the baseline against the previous release tag "];
    build [shape="octagon", style="dashed", color="#8e24aa", label="build.sh\nbuild", URL="ARCHITECTURE.md#the-document-graph-nodes", tooltip="build: build.sh | compiles the native executables through Meson, checks the configured source lists against the tree, assembles and signs the bundle and stages the guide "];
