        }
      ]
    },
    "shell_helpers": {
      "command": [
        "bash",
        "tests/suites/shell_helpers/run.sh"
      ],
      "requires": [],
      "cases": [
        {
          "id": "controls",
          "description": "shell helpers retain diagnostics and case identity; failures prevent later stages"
        },
        {
          "id": "finalizers",
          "description": "result helpers preserve terminal evidence, literal data, logging, and exit behavior"
        },
        {
          "id": "python_startup",
          "description": "optimized Python is rejected; normal assertion failures remain test failures"
        },
        {
          "id": "script_groups",
          "description": "wrappers preserve child order, streams, phase boundaries, and failing status"
        },
        {
          "id": "worker_setup",
          "description": "worker cases share setup; equipment failures stop before assertions and preserve evidence"
        },
        {
          "id": "byoxpc_setup",
          "description": "BYOXPC staging preserves the source, owns partial installation, and verifies cleanup"
