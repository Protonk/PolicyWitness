      "text": "example\n  initial-reads\n    read-hosts\n      sandbox_check file-read-data /etc/hosts\n      attempt open_read /etc/hosts\n    metadata-propernames-read-connectives\n      sandbox_check file-read-metadata /usr/share/dict/propernames\n      attempt read_fresh /usr/share/dict/connectives\n  restricted-read\n    read-propernames\n      sandbox_check file-read-data /usr/share/dict/propernames\n      attempt open_read /usr/share/dict/propernames\nexample extension\n  actors\n    issuer unentitled unapplied\n    Alice selected apply\n    Bob selected apply\n  alice-before Alice\n    alice-baseline\n      sandbox_check file-read-data /private/etc/hosts\n      attempt read_fresh /private/etc/hosts\n  bob-before Bob\n    bob-baseline\n      sandbox_check file-read-data /private/etc/hosts\n      attempt read_fresh /private/etc/hosts\n  supply issuer\n    issue\n      extension issue file read /private/etc/hosts\n    deliver\n      extension transfer Alice\n  consume Alice\n    consume\n      extension consume\n  alice-during Alice\n    alice-fresh\n      sandbox_check file-read-data /private/etc/hosts\n      attempt read_fresh /private/etc/hosts\n  bob-during Bob\n    bob-fresh\n      sandbox_check file-read-data /private/etc/hosts\n      attempt read_fresh /private/etc/hosts\n  release Alice\n    release\n      extension release\n"
    },
    "result": {
      "references": [
        "topic.result",
        "result.fields",
        "result.local_request_refusal",
        "result.tool_failure",
        "result.admission_refusal",
        "result.admitted_finished",
        "result.admitted_unavailable"
      ],
      "text": "result\n  normalized_outcome ok exit_code\n  bad_request false 1\n  tool_error false 2\n  missing_runner_client false 1\n  unsupported_runner_client false 1\n  malformed_runner_client false 1\n  runner_reply_truncated false 1\n  unsupported_runner_response false 1\n  malformed_runner_response false 1\n  xpc_error false 1\n  xpc_timeout false 1\n  xpc_acquisition_failed false 1\n  xpc_submission_refused false 1\n  xpc_protocol_error false 1\n  runner_client_error false 1\n  finished true 0\n  runner_response_unavailable false 1\n"
    },
    "run": {
      "references": [
        "command.run",
        "run.option.runner_mode",
        "runner_kind.standard@run_option",
        "runner_kind.byoxpc@run_option",
        "command.help",
        "run.field_lookup",
        "run.field.extensionToken",
        "run.field.extensionDelivery",
        "run.field.extensionHandle",
        "run.field.extensionRecipient",
        "run.field.extensionTarget",
        "run.field.target",
        "run.field.filterValue"
      ],
      "text": "run\n  --runner-mode\n    standard\n    byoxpc\n  help run <key>\n    token_ref\n    delivery_ref\n    handle_ref\n    recipient\n    extension.target\n    target\n    sandbox_check.filter.value\n"
    },
    "runner": {
      "references": [
        "command.runner",
        "runner.form.list",
        "runner.form.status",
        "runner.selector.id",
        "runner.selector.service_name",
        "runner.form.reconcile",
        "runner.form.verify",
        "runner.form.install",
        "runner.form.validate",
        "runner.form.remove",
        "runner.removal"
      ],
      "text": "runner\n  list\n    List registered runners and pending cleanup records.\n  status\n    Read one registered runner.\n    runner status --id <runner-id>\n    runner status --service-name <service-name>\n  reconcile\n    Inspect service and plist presence and ownership without changing them.\n  verify\n    Send a fixed verification request to the selected runner.\n    runner verify --id <runner-id>\n    runner verify --service-name <service-name>\n  install\n    Register an XPC bundle and prepare its launchd service.\n  validate\n    Refresh the registry with signature and entitlement observations.\n  remove\n    Remove the selected installation or retry its pending cleanup.\n    data.cleanup_retained false\n      Discard staging. The service and plist were observed absent and cleanup was saved.\n    data.cleanup_retained true\n      Keep the staged bundle and ownership record. Read data.warnings and data.retained_record.\n      Find the pending record and inspect service and plist ownership.\n      Retry with its recorded selector when the remaining resources are owned or absent.\n      runner list\n      runner reconcile\n      runner remove --id <runner-id>\n      runner remove --service-name <service-name>\n"
    }
  },
