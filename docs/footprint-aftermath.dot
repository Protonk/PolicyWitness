digraph footprint_aftermath {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="Host retirement", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    fa1 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Host: asynchronous retirement\nReply precedes scheduled exit\nfa1", URL="ARCHITECTURE.md#host-retirement-nodes", tooltip="fa1: Host: asynchronous retirement\nReply precedes scheduled exit | host; reply sent → host exit; host process exit Schedules retirement after replying. A live host at CLI return may still be in this interval; its generation needs an independent end observation."];
    fa2 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Submitted host / worker work\nClient timeout does not cancel it\nfa2", URL="ARCHITECTURE.md#host-retirement-nodes", tooltip="fa2: Submitted host / worker work\nClient timeout does not cancel it | host / workers; irreversible submission → resource-specific completion or failure; each identified process exits independently A post-invocation client deadline ends the client wait without cancelling submitted work. Gate release, signalling and fixture cleanup are later interventions."];
    fa3 [shape="box", style="rounded,filled", fillcolor="#fff0cd", color="#555555", label="Authority / custody owners\nErase ≠ detach ≠ release ≠ exit\nfa3", URL="ARCHITECTURE.md#host-retirement-nodes", tooltip="fa3: Authority / custody owners\nErase ≠ detach ≠ release ≠ exit | host / actor workers; actor cleanup → each owner-specific ending; shared erasure, host unmap, private disposal and worker exit Shared erasure requires a reaped or never-launched owner; unresolved workers withhold erasure while host detachment proceeds. Private custody is erased/disposed separately. Native release does neither."];
    fa4 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Pre-existing registry / plists\nBaseline comparison only\nfa4", URL="ARCHITECTURE.md#host-retirement-nodes", tooltip="fa4: Pre-existing registry / plists\nBaseline comparison only | registry / launchd files; before invocation → post-run inventory comparison; baseline comparison; no run-owned removal implied Plain run inventory compares registry state and directory names. Pre-existing installed services are baseline, not run-created apparatus. Name equality does not establish every object identity."];
    fa5 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Requested effects / descendants\nOwn endings; leader exit insufficient\nfa5", URL="ARCHITECTURE.md#host-retirement-nodes", tooltip="fa5: Requested effects / descendants\nOwn endings; leader exit insufficient | specimen; requested operation → effect-specific removal or descendant exit; independent descendant exit or owned effect removal Requested file effects and surviving exec descendants remain separate from apparatus residue. Leader exit or stream EOF does not establish descendant exit."];
    fa6 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Output / observer resources\nExplicit caller / harness cleanup\nfa6", URL="ARCHITECTURE.md#host-retirement-nodes", tooltip="fa6: Output / observer resources\nExplicit caller / harness cleanup | caller / harness; caller/harness preparation → recorded owned cleanup; explicit output/observer cleanup Envelope files, gates, meters, staging and exit watchers have caller/harness ownership. Their removal cannot substitute for the pre-intervention product snapshot."];
    fa2 -> fa1 [color="#70428c", style="dashed", label="F301 reply before retirement", URL="ARCHITECTURE.md#host-retirement-edges", tooltip="F301: reply before retirement |  "];
    fa2 -> fa3 [color="#70428c", style="dashed", label="F302 owner-qualified endings", URL="ARCHITECTURE.md#host-retirement-edges", tooltip="F302: owner-qualified endings |  "];
    fa4 -> fa2 [color="#70428c", style="dotted", label="F303 baseline, not run residue", URL="ARCHITECTURE.md#host-retirement-edges", tooltip="F303: baseline, not run residue |  "];
    fa5 -> fa6 [color="#70428c", style="dotted", label="F304 observe before cleanup", URL="ARCHITECTURE.md#host-retirement-edges", tooltip="F304: observe before cleanup |  "];
}
