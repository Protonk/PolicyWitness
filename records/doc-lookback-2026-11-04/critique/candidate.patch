+    fn documented_request_failure_path_limits_match_retained_paths() {
+        let depth = (0..=128)
+            .filter(|&count| {
+                RequestError::new("type_mismatch", &vec!["key"; count], "invalid value")
+                    .failure
+                    .path
+                    .is_some()
+            })
+            .max()
