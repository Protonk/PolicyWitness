{
  "schema_version": 1,
  "spans": [
    {
      "category": "xpc_service",
      "description": "session wait fence span (service waits for trigger)",
      "interval": true,
      "name": "pw.fence.waiting",
      "process": "service"
    },
    {
      "category": "xpc_service",
      "description": "probe execution bracket inside the service",
      "interval": true,
      "name": "pw.probe.exec",
      "process": "service"
    },
    {
      "category": "xpc_service",
      "description": "service-side request handler span (open/keepalive/run/close)",
      "interval": true,
      "name": "xpc_request",
      "process": "service"
    },
    {
      "category": "xpc_client",
      "description": "client-side XPC call span",
      "interval": true,
      "name": "xpc_call",
      "process": "client"
    }
  ]
}
