digraph build_steps {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="One build in time", labelloc=t, pad=0.3, nodesep=0.2, ranksep=0.25];
    node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f2f2f2", color="#444444"];
    edge [fontname="Helvetica", fontsize=9, color="#444444"];
    make_build [label="make_build\n[build] build, sign and embed evidence into …/PolicyWitness.app", URL="BUILD.md#one-build-in-time", tooltip="make_build: reads IDENTITY, DIST_DIR and, when the caller set it, PW_FRESH_BUILD from the make command line or environment; writes nothing; runs build.sh with them", fillcolor="#fff4e0"];
    admission [label="admission\n(before the first banner)\n4 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="admission: reads BUILD_XPC, PW_INSPECTION, PW_FRESH_BUILD and the argument list (--help prints the usage and exits before any check, after the knobs are validated); whether each tracked input the build copies exists; tests/.checkout.lock, which the launcher takes before running the script again under it; writes the owner record in tests/.checkout.lock for as long as the build and its protected children hold it; nothing else"];
    lock [label="lock\nVerifying the checkout lock: …/tests/.checkout.lock\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="lock: reads the inherited lock descriptor and the claim the launcher left in the environment, verified against this checkout's lock file; writes nothing"];
    check_limits [label="check_limits\nChecking limits documentation\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_limits: reads docs/limits.json and the documents it renders; writes nothing"];
    check_contract [label="check_contract\nChecking contract versions\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_contract: reads docs/contract.json, docs/architecture.json and their generated copies; writes nothing"];
    check_build_doc [label="check_build_doc\nChecking build documentation\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_build_doc: reads docs/build.json, build.sh, meson.build, the Makefile, the inventories, the baseline and the generated copies; writes nothing"];
    check_identity [label="check_identity\nChecking host/worker identity\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_identity: reads the identity inputs and the three generated copies; writes nothing"];
    stamp [label="stamp\nBuild stamp: … (…) …\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="stamp: reads git describe, rev-parse and rev-list, or PW_VERSION and PW_BUILD_NUMBER from the environment; writes the four stamp variables for Cargo and the plists; controller/target/ and the build session file, opened with the stamp and the three knobs"];
    minimum [label="minimum\nSupported macOS (Info.plist LSMinimumSystemVersion): …\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="minimum: reads LSMinimumSystemVersion in Info.plist; writes MACOSX_DEPLOYMENT_TARGET for Cargo"];
    sdk [label="sdk\nSelecting the macOS SDK (xcrun --sdk …)\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sdk: reads the SDK path and numeric version xcrun reports under DEVELOPER_DIR for the macosx default, or for the SDK a caller's SDKROOT names; writes SDKROOT for Cargo and Meson, resolved by xcrun, and the SDK version every shipped output must carry"];
    builddir [label="builddir\nChecking the native build directory: …\n6 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="builddir: reads in incremental mode: builddir/meson-info/meson-info.json and builddir/pw-toolchain.json when the directory is configured, and the stamped SDK, developer directory, compiler commands and Rust compiler probed now; in fresh mode nothing, since the directory is replaced; writes the toolchain observation into the build session"];
    identity [label="identity\nChecking the signing identity\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="identity: reads IDENTITY and the keychain listing; the knobs, for Meson's options and RUSTFLAGS; writes RUSTFLAGS, when inspection is on and it was unset or empty, and the record of who set it"];
    cargo_admit [label="cargo_admit\nAdmitting the Cargo output and intermediate directories: …\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="cargo_admit: reads cargo metadata's report of the target and build directories under the pinned target directory, with the caller's Cargo environment and configuration; writes the admission into the build session"];
    fresh [label="fresh\nReplacing the build caches (PW_FRESH_BUILD=1): … …/release\n2 refusal(s)\n(fresh mode only)", URL="BUILD.md#one-build-in-time", tooltip="fresh: reads every path component of builddir/ and controller/target/release/ below the checkout: a real directory of this user, or absent; writes removes both directories; records each one's replacement in the build session; nothing else is removed", style="rounded,dotted", fillcolor="#fdf2f2"];
    cargo [label="cargo\nBuilding Rust controller + tools\n6 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="cargo: reads cargo on PATH with its configuration, caches and registries; controller/ sources, the stamp variables, MACOSX_DEPLOYMENT_TARGET, SDKROOT and RUSTFLAGS; the artifact paths and per-target reuse judgments Cargo reports, and Cargo's fingerprint for each shipped target; writes controller/target/release/ under the pinned output directory, the messages file Cargo reports its artifacts in, and the judgments into the build session"];
    toolchain [label="toolchain\nChecking the native toolchain (meson, ninja … or newer)\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="toolchain: reads meson and ninja on PATH and ninja's version; writes nothing"];
    configure [label="configure\nConfiguring native build (meson configure, existing directory): …\n4 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="configure: reads whether builddir/build.ninja exists, meson.build, meson.options and the two Meson options; a fresh setup also reads CFLAGS and the other flag variables, and the compilers Meson selected; writes builddir/ configuration; a fresh setup publishes builddir/pw-toolchain.json atomically from the selected compilers, SDK and Rust compiler; meson configure records the two options and the policy assertions run at setup or at the regeneration the next compile triggers"];
    compile [label="compile\nCompiling native executables\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="compile: reads the native sources through builddir/; a changed option triggers regeneration, which runs the policy assertions first; writes builddir/ outputs and the Swift module cache under it"];
    native_check [label="native_check\nChecking the configured native source lists and the identity closure against the tree\n8 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="native_check: reads Meson's introspection of builddir/, Ninja's dependency log, the identity inputs, the stamp and the compilers the directory records, and every shipped output's load commands; writes builddir/pw-toolchain.json extended with the Swift compiler a reused directory discovered when this build enabled the XPC pieces, atomically and without changing another field; the toolchain, option and SDK observations into the build session"];
    assemble [label="assemble\nAssembling app bundle: …", URL="BUILD.md#one-build-in-time", tooltip="assemble: reads Info.plist, the three Rust outputs, runner/augments/, dist/README.md and dist/AGENTS.md, all admitted before the first check; writes the two documents under DIST_DIR; removes the previous app, ZIP and guide; the stamped Info.plist, the three Rust executables and the augments under the new app"];
    embed_client [label="embed_client\nEmbedding PW runner client", URL="BUILD.md#one-build-in-time", tooltip="embed_client: reads builddir/pw-runner-client; writes Contents/MacOS/pw-runner-client and its dSYM in inspection builds", fillcolor="#e8f0fe"];
    embed_services [label="embed_services\nEmbedding PWRunner XPC services", URL="BUILD.md#one-build-in-time", tooltip="embed_services: reads each service's Info.plist and builddir/ host, the worker, validator and issuer; writes each service bundle: its stamped Info.plist, the host with its dSYM in inspection builds, the worker, validator and issuer", fillcolor="#e8f0fe"];
    skip_xpc [label="skip_xpc\nSkipping embedded XPC build (BUILD_XPC=0)", URL="BUILD.md#one-build-in-time", tooltip="skip_xpc: reads nothing; writes nothing", style="rounded,dashed", fillcolor="white"];
    presign [label="presign\nChecking host/worker identity again, before signing\n3 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="presign: reads the identity inputs and copies, the generated identity in tests/lib/contract.py and the built worker's --version report; writes nothing"];
    sign_tools [label="sign_tools\nCodesigning embedded MacOS tools\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sign_tools: reads the copied top-level helpers; writes signatures on the top-level helpers"];
    sign_services [label="sign_services\nCodesigning embedded XPC services\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sign_services: reads each service's Entitlements.plist, admitted before the first check, and the assembled bundle; writes signatures on the nested helpers, then each service seal", fillcolor="#e8f0fe"];
    evidence [label="evidence\nWriting evidence manifest and provenance record\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="evidence: reads the signed bytes, entitlements and exported symbols of the helpers, services and augments; the build session; every shipped output's load commands and signature display; writes Contents/Resources/Evidence/manifest.json, symbols.json and provenance.json, the manifest listing the other two"];
    seal [label="seal\nCodesigning app bundle\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="seal: reads PolicyWitness.entitlements; writes the app seal over everything under Contents/"];
    verify [label="verify\nVerifying signature + entitlements\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="verify: reads the sealed app; writes nothing"];
    signer [label="signer\nChecking every executable's signer\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="signer: reads every regular file under the app's and each service's Contents/MacOS, and the app and service seals, as codesign displays them; writes nothing"];
    sign_observer [label="sign_observer\nCodesigning observer tool (not embedded)\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sign_observer: reads controller/target/release/sandbox-log-observer; writes that executable's signature, in place"];
    guide [label="guide\nStaging checked user guide\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="guide: reads docs/PolicyWitness.md and its inputs; writes PolicyWitness.md under DIST_DIR"];
    zip [label="zip\nCreating zip (for notarization): …", URL="BUILD.md#one-build-in-time", tooltip="zip: reads the sealed app; writes PolicyWitness.zip under DIST_DIR"];
    make_build -> admission;
    admission -> lock;
    lock -> check_limits;
    check_limits -> check_contract;
    check_contract -> check_build_doc;
    check_build_doc -> check_identity;
    check_identity -> stamp;
    stamp -> minimum;
    minimum -> sdk;
    sdk -> builddir;
    builddir -> identity;
    identity -> cargo_admit;
    cargo_admit -> fresh [style=dotted];
    fresh -> cargo [style=dotted];
    cargo_admit -> cargo;
    cargo -> toolchain;
    toolchain -> configure;
    configure -> compile;
    compile -> native_check;
    native_check -> assemble;
    assemble -> embed_client [color="#1f5fbf"];
    embed_client -> embed_services [color="#1f5fbf"];
    assemble -> skip_xpc [style=dashed];
    embed_services -> presign [color="#1f5fbf"];
    skip_xpc -> presign [style=dashed];
    presign -> sign_tools;
    sign_tools -> sign_services [color="#1f5fbf"];
    sign_services -> evidence [color="#1f5fbf"];
    sign_tools -> evidence [style=dashed];
    evidence -> seal;
    seal -> verify;
    verify -> signer;
    signer -> sign_observer;
    sign_observer -> guide;
    guide -> zip;
}
