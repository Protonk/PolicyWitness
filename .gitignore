# Distribution documentation is tracked; generated output stays local.
/dist/*
!/dist/README.md
!/dist/AGENTS.md

# da mac
.DS_Store

# Meson build directories (builddir for production, builddir-* for alternate
# toolchains): configuration and incremental outputs, trusted working state
# like controller/target/ (docs/SIGNING.md).
/builddir*/

# controller (Rust)
controller/target

# Output of the manual ad hoc-signed validator debugger helper
# (controller/tools/sb_api_validator/build.sh); production builds write to builddir/.
/controller/tools/sb_api_validator/sb_api_validator

# Local scratch is disposable; keep its contributor policy.
/.tmp/*
!/.tmp/AGENTS.md

# tests artifacts
tests/out/
tests/**/__pycache__/
docs/__pycache__/

# Stable checkout advisory lock; never remove while held.
/tests/.checkout.lock
