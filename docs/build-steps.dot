digraph build_steps {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="One build in time", labelloc=t, pad=0.3, nodesep=0.2, ranksep=0.25];
    node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f2f2f2", color="#444444"];
    edge [fontname="Helvetica", fontsize=9, color="#444444"];
    make_build [label="make_build\n[build] build, sign and embed evidence into …/PolicyWitness.app", URL="BUILD.md#one-build-in-time", tooltip="make_build: reads IDENTITY, DIST_DIR and, when the caller set it, PW_FRESH_BUILD from the make command line or environment; writes nothing; runs build.sh with them", fillcolor="#fff4e0"];
    admission [label="admission\n(before the first banner)\n4 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="admission: reads BUILD_XPC, PW_INSPECTION, PW_FRESH_BUILD and the argument list (--help prints the usage and exits before any check, after the knobs are validated); whether each tracked input the build copies exists; without a claim in the environment, the caller's SDKROOT, CPATH, LIBRARY_PATH, MANPATH and LC_CTYPE, recorded by the shell front end's builtins before any Python runs, and tests/.checkout.lock, which the owner it starts takes before supervising the script again under it; writes the owner record in tests/.checkout.lock (pid, start time, acquisition nonce and admission socket identity) for as long as the owner and its protected children hold it; nothing else"];
    lock [label="lock\nVerifying the checkout lock: …/tests/.checkout.lock\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="lock: reads the channel's socket identity matching the acquisition record and its kernel-reported peer PID matching the acquisition owner and the owner's handoff over the channel the claim names: the held descriptor, open on this checkout's lock file, the acquisition nonce its owner record carries and the requests the owner bound to that acquisition; never the environment alone; writes SDKROOT, CPATH, LIBRARY_PATH, MANPATH and LC_CTYPE restored to the caller's recorded state; nothing on disk"];
    check_limits [label="check_limits\nChecking limits documentation\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_limits: reads docs/limits.json and the documents it renders; writes nothing"];
    check_contract [label="check_contract\nChecking contract versions\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_contract: reads docs/contract.json, docs/architecture.json and their generated copies; writes nothing"];
    check_build_doc [label="check_build_doc\nChecking build documentation\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_build_doc: reads docs/build.json, build.sh, meson.build, the Makefile, the inventories, the baseline and the generated copies; writes nothing"];
    check_identity [label="check_identity\nChecking host/worker identity\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="check_identity: reads the identity inputs and the three generated copies; writes nothing"];
    stamp [label="stamp\nBuild stamp: … (…) …\n3 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="stamp: reads git describe, rev-parse and rev-list, or PW_VERSION and PW_BUILD_NUMBER from the environment; writes the four stamp variables for Cargo and the plists; after admitting builddir/, controller/target/, its release/, its aarch64-apple-darwin/ and that directory's release/, and the session destination, controller/target/ when it is missing and the build session file, opened with the stamp, the three knobs, the fixed output target, the acquisition nonce and the owner's requests"];
    minimum [label="minimum\nSupported macOS (Info.plist LSMinimumSystemVersion): …\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="minimum: reads LSMinimumSystemVersion in Info.plist; writes MACOSX_DEPLOYMENT_TARGET for Cargo"];
    sdk [label="sdk\nSelecting the macOS SDK (xcrun --sdk …)\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sdk: reads the SDK path and numeric version xcrun reports under DEVELOPER_DIR for the macosx default, or for the SDK a caller's SDKROOT names; writes SDKROOT for Cargo and Meson, resolved by xcrun, and the SDK version every shipped output must carry"];
    builddir [label="builddir\nChecking the native build directory: …\n11 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="builddir: reads in incremental mode: builddir/meson-info/meson-info.json and builddir/pw-toolchain.json when the directory is configured: its output target (Meson's host machine, the targets' architecture selections and the Cargo triple), compared with the required target and then with Meson's introspection of the directory before any probe, and the stamped SDK, developer directory, compiler commands and Rust compiler probed now; in fresh mode nothing, since the directory is replaced; writes the toolchain observation into the build session"];
    identity [label="identity\nChecking the signing identity\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="identity: reads IDENTITY and the keychain listing; the knobs, for Meson's options and RUSTFLAGS; writes RUSTFLAGS, when inspection is on and it was unset or empty, and the record of who set it"];
    cargo_admit [label="cargo_admit\nAdmitting the Cargo output and intermediate directories: …\n6 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="cargo_admit: reads Cargo's configuration as one invocation from this directory reads it: `.cargo/config` or `config.toml` here, in each ancestor and in Cargo home, with their includes, merged by Cargo's precedence; the environment overrides; the launcher (a rustup proxy and the toolchain it resolves); the output triple the command passes and the lower-precedence target defaults it overrides; and cargo metadata's report of the target and build directories under the pinned target directory; writes the compiler and wrapper selection with its sources, the `[env]` entries and whether each applied, the compiler's inputs in Cargo's child environment, the output triple with the defaults it overrides, the requested Rust flags by precedence, target rules attributed to that triple and the admission, into the build session"];
    fresh [label="fresh\nReplacing the build caches (PW_FRESH_BUILD=1): … …/release …/…/release\n3 refusal(s)\n(fresh mode only)", URL="BUILD.md#one-build-in-time", tooltip="fresh: reads builddir/, controller/target/release/ and controller/target/aarch64-apple-darwin/release/, admitted again with every component below the checkout a real directory of this user, or absent, all before any is removed, and rechecked before each removal; writes removes the three directories through their admitted descriptors; records each one's replacement in the build session; nothing else is removed, including other profiles and other triples", style="rounded,dotted", fillcolor="#fdf2f2"];
    cargo [label="cargo\nBuilding Rust controller + tools\n10 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="cargo: reads cargo on PATH with its configuration, caches and registries; controller/ sources and the output triple passed with --target, the stamp variables, MACOSX_DEPLOYMENT_TARGET, SDKROOT and RUSTFLAGS; the artifact paths and per-target reuse judgments Cargo reports, each a literal boolean bound to the shipped target, a typed non-test profile and the admitted executable, and Cargo's fingerprint for each shipped target; each shipped output's container, architecture names and platform, from its header, lipo -archs and its load commands; writes controller/target/aarch64-apple-darwin/release/ under the pinned output directory for the shipped executables and controller/target/release/ for build scripts and procedural macros, the messages file Cargo reports its artifacts in, and the output check's observations and the judgments into the build session"];
    toolchain [label="toolchain\nChecking the native toolchain (meson, ninja … or newer)\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="toolchain: reads meson and ninja on PATH and ninja's version; writes nothing"];
    configure [label="configure\nConfiguring native build (meson configure, existing directory): …\n9 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="configure: reads whether builddir/build.ninja exists, meson.build, meson.options and the two Meson options; a fresh setup also reads CFLAGS and the other flag variables, and the compilers Meson selected; writes builddir/ configuration; a fresh setup publishes builddir/pw-toolchain.json atomically from the selected compilers, SDK and Rust compiler; meson configure records the two options and the policy assertions run at setup or at the regeneration the next compile triggers"];
    compile [label="compile\nCompiling native executables\n3 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="compile: reads the native sources through builddir/; a changed option triggers regeneration, which runs the policy assertions first; writes builddir/ outputs and the Swift module cache under it"];
    native_check [label="native_check\nChecking the configured native source lists and the identity closure against the tree\n13 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="native_check: reads Meson's introspection of builddir/, Ninja's dependency log, the identity inputs, the stamp and the compilers the directory records, and every shipped output's container, architecture names and load commands; writes builddir/pw-toolchain.json extended with the Swift compiler a reused directory discovered when this build enabled the XPC pieces, atomically and without changing another field; the toolchain, option, Meson machine, output target and SDK observations into the build session"];
    assemble [label="assemble\nAssembling app bundle: …", URL="BUILD.md#one-build-in-time", tooltip="assemble: reads Info.plist, the three Rust outputs, runner/augments/, dist/README.md and dist/AGENTS.md, all admitted before the first check; writes the two documents under DIST_DIR; removes the previous app, ZIP and guide; the stamped Info.plist, the three Rust executables and the augments under the new app"];
    embed_client [label="embed_client\nEmbedding PW runner client", URL="BUILD.md#one-build-in-time", tooltip="embed_client: reads builddir/pw-runner-client; writes Contents/MacOS/pw-runner-client and its dSYM in inspection builds", fillcolor="#e8f0fe"];
    embed_services [label="embed_services\nEmbedding PWRunner XPC services", URL="BUILD.md#one-build-in-time", tooltip="embed_services: reads each service's Info.plist and builddir/ host, the worker, validator and issuer; writes each service bundle: its stamped Info.plist, the host with its dSYM in inspection builds, the worker, validator and issuer", fillcolor="#e8f0fe"];
    skip_xpc [label="skip_xpc\nSkipping embedded XPC build (BUILD_XPC=0)", URL="BUILD.md#one-build-in-time", tooltip="skip_xpc: reads nothing; writes nothing", style="rounded,dashed", fillcolor="white"];
    assembled [label="assembled\nChecking the assembled code against the output target: …\n4 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="assembled: reads every regular file under the assembled app whose header is a Mach-O or fat container, found by header rather than by the names copied in and including the bundle mains, except dSYM companions: its container, lipo -archs names and LC_BUILD_VERSION platform; writes the observations into the build session; nothing in the bundle"];
    presign [label="presign\nChecking host/worker identity again, before signing\n5 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="presign: reads the identity inputs and copies, the generated identity in tests/lib/contract.py and the built worker's --version report; writes nothing"];
    sign_tools [label="sign_tools\nCodesigning embedded MacOS tools\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sign_tools: reads the copied top-level helpers; writes signatures on the top-level helpers"];
    sign_services [label="sign_services\nCodesigning embedded XPC services\n2 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sign_services: reads each service's Entitlements.plist, admitted before the first check, and the assembled bundle; writes signatures on the nested helpers, then each service seal", fillcolor="#e8f0fe"];
    evidence [label="evidence\nWriting evidence manifest and provenance record\n4 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="evidence: reads the signed bytes, entitlements and exported symbols of the helpers, services and augments; the build session; every shipped output's load commands, container, architecture names and signature display; the caller's requests and Cargo's effective deployment target and SDK, from the build session; writes Contents/Resources/Evidence/manifest.json, symbols.json and provenance.json, the manifest listing the other two; the record only after it passes its own validation"];
    seal [label="seal\nCodesigning app bundle\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="seal: reads PolicyWitness.entitlements; writes the app seal over everything under Contents/"];
    verify [label="verify\nVerifying signature + entitlements\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="verify: reads the sealed app; writes nothing"];
    signer [label="signer\nChecking every executable's signer\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="signer: reads every regular file under the app's and each service's Contents/MacOS, and the app and service seals, as codesign displays them; writes nothing"];
    sign_observer [label="sign_observer\nCodesigning observer tool (not embedded)\n6 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="sign_observer: reads controller/target/aarch64-apple-darwin/release/sandbox-log-observer, checked against the output target at this boundary before it is signed; writes that executable's signature, in place, and its observation into the build session"];
    guide [label="guide\nStaging checked user guide\n1 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="guide: reads docs/PolicyWitness.md and its inputs; writes PolicyWitness.md under DIST_DIR"];
    zip [label="zip\nCreating zip (for notarization): …\n4 refusal(s)", URL="BUILD.md#one-build-in-time", tooltip="zip: reads the sealed app, every Mach-O in it checked against the output target again before the ZIP is written; writes PolicyWitness.zip under DIST_DIR"];
    make_build -> admission;
    admission -> lock;
    lock -> check_limits;
    check_limits -> check_contract;
    check_contract -> check_build_doc;
    check_build_doc -> check_identity;
    check_identity -> stamp;
    stamp -> minimum;
    minimum -> sdk;
    sdk -> builddir;
    builddir -> identity;
    identity -> cargo_admit;
    cargo_admit -> fresh [style=dotted];
    fresh -> cargo [style=dotted];
    cargo_admit -> cargo;
    cargo -> toolchain;
    toolchain -> configure;
    configure -> compile;
    compile -> native_check;
    native_check -> assemble;
    assemble -> embed_client [color="#1f5fbf"];
    embed_client -> embed_services [color="#1f5fbf"];
    assemble -> skip_xpc [style=dashed];
    embed_services -> assembled [color="#1f5fbf"];
    skip_xpc -> assembled [style=dashed];
    assembled -> presign;
    presign -> sign_tools;
    sign_tools -> sign_services [color="#1f5fbf"];
    sign_services -> evidence [color="#1f5fbf"];
    sign_tools -> evidence [style=dashed];
    evidence -> seal;
    seal -> verify;
    verify -> signer;
    signer -> sign_observer;
    sign_observer -> guide;
    guide -> zip;
}
