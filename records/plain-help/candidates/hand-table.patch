+
+enumerated!(
+    /// The kind a runner record or selection carries.
+    Kind {
+        Standard,
+        Byoxpc,
+    }
+);
+
+enumerated!(
+    /// A site that reads a kind from text.
+    Reader {
+        /// `run --runner-mode <word>`.
+        RunOption,
+        /// The request's `runner.mode`.
+        RequestSelector,
+        /// `runner install --kind <word>`.
+        InstallOption,
+        /// A stored registry record's `kind`.
+        Registry,
+    }
+);
+
+enumerated!(
+    /// A spelling some reader recognizes.
+    Word {
+        Standard,
+        Byoxpc,
+        Machme,
+        Debuggable,
+    }
+);
+
+/// What a reader does with a word.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Rule {
+    /// The word is accepted as its kind.
+    Admits,
+    /// The word is recognized so that it can be refused.
+    RefusesAlways,
+    /// The reader resolves the word to its kind.
+    Alias,
+}
+
+impl Word {
+    pub const fn spelling(self) -> &'static str {
+        match self {
+            Word::Standard => "standard",
+            Word::Byoxpc => "byoxpc",
+            Word::Machme => "machme",
+            Word::Debuggable => "debuggable",
+        }
+    }
+
+    /// The kind the word names or resolves to; a refusal names it as the
+    /// kind to use.
+    pub const fn kind(self) -> Kind {
+        match self {
+            Word::Standard => Kind::Standard,
+            Word::Byoxpc | Word::Machme | Word::Debuggable => Kind::Byoxpc,
+        }
+    }
+
+    /// `None` where the reader does not recognize the word.
+    pub const fn rule(self, reader: Reader) -> Option<Rule> {
+        match (self, reader) {
+            (Word::Standard | Word::Byoxpc, _) => Some(Rule::Admits),
+            (Word::Machme | Word::Debuggable, Reader::Registry) => Some(Rule::Alias),
+            (Word::Machme, _) => Some(Rule::RefusesAlways),
+            (Word::Debuggable, _) => None,
+        }
+    }
+}
+
+impl Kind {
+    /// The word that names the kind wherever it is written.
+    pub const fn word(self) -> Word {
+        match self {
+            Kind::Standard => Word::Standard,
+            Kind::Byoxpc => Word::Byoxpc,
+        }
+    }
+
+    pub const fn as_str(self) -> &'static str {
+        self.word().spelling()
+    }
+}
+
+/// A reader's answer for one value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Resolved {
+    Kind(Kind),
+    /// Recognized and refused; the word's kind is the one to use.
+    Refused(Word),
+    Unknown,
+}
+
+impl Reader {
+    pub fn resolve(self, value: &str) -> Resolved {
+        let Some(word) = Word::ALL
+            .iter()
+            .copied()
+            .find(|word| word.spelling() == value)
+        else {
+            return Resolved::Unknown;
+        };
+        match word.rule(self) {
+            Some(Rule::Admits | Rule::Alias) => Resolved::Kind(word.kind()),
+            Some(Rule::RefusesAlways) => Resolved::Refused(word),
+            None => Resolved::Unknown,
+        }
+    }
+}
