digraph footprint_response {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="Response collection", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    fr1 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Controller: complete raw stdout/stderr\nDrops before final rendering\nfr1", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr1: Controller: complete raw stdout/stderr\nDrops before final rendering | controller; child pipes opened → run_client_stdin returns; raw Output drops on caller return Collects complete stdout/stderr before making retained prefixes. Raw Output remains borrowed through capture and host parsing, then drops before final rendering."];
    fr2 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Host: collected publication copies\nMappings detach before encoding\nfr2", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr2: Host: collected publication copies\nMappings detach before encoding | host; output collection → last reply-model use; source mappings end earlier; source mappings detach before later encoding Copies published slots/profile/phase values while source mappings still exist; session teardown precedes later reply assembly. Actor reply metadata survives authority teardown."];
    fr3 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Host: validator raw / parsed records\nRaw scope ends; records retained\nfr3", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr3: Host: validator raw / parsed records\nRaw scope ends; records retained | host; validator output drain → raw Data last use; decoded records retained separately; validator receive scope ends Raw bounded validator output and decoded records coexist during decoding; returned records/counts outlive the temporary raw Data."];
    fr4 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Host model → encoded Data → XPC\nFramework copy count unknown\nfr4", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr4: Host model → encoded Data → XPC\nFramework copy count unknown | host / client; reply assembly → callback and representation last use; host/client representation disposal is not externally observed Reply model overlaps encoded host Data; XPC and Foundation physical copy/backing behavior is unestablished. The synthesized maximum bounds encoded reply size, not live memory."];
    fr5 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Client: host Data → base64 capture\nCapture → encoded stdout → exit\nfr5", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr5: Client: host Data → base64 capture\nCapture → encoded stdout → exit | client; reply capture → client emit and exit; client representation lifetime ends with exit Incoming host Data, retained prefix and base64 text overlap during capture. Capture and encoded capture bytes coexist during emit; stdout adds a newline. Prefix backing identity is unestablished."];
    fr6 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Controller: generic + typed capture\nTyped scope ends before rendering\nfr6", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr6: Controller: generic + typed capture\nTyped scope ends before rendering | controller; capture parsing → typed capture scope ends; generic capture survives into assembly; typed capture disposal before final rendering Retained text is made before parsing. Generic capture JSON survives a clone into typed Capture; generic and typed base64 coexist during validation. Lossy text length need not equal retained source-byte count."];
    fr7 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Controller: decoded bytes + host Value\nDecoded bytes drop; host Value survives\nfr7", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr7: Controller: decoded bytes + host Value\nDecoded bytes drop; host Value survives | controller; base64 decoding → decoded vector scope ends; parsed reply retained; decoded bytes drop before envelope rendering Strict base64 decode allocates host bytes. Raw client Output, generic capture, typed base64 and decoded bytes coexist; parsed host Value is added before decoded bytes leave scope."];
    fr8 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Controller: envelope + pretty String\nLast use / CLI exit\nfr8", URL="ARCHITECTURE.md#response-collection-nodes", tooltip="fr8: Controller: envelope + pretty String\nLast use / CLI exit | controller; envelope construction → print returns and CLI exits; Value/String disposal after last use Borrowed input and envelope coexist. Recursive sorting clones subtrees; pretty serialization adds a String while the Value remains live. Sort temporaries are not claimed to survive the sort."];
    fr3 -> fr2 [style="dotted", color="#444444", label="F201 decoded query records", URL="ARCHITECTURE.md#response-collection-edges", tooltip="F201: decoded query records |  "];
    fr2 -> fr4 [style="dotted", color="#444444", label="F202 after session teardown", URL="ARCHITECTURE.md#response-collection-edges", tooltip="F202: after session teardown |  "];
    fr4 -> fr5 [style="dashed", color="#2f5597", label="F203 encoded host bytes", URL="ARCHITECTURE.md#response-collection-edges", tooltip="F203: encoded host bytes |  "];
    fr5 -> fr1 [style="dashed", color="#2f5597", label="F204 client stdout", URL="ARCHITECTURE.md#response-collection-edges", tooltip="F204: client stdout |  "];
    fr1 -> fr6 [style="dotted", color="#444444", label="F205 parse; raw still borrowed", URL="ARCHITECTURE.md#response-collection-edges", tooltip="F205: parse; raw still borrowed |  "];
    fr6 -> fr7 [style="dotted", color="#444444", label="F206 base64 decode / host parse", URL="ARCHITECTURE.md#response-collection-edges", tooltip="F206: base64 decode / host parse |  "];
    fr7 -> fr8 [style="dotted", color="#444444", label="F207 raw / typed / decoded dropped", URL="ARCHITECTURE.md#response-collection-edges", tooltip="F207: raw / typed / decoded dropped |  "];
}
