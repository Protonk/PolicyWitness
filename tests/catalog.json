    "dispatcher": {
      "command": [
        "bash",
        "tests/suites/dispatcher/run.sh"
      ],
      "requires": [],
      "cases": [
        {
          "id": "controls",
          "description": "requested suite exits, case reports, and lifecycle evidence determine one result"
        },
        {
          "id": "accounting_controls",
          "description": "Every selection retains its own accounting; incomplete or ambiguous results cannot report success"
        },
        {
          "id": "cancellation_controls",
          "description": "Interrupting ordinary cases stops their process tree, preserves evidence, and accounts for queued work"
        },
        {
          "id": "selection_controls",
          "description": "Public selectors, inspection, configuration, and completion agree with independent execution receipts"
        },
        {
          "id": "artifact_controls",
