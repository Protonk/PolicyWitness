digraph topology {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="Process topology", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_app {
        label="app top level"; style=dashed; color="#888888"; fontsize=10;
        controller;
        client;
        sbpl_check;
    }
    subgraph cluster_xpc {
        label="inside the XPC bundle"; style=dashed; color="#888888"; fontsize=10;
        host;
        worker;
        validator;
        issuer;
    }
    subgraph cluster_os {
        label="macOS"; style=dashed; color="#888888"; fontsize=10;
        launchd;
    }
    user [shape="plaintext", label="the caller\nuser", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="user: the caller | a shell or a harness; owns the request file and reads the envelope "];
    controller [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="policy-witness\ncontroller", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="controller: policy-witness | Rust; app top level; the caller; no; none; one run "];
    client [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-runner-client\nclient", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="client: pw-runner-client | Swift; app top level; the controller; no; none; one helper per request; effect-free reservation attempts and the single execution invocation share one absolute deadline "];
    host [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="PWRunner\nhost", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="host: PWRunner | Swift; inside the XPC bundle; launchd: XPC service lookup, or a Mach service for BYOXPC; no; none, by the invariance rule; one reservation and at most one specimen; unused reservation expiry or abandonment retires the host All authorized connections share one locked reservation slot. Only the connection holding its grant can consume it, before specimen decoding. Stale expiry or disconnect cannot retire an executing owner; client loss after submission never permits replay."];
    worker [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="pw-probe-runner\nworker", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="worker: pw-probe-runner | C; inside the XPC bundle; the host; yes; applies the specimen policy to itself; sandbox_compile_string, params, sandbox_apply; sandbox_extension_consume and sandbox_extension_release; one specimen; one application and all ordered phases; terminal publication exits without host permission "];
    exec_child [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="exec helper children\nexec_child", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="exec_child: exec helper children | caller-supplied; the caller's path; the worker; inherit the worker's sandbox; none of PolicyWitness's; the worker bounds collection and leader reap; ordinary completion and worker death can leave same-group descendants alive; escaped descendants are not contained "];
    validator [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sb_api_validator\nvalidator", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="validator: sb_api_validator | C; inside the XPC bundle; the host at each eligible phase arrival; no; sandbox_check; one phase collection "];
    sbpl_check [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sbpl-check\nsbpl_check", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="sbpl_check: sbpl-check | Rust; app top level; the controller, only for an admitted client terminal xpc_error; no; sandbox_compile_string and params; never applies; one compile "];
    launchd [shape="ellipse", style="dashed", color="#666666", label="launchd\nlaunchd", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="launchd: launchd | OS; system; no; none "];
    issuer [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-extension-issuer\nissuer", URL="ARCHITECTURE.md#process-topology-nodes", tooltip="issuer: pw-extension-issuer | inside the XPC bundle; one declaration before worker creation; confirmed clean reap required for delivery; C; the host; outside the specimen policy; ordinary process authority; sandbox_extension_issue_file "];
    user -> controller [style="dashed", color="#2f5597", label="T1 argv in, envelope out", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T1: argv in; one JSON envelope on stdout |  "];
    controller -> client [style="bold", color="#222222", label="T2 spawn; stdin, stdout", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T2: spawn once; held request on stdin, read to EOF; versioned client capture on stdout |  "];
    client -> host [style="dashed", color="#2f5597", label="T3 NSXPC reservation and submission", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T3: effect-free NSXPC reservation, then one runReservedSpecimen call and its reply |  "];
    launchd -> host [style="bold", color="#666666", arrowhead="vee", label="T4 launch", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T4: start on XPC lookup, or as a Mach service (BYOXPC) |  "];
    host -> worker [style="bold", color="#222222", label="T5 posix_spawn; fds 0, 3, 4; optional 5", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T5: posix_spawn; fd 0 policy pipe, fd 3 shared region, fd 4 ready pipe; optional fd 5 transient token channel |  Policy delivery uses nonblocking writes under one absolute monotonic deadline (the worker_policy_transfer limit) beginning after spawn. Expiry closes input and enters cleanup before readiness or sentinel polling. The pipe carries no framing: the host writes the submission's byte count into the shared header before spawn, and the worker at EOF publishes the count it read and refuses a different length before compiling."];
    host -> validator [style="bold", color="#222222", label="T6 fresh collection per phase", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T6: fresh posix_spawn --batch <pid> per eligible phase; bundle-local default or explicit override; bounded NDJSON |  "];
    validator -> worker [style="dotted", color="#9a5b00", label="T7 sandbox_check(pid)", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T7: sandbox_check against the worker PID, with SANDBOX_CHECK_NO_REPORT |  "];
    worker -> host [style="dashed", color="#2f5597", label="T8 shared-region evidence", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T8: immutable phase arrivals, acknowledgements and completions; numbered releases before actions; separate native call markers/results and fresh-read syscall observations |  "];
    worker -> exec_child [style="bold", color="#222222", label="T9 posix_spawn after apply", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T9: posix_spawn after apply; stdout and stderr pipes into bounded slot buffers |  "];
    controller -> sbpl_check [style="bold", color="#222222", label="T12 spawn on xpc_error only", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T12: spawn only for an admitted client terminal xpc_error; held request in; helper envelope out |  "];
    host -> issuer [style="bold", color="#222222", label="T13 spawn issuer; fd 3", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T13: fresh ordinary-authority issuer; fd 3 token mapping, stdio /dev/null, empty environment |  Issuer wait 5,000 milliseconds; cleanup may overrun. Missing capability refuses extension specimens."];
    issuer -> host [style="dashed", color="#2f5597", label="T14 transient token and publication", URL="ARCHITECTURE.md#process-topology-edges", tooltip="T14: native issuance publication and bounded transient token bytes; host owns cleanup and delivery eligibility |  Token storage 16,384 bytes; raw bytes never enter reply fields."];
}
