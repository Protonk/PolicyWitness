digraph byoxpc {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="The BYOXPC apparatus", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_installation {
        label="installation"; style=dashed; color="#888888"; fontsize=10;
        bundle_copy;
        entitlements_plist;
        install;
        signing;
        plist;
        registry;
    }
    subgraph cluster_launch {
        label="launch and connection"; style=dashed; color="#888888"; fontsize=10;
        launchd;
        host;
        client;
        caller_auth;
    }
    subgraph cluster_selection {
        label="selection and provenance"; style=dashed; color="#888888"; fontsize=10;
        selector;
        provenance;
    }
    subgraph cluster_reached {
        label="the processes the policy reaches"; style=dashed; color="#888888"; fontsize=10;
        worker;
        validator;
    }
    subgraph cluster_maintenance {
        label="maintenance"; style=dashed; color="#888888"; fontsize=10;
        verify;
        validate;
        remove;
        reconcile;
    }
    user [shape="plaintext", label="the installer\nuser", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="user: the installer"];
    bundle_copy [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="copied XPC bundle\nbundle_copy", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="bundle_copy: copied XPC bundle"];
    entitlements_plist [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="the installer's entitlements plist\nentitlements_plist", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="entitlements_plist: the installer's entitlements plist"];
    install [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner install\ninstall", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="install: runner install"];
    signing [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="codesign of the bundle\nsigning", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="signing: codesign of the bundle"];
    plist [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="LaunchAgent or LaunchDaemon plist\nplist", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="plist: LaunchAgent or LaunchDaemon plist"];
    registry [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="runner registry\nregistry", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="registry: runner registry"];
    launchd [shape="ellipse", style="dashed", color="#666666", label="launchd\nlaunchd", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="launchd: launchd"];
    host [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="PWRunner as a Mach service\nhost", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="host: PWRunner as a Mach service"];
    client [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="pw-runner-client --mach-service\nclient", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="client: pw-runner-client --mach-service"];
    caller_auth [shape="octagon", style="dashed", color="#8e24aa", label="caller authorization\ncaller_auth", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="caller_auth: caller authorization"];
    selector [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="request runner selector\nselector", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="selector: request runner selector"];
    provenance [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="runner provenance and binary baselines\nprovenance", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="provenance: runner provenance and binary baselines"];
    worker [shape="box", style="rounded,filled", fillcolor="#ffe2b8", color="#9a5b00", label="pw-probe-runner in the copy\nworker", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="worker: pw-probe-runner in the copy"];
    validator [shape="box", style="rounded,filled", fillcolor="#f2f2f2", color="#444444", label="sb_api_validator in the copy\nvalidator", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="validator: sb_api_validator in the copy"];
    verify [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner verify\nverify", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="verify: runner verify"];
    validate [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner validate\nvalidate", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="validate: runner validate"];
    remove [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner remove\nremove", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="remove: runner remove"];
    reconcile [shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#2e7d32", label="runner reconcile\nreconcile", URL="ARCHITECTURE.md#the-byoxpc-apparatus-nodes", tooltip="reconcile: runner reconcile"];
    user -> bundle_copy [style="dotted", color="#444444", label="X1 copy", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X1: copies the shipped PWRunner.xpc"];
    user -> install [style="dashed", color="#2f5597", label="X2 argv", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X2: runner install with --bundle, --identity, --entitlements, --scope and optional --env"];
    entitlements_plist -> signing [style="solid", color="#8a7400", label="X3 entitlements", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X3: supplied entitlements"];
    install -> signing [style="bold", color="#222222", label="X4 codesign", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X4: codesign --force --options runtime -s identity --entitlements plist bundle"];
    signing -> host [style="bold", color="#2e7d32", label="X5 signs the host", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X5: the host executable carries the identity and entitlements; read back by entitlements_from_codesign"];
    bundle_copy -> worker [style="dotted", color="#444444", label="X6 build signature", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X6: the worker arrives with the build's signature and is not re-signed"];
    bundle_copy -> validator [style="dotted", color="#444444", label="X7 build signature", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X7: the validator arrives with the build's signature and is not re-signed"];
    install -> plist [style="bold", color="#2e7d32", label="X8 plist", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X8: build_launchd_plist and write_launchd_plist"];
    plist -> launchd [style="bold", color="#666666", arrowhead="vee", label="X9 bootstrap", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X9: launchctl bootstrap into the gui or system domain"];
    launchd -> host [style="bold", color="#666666", arrowhead="vee", label="X10 start on demand", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X10: start on demand for the Mach service; default respawn throttle between launches"];
    install -> registry [style="bold", color="#2e7d32", label="X11 record", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X11: install_record: pending before the plist, installed after the bootstrap"];
    user -> selector [style="dashed", color="#2f5597", label="X12 runner field", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X12: the specimen's runner field: mode, id or service, required_entitlements"];
    selector -> registry [style="solid", color="#8a7400", label="X13 resolve", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X13: resolve by id or service; required entitlements must be a subset of the recorded host entitlements"];
    registry -> provenance [style="solid", color="#8a7400", label="X14 provenance", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X14: runner_provenance_from_target copies kind, service, id and the host's entitlements"];
    bundle_copy -> provenance [style="solid", color="#8a7400", label="X15 hashes before invocation", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X15: Binaries::observe hashes the service, worker and validator files before invocation"];
    client -> caller_auth [style="dashed", color="#2f5597", label="X16 connect", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X16: NSXPCConnection(machServiceName:), privileged for system scope"];
    caller_auth -> host [style="solid", color="#2f5597", label="X17 Team ID equal", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X17: shouldAcceptNewConnection: the caller's Team ID equals the host's, and the identifier allowlist if present"];
    host -> worker [style="bold", color="#222222", label="X18 spawn", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X18: posix_spawn of the copy's own worker"];
    host -> validator [style="bold", color="#222222", label="X19 spawn", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X19: posix_spawn of the copy's own validator"];
    verify -> client [style="dashed", color="#2f5597", label="X20 allow-all request", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X20: a fixed allow-all request on the client's stdin"];
    validate -> registry [style="dashed", color="#8e24aa", label="X21 re-read", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X21: re-reads signature and entitlements from the recorded path"];
    remove -> launchd [style="bold", color="#666666", arrowhead="vee", label="X22 bootout", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X22: bootout, then re-read for up to one second of teardown"];
    remove -> registry [style="bold", color="#2e7d32", label="X23 retire", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X23: pending_cleanup first; retired only after verified absence of service and plist"];
    reconcile -> launchd [style="dashed", color="#8e24aa", label="X24 inspect", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X24: inspect_service lists candidate services without changes"];
    reconcile -> plist [style="dashed", color="#8e24aa", label="X25 inspect", URL="ARCHITECTURE.md#the-byoxpc-apparatus-edges", tooltip="X25: inspect_plist lists candidate plists without changes"];
}
