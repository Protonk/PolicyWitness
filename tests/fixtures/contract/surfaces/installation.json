  "reservation_limits": {
    "client_rpc_wait": {
      "control": "Flag `--timeout-ms`, floored at 1 ms; values above this default are permitted.",
      "counting": "One absolute client allowance, including helper launch/stdin delivery, reservation acquisition and the execution reply wait. Direct helper invocation starts after reading input.",
      "effect": "Overall expiry reports xpc_timeout with the captured submission state. Acquisition may stop earlier at its attempt bound. Expiry after invocation does not establish nonexecution or cancel host work; worker/validator budgets remain separate.",
      "unit": "milliseconds",
      "value": 240000
    },
    "reservation_attempts": {
      "control": "Fixed.",
