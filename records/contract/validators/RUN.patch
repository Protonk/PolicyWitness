+# TEMPORARY EXPERIMENT (r14). Not a catalog case.
+# Reads the replies and Rust judgments the Rust experiment wrote, asks the
+# independent consumer for its judgment on the same JSON, and writes
+# readers.json with all three judgments per reply.
+#   tests/lib/python.sh tests/suites/runner_unit/r14_experiment.py DIR
+import json
+import os
+import sys
+import traceback
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'lib'))
+import consumer  # noqa: E402
+
+CONTRACT = 'test:policy-witness'  # the contract actor_driver_replies_cross_readers passes
+
+
+def main(directory):
+    with open(os.path.join(directory, 'rust.json'), encoding='utf-8') as handle:
+        document = json.load(handle)
+    out = []
+    for row in document['replies']:
+        entry = {key: row.get(key) for key in ('id', 'base', 'change', 'origin', 's', 'r', 'porcelain', 'json_presence')}
+        if 'reply' in row:
+            try:
+                errors = consumer.validate_fixture(row['reply'], expected_contract=CONTRACT)
+                entry['p'] = {'raised': False, 'errors': errors}
+            except Exception:  # the judgment is the observation; keep what was raised
+                entry['p'] = {'raised': True, 'errors': [traceback.format_exc()]}
+        else:
+            entry['p'] = None
+        out.append(entry)
+    with open(os.path.join(directory, 'readers.json'), 'w', encoding='utf-8') as handle:
+        json.dump({'notes': document.get('notes'), 'contract': CONTRACT, 'replies': out}, handle, indent=1, sort_keys=True)
+    print(f'r14 experiment: {len(out)} replies judged by the consumer')
+
+
+if __name__ == '__main__':
+    main(sys.argv[1])
