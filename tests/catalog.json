{
  "schema_version": 1,
  "suites": {
    "preflight": {
      "command": [
        "bash",
        "tests/suites/preflight/run.sh"
      ],
      "requires": [
        "app"
      ],
      "cases": [
        {
          "id": "codesign.preflight",
          "description": "Require complete bundle layout, valid signatures, and matching embedded evidence hashes"
        },
        {
          "id": "signed_artifact_controls",
          "description": "Real codesign accepts the intact copy and rejects damaged or validly re-signed stale evidence",
          "default": false,
          "requires": [
            "app",
            "identity"
          ]
        },
        {
          "id": "release_controls",
          "requires": [],
          "description": "Uncertain Apple replies stop continuation; archive checks use the extracted app and preserve inputs"
        },
        {
          "id": "release_deadline_controls",
          "requires": [],
          "description": "Real hung release commands stop within their deadline, preserve output, and leave no live child or retry"
        }
      ]
    },
    "source_drift": {
      "command": [
        "bash",
        "tests/suites/source_drift/run.sh"
      ],
      "requires": [],
      "cases": [
        {
          "id": "runner_source_manifests_agree",
          "description": "Runner sources, test registry, shared outcome vocabularies and the CLI usage/README surface agree"
        },
        {
          "id": "limits_documentation",
          "description": "Limits inventory and copied guide agree; standalone, staging, stale-input and link controls pass"
        },
        {
          "id": "contract_versions",
          "description": "Contract version manifest and every generated copy agree; generator, stale-copy and build-refusal controls pass"
        }
      ]
    },
    "shell_helpers": {
      "command": [
        "bash",
        "tests/suites/shell_helpers/run.sh"
      ],
      "requires": [],
      "cases": [
        {
          "id": "controls",
          "description": "shell helpers retain diagnostics and case identity; failures prevent later stages"
        },
        {
          "id": "finalizers",
          "description": "result helpers preserve terminal evidence, literal data, logging, and exit behavior"
        },
        {
          "id": "python_startup",
          "description": "optimized Python is rejected; normal assertion failures remain test failures"
        },
        {
          "id": "script_groups",
          "description": "wrappers preserve child order, streams, phase boundaries, and failing status"
        },
        {
          "id": "worker_setup",
          "description": "worker cases share setup; equipment failures stop before assertions and preserve evidence"
        },
        {
          "id": "byoxpc_setup",
          "description": "BYOXPC staging preserves the source, owns partial installation, and verifies cleanup"
        },
        {
          "id": "mutation_prerequisites",
          "description": "The required barrier mutation wrapper fails without a signing identity before any builder executes"
        }
      ]
    },
    "dispatcher": {
      "command": [
        "bash",
        "tests/suites/dispatcher/run.sh"
      ],
      "requires": [],
      "cases": [
        {
          "id": "controls",
          "description": "requested suite exits, case reports, and lifecycle evidence determine one result"
        },
        {
          "id": "accounting_controls",
          "description": "Every selection retains its own accounting; incomplete or ambiguous results cannot report success"
        },
        {
          "id": "cancellation_controls",
          "description": "Interrupting ordinary cases stops their process tree, preserves evidence, and accounts for queued work"
        },
        {
          "id": "selection_controls",
          "description": "Public selectors, inspection, configuration, and completion agree with independent execution receipts"
        },
        {
          "id": "artifact_controls",
          "description": "Reject invalid artifacts before app-dependent cases and detect mutation after passing or failing tests"
        },
        {
          "id": "retention_controls",
          "description": "Retained inventories, managed run ownership and checkout serialization protect execution evidence"
        }
      ]
    },
    "unit": {
      "command": [
        "bash",
        "tests/suites/unit/run.sh"
