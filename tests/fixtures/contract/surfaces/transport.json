  "reservation_limits": {
    "client_rpc_wait": {
      "control": "Flag `--timeout-ms`, floored at 1 ms; values above this default are permitted.",
      "counting": "One absolute client allowance, including helper launch/stdin delivery, reservation acquisition and the execution reply wait. Direct helper invocation starts after reading input.",
      "effect": "Overall expiry reports xpc_timeout with the captured submission state. Acquisition may stop earlier at its attempt bound. Expiry after invocation does not establish nonexecution or cancel host work; worker/validator budgets remain separate.",
      "unit": "milliseconds",
      "value": 240000
    },
    "reservation_attempts": {
      "control": "Fixed.",
      "counting": "Every opened acquisition attempt, including transport failures and occupied replies.",
      "effect": "Exhaustion ends acquisition explicitly at attempt_limit with no submission; it can precede the overall timeout. Every attempted acquisition stays in the capture.",
      "unit": "items",
      "value": 256
    },
    "reservation_lease": {
      "control": "Fixed. No renewal.",
      "counting": "Requested unused lease, capped by the host; the client requests no more than its remaining allowance.",
      "effect": "Expiry or owner disconnect retires the unused host. Submission checks expiry atomically and an old timer cannot terminate execution.",
      "unit": "milliseconds",
      "value": 5000
    },
    "reservation_retry_delay": {
      "control": "Fixed minimum.",
      "counting": "Minimum delay between a failed/occupied attempt and another connection, within the remaining allowance.",
      "effect": "No delay after a successful grant. Scheduling may take longer; neither waiting nor progress renews the deadline.",
      "unit": "milliseconds",
      "value": 100
    },
    "reservation_rpc_wait": {
      "control": "Fixed per-attempt ceiling.",
      "counting": "Maximum wait for one reserve reply, also bounded by the original overall client deadline.",
      "effect": "Expiry abandons and invalidates that connection; acquisition may continue without submitting a specimen.",
      "unit": "milliseconds",
      "value": 5000
    }
  }
