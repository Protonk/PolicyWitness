# Distribution documentation is tracked; generated output stays local.
/dist/*
!/dist/README.md
!/dist/AGENTS.md

# da mac
.DS_Store

# controller (Rust)
controller/target
/controller/tools/pw_probe_runner/pw-probe-runner
/controller/tools/sb_api_validator/sb_api_validator

# Local scratch is disposable; keep its contributor policy.
/.tmp/*
!/.tmp/AGENTS.md

# tests artifacts
tests/out/
tests/**/__pycache__/

# Stable checkout advisory lock; never remove while held.
/tests/.checkout.lock
