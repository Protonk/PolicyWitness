digraph footprint_waiting {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="Waiting ownership", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    fw1 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Active worker: polls release\nEnds: release / expiry / cancellation\nfw1", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw1: Active worker: polls release\nEnds: release / expiry / cancellation | active worker; phase arrival → release accepted, expiry sampled or cancellation observed; release, expiry or cancellation Continuously samples release/cancellation and expiry, with batches of yield hints. Requested-action quiescence is not CPU idleness."];
    fw2 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Parked actor: polls activation\nEnds: activation / expiry / exit request\nfw2", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw2: Parked actor: polls activation\nEnds: activation / expiry / exit request | parked worker; setup or previous visit completion → named activation, cutoff or exit request; activation, expiry or cancellation Polls its activation word and can service inbound authority while parked."];
    fw3 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Host collections / validator\nEnds: collection / validator exit\nfw3", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw3: Host collections / validator\nEnds: collection / validator exit | host / validator; worker readiness or arrival → collection ends; validator ends independently; collection completion and validator exit Host polls/sleeps while collecting; an eligible phase launches a separate validator. Their demand is separate from worker polling."];
    fw4 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Host evidence view\nUnmap attempted at host teardown\nfw4", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw4: Host evidence view\nUnmap attempted at host teardown | host; mapping preparation → host session teardown; host view unmapping attempted One fixed evidence backing per worker, initialized before spawn; host and worker mappings are views of the same object."];
    fw5 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Worker evidence view\nSame backing; ends: worker exit\nfw5", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw5: Worker evidence view\nSame backing; ends: worker exit | worker; worker maps launch descriptor → worker process exit; worker exit ends its references Aliases the evidence backing; do not add its logical capacity to the host view as a second backing object."];
    fw6 [shape="box", style="rounded,filled", fillcolor="#fff0cd", color="#555555", label="Actor authority views\nErase / unmap / exit separately\nfw6", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw6: Actor authority views\nErase / unmap / exit separately | host / actor workers; authority setup before launch → host detachment and worker exit, independently; shared erase eligibility, host unmap and worker exit are separate Per actor: 1152 + (inbound slots + outbound slots) × 16448 logical bytes, including actors with no slots. Bearer bytes are outside the encoded reply."];
    fw7 [shape="box", style="rounded,filled", fillcolor="#fff0cd", color="#555555", label="Host private custody\nErase retains allocation; finish disposes\nfw7", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw7: Host private custody\nErase retains allocation; finish disposes | host; custody preparation → custody finish; final erase and private buffer disposal One fixed private buffer per admitted token. Last-use erasure resets payload state but retains its allocation."];
    fw8 [shape="box", style="rounded,filled", fillcolor="#fff0cd", color="#555555", label="Worker candidates / fixed table\nNative release differs from table disposal\nfw8", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw8: Worker candidates / fixed table\nNative release differs from table disposal | actor worker; worker static storage → worker exit; native release and table disposal are separate Fixed handle table storage remains after native release. Candidate count and native result do not measure private kernel storage."];
    fw9 [shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#555555", label="Host launch descriptors\nClose after spawn; mappings survive\nfw9", URL="ARCHITECTURE.md#waiting-ownership-nodes", tooltip="fw9: Host launch descriptors\nClose after spawn; mappings survive | host; host setup → spawn or setup failure closes each descriptor; descriptor close, not mapping disposal Evidence/authority launch descriptors close after spawn; policy/ready pipes have their own close boundaries. Mapping references survive descriptor close."];
    fw3 -> fw1 [style="bold", color="#2e7d32", label="F101 release after collection", URL="ARCHITECTURE.md#waiting-ownership-edges", tooltip="F101: release after collection |  "];
    fw3 -> fw2 [style="bold", color="#2e7d32", label="F102 named activation", URL="ARCHITECTURE.md#waiting-ownership-edges", tooltip="F102: named activation |  "];
    fw4 -> fw5 [style="dashed", color="#2f5597", label="F103 views of same backing", URL="ARCHITECTURE.md#waiting-ownership-edges", tooltip="F103: views of same backing |  "];
    fw9 -> fw4 [color="#2f5597", style="solid", label="F104 close does not unmap", URL="ARCHITECTURE.md#waiting-ownership-edges", tooltip="F104: close does not unmap |  "];
    fw7 -> fw6 [style="dotted", color="#444444", label="F105 custody to delivery", URL="ARCHITECTURE.md#waiting-ownership-edges", tooltip="F105: custody to delivery |  "];
    fw6 -> fw8 [color="#986600", style="bold", label="F106 consume candidate", URL="ARCHITECTURE.md#waiting-ownership-edges", tooltip="F106: consume candidate |  "];
    fw2 -> fw6 [style="solid", color="#8a7400", label="F107 parked inbound service", URL="ARCHITECTURE.md#waiting-ownership-edges", tooltip="F107: parked inbound service |  "];
}
