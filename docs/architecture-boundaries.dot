digraph boundaries {
    graph [rankdir=TB, bgcolor="white", fontname="Helvetica", fontsize=11, label="Boundaries and their guards", labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.6];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_controller_side {
        label="controller"; style=dashed; color="#888888"; fontsize=10;
        held_request;
        envelope;
        helper_envelope;
    }
    subgraph cluster_host_side {
        label="host"; style=dashed; color="#888888"; fontsize=10;
        run_spec;
        shm_region;
        validator_wire;
        reply;
        profile_capture;
        equipment;
        authority_setup;
    }
    subgraph cluster_installed {
        label="built and installed"; style=dashed; color="#888888"; fontsize=10;
        evidence_manifest;
        runner_registry;
    }
    subgraph cluster_client_side {
        label="client"; style=dashed; color="#888888"; fontsize=10;
        client_capture;
    }
    request_file [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="request JSON\nrequest_file", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="request_file: request JSON | the caller; a JSON file naming the request schema "];
    held_request [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="held request bytes\nheld_request", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="held_request: held request bytes | the controller; one serialization; selectors stripped, augments spliced "];
    run_spec [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="decoded request (PWRunnerRunSpec)\nrun_spec", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="run_spec: decoded request (PWRunnerRunSpec) | the host; Codable with closed keys "];
    shm_region [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="shared region and policy pipe (worker ABI)\nshm_region", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="shm_region: shared region and policy pipe (worker ABI) | host writes inputs, worker writes outputs; fixed layout; magic at byte 0, source identity at byte 64 "];
    validator_wire [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="validator NDJSON (probes and verdicts)\nvalidator_wire", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="validator_wire: validator NDJSON (probes and verdicts) | host and validator, co-shipped in one bundle; bounded NDJSON; exact kind sb_api_validator_verdict and schema_version 1 "];
    reply [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="runner reply (PWRunnerRunResult)\nreply", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="reply: runner reply (PWRunnerRunResult) | the host; schema-owned Swift fields; typed reporting admission; bounded binary frame with schema fingerprint "];
    profile_capture [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="compiled-object receipt (compiled_profile)\nprofile_capture", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="profile_capture: compiled-object receipt (compiled_profile) | the opted-in worker before apply; admitted by the host for that worker or apply actor; opt-in copy of the compiled object with a nonce; CompiledProfileCapture names the worker producer and before_apply stage under its own schema_version "];
    envelope [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="controller envelope (kind run)\nenvelope", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="envelope: controller envelope (kind run) | the controller; public JSON envelope rendered from borrowed typed capture, reply and diagnostic records before stdout "];
    helper_envelope [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="sbpl-check envelope (nested)\nhelper_envelope", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="helper_envelope: sbpl-check envelope (nested) | sbpl-check; envelope frame; kind sbpl_check; independently compiled diagnostic associated with the selected policy, not application evidence "];
    evidence_manifest [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="evidence manifest (in the app)\nevidence_manifest", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="evidence_manifest: evidence manifest (in the app) | the build; hashes and entitlements of every shipped binary; its own schema_version (EVIDENCE_SCHEMA_VERSION) "];
    runner_registry [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="runner registry (BYOXPC installs)\nrunner_registry", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="runner_registry: runner registry (BYOXPC installs) | the runner commands; additive-field loader; retired kind aliases kept for recovery; its own schema_version (RUNNER_REGISTRY_SCHEMA_VERSION) "];
    actor_plan [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="normalized actor plan\nactor_plan", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="actor_plan: normalized actor plan | host normalization before process work; admitted public actor requests dispatch to runActors and its serial scheduler; actors, phases with actor and visit, tokens, deliveries and handles by reference with owners, producers and last uses "];
    authority_region [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="per-actor authority region and host custody\nauthority_region", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="authority_region: per-actor authority region and host custody | host creates, unlinks and maps each region; the actor maps its inherited descriptor; custody buffers are host-only; one outbound slot per admitted issue, one inbound slot per recipient delivery and one answer cell per transfer; fixed headers with family, writer, indexes, length, commit, acknowledgement and settlement words; never retained JSON "];
    equipment [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="sealed service equipment inventory and live identity\nequipment", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="equipment: sealed service equipment inventory and live identity | build/BYOXPC seals static inventory; host inspects both artifacts and owned usable actor processes; role/path/hash/CDHash/identifier/team/entitlements plus build identity; per-actor requirements and execution evidence Constructed signing observations exercise complete two-role binding, per-actor boolean requirements, explicit fixture provenance, live path mismatch, process association and ownership/deadline refusal. They do not establish native signature validity or effective authority."];
    authority_setup [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="automatic authority setup account\nauthority_setup", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="authority_setup: automatic authority setup account | host apparatus recorder and worker release-published fixed trailer; bounded per-operation native observations; terminal required-apparatus decision separate from application and cleanup Constructed setup trailer cells establish independently published cleanup eligibility before a terminal decision and malformed-cell rejection. Native authority exercises separately observe mapped regions and symbol bits; this is not exhaustive apparatus-failure coverage. Scheduler controls preserve application observed during cleanup after setup expiry, retain healthy actor progress after another setup failure, and distinguish natural termination-gate completion from later cleanup. These observations do not infer unobserved application."];
    client_capture [shape="note", style="filled", fillcolor="#e8f0fe", color="#2f5597", label="binary client capture\nclient_capture", URL="ARCHITECTURE.md#boundaries-and-their-guards-nodes", tooltip="client_capture: binary client capture | client records transport; controller owns admitted typed capture or exact rejected bytes; binary frame; retained host bytes remain opaque to the client; byte fields are spelled as text only in public JSON "];
    request_file -> held_request [style="solid", color="#2f5597", label="B1 version gate; selectors; augments", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B1: request version gate; selector parse; augment resolution |  "];
    held_request -> run_spec [style="solid", color="#2f5597", label="B2 authorize; decode; admit", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B2: caller authorization; closed-key decode; capacity, then meaning; policy hash |  "];
    run_spec -> shm_region [style="solid", color="#2f5597", label="B3 identity; exit 4 on mismatch", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B3: host writes identity, counts, phase partitions, the expected policy length and slots; worker refuses mismatched identity, invalid partition, an expectation the source buffer cannot hold, or an unusable timebase or allowance before any policy byte |  "];
    shm_region -> reply [style="solid", color="#2f5597", label="B4 phase publication; ordinal release", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B4: per-phase release/acquire publication; exact ordinal before actions after a validated continuous-time decision; disposition from raw facts; collection status agrees with validator observations; native result publication and fresh-read consistency before claims |  Terminal publication erases accepted token storage, releases done and exits. The host retains its mapping and reconciles acknowledgement after confirmed reap only while ownership through acknowledgement remains established, including abnormal exit without done. Poll stop, deadline and disposition remain independent."];
    run_spec -> validator_wire [style="solid", color="#2f5597", label="B5 phase planning; bounded NDJSON", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B5: fresh phase planning; bounded strict NDJSON decode; unique step association within the phase |  "];
    validator_wire -> reply [style="solid", color="#2f5597", label="B6 join, or unavailable", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B6: verdict joined only to its phase and step, or explicit unavailable prediction |  "];
    reply -> client_capture [style="solid", color="#2f5597", label="B7 typed admission; binary capture", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B7: typed reporting gate; binary encoding with rich and minimal failure paths; exact retained host bytes |  "];
    helper_envelope -> envelope [style="solid", color="#2f5597", label="B9 nested; admitted by kind", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B9: nested unchanged and associated with the selected policy/actor; admitted by kind and frame version; per-helper retention is not a cumulative envelope or memory bound |  "];
    evidence_manifest -> envelope [style="solid", color="#2f5597", label="B10 baselines by path and kind", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B10: dossier compares selected binaries with manifest baselines; lookup by exact path and kind |  "];
    runner_registry -> held_request [style="solid", color="#2f5597", label="B11 BYOXPC selection", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B11: selection resolves a BYOXPC target; selector fields stripped before XPC |  "];
    profile_capture -> reply [style="solid", color="#2f5597", label="B12 admitted after apply and integrity", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B12: admitted only after successful application, completion, PID, nonce, input identity and payload integrity checks for its producing worker/apply actor |  "];
    run_spec -> actor_plan [style="solid", color="#2f5597", label="B17 admit the actor form", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B17: closed actor and sandbox objects, phases naming declared actors, single-assignment references used after their producers by their owners, and the per-actor exec exclusion |  Actors 8 items; phases 16 items; issues 32 items; deliveries 64 items; handles 64 items; releases 64 items; identifiers 63 UTF-8 bytes; issue target 1,023 UTF-8 bytes."];
    shm_region -> authority_region [style="solid", color="#2f5597", label="B18 custody gates", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B18: an outbound token enters custody only with the expected framing, writer, action and token indexes, and only while the writer still stands behind it; a delivery is credited only when the recipient's accepted bytes equal the custody copy |  Recipient acceptance is framing only; host equality and usable settlement precede native consume. Source-observed answer and phase completion are separate gates."];
    authority_region -> reply [style="solid", color="#2f5597", label="B19 actor evidence association", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B19: every actor event names its actor and one of that actor's phases, references resolve to their owners in the resource tables, transfers carry no native result, and nothing is credited without the actor's declared or applied setup and its phase's acknowledged release |  A failed exchange may still complete its action and phase; schedule advancement does not require all deliveries to succeed. No native permission or revocation follows from transport evidence."];
    actor_plan -> equipment [style="solid", color="#2f5597", label="B20 bind every actor to selected or unentitled equipment before launch", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B20: bind every actor to selected or unentitled equipment before launch |  Constructed signing observations exercise complete two-role binding, per-actor boolean requirements, explicit fixture provenance, live path mismatch, process association and ownership/deadline refusal. They do not establish native signature validity or effective authority."];
    equipment -> reply [color="#2f5597", style="bold", label="B21 static bindings and per-actor owned live code association; no effective-authority claim", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B21: static bindings and per-actor owned live code association; no effective-authority claim |  Constructed signing observations exercise complete two-role binding, per-actor boolean requirements, explicit fixture provenance, live path mismatch, process association and ownership/deadline refusal. They do not establish native signature validity or effective authority."];
    shm_region -> authority_setup [color="#2f5597", style="bold", label="B22 published setup operations and terminal decision before application", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B22: published setup operations and terminal decision before application |  Constructed setup trailer cells establish independently published cleanup eligibility before a terminal decision and malformed-cell rejection. Native authority exercises separately observe mapped regions and symbol bits; this is not exhaustive apparatus-failure coverage. Scheduler controls preserve application observed during cleanup after setup expiry, retain healthy actor progress after another setup failure, and distinguish natural termination-gate completion from later cleanup. These observations do not infer unobserved application."];
    authority_setup -> reply [color="#2f5597", style="bold", label="B23 preserve apparatus, application and final process observations separately", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B23: preserve apparatus, application and final process observations separately |  Constructed setup trailer cells establish independently published cleanup eligibility before a terminal decision and malformed-cell rejection. Native authority exercises separately observe mapped regions and symbol bits; this is not exhaustive apparatus-failure coverage. Scheduler controls preserve application observed during cleanup after setup expiry, retain healthy actor progress after another setup failure, and distinguish natural termination-gate completion from later cleanup. These observations do not infer unobserved application."];
    client_capture -> envelope [style="solid", color="#2f5597", label="B24 decode; typed checks; JSON", URL="ARCHITECTURE.md#boundaries-and-their-guards-edges", tooltip="B24: bounded binary decode and exact versions; typed coherence checks; rejected bytes retained; JSON projection borrows records |  Typed coherence checks govern claims; rejected or conflicting records retain native observations and withhold dependent claims."];
}
