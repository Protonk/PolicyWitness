@@ -0,0 +1,34 @@
+//! `policy-witness help`: prints one card the build stored.
+//!
+//! `build.rs` renders the cards from the definitions in `interface` and the
+//! example specimen; nothing is rendered, read or collected here.
+
+use std::ffi::OsString;
+use std::io::Write;
+
+use crate::interface::commands::Topic;
+
+const BASE: &str = include_str!(concat!(env!("OUT_DIR"), "/help/base.txt"));
+const RUN: &str = include_str!(concat!(env!("OUT_DIR"), "/help/run.txt"));
+const EXAMPLE: &str = include_str!(concat!(env!("OUT_DIR"), "/help/example.txt"));
+const RESULT: &str = include_str!(concat!(env!("OUT_DIR"), "/help/result.txt"));
+
+pub fn card(topic: Option<Topic>) -> &'static str {
+    match topic {
+        None => BASE,
+        Some(Topic::Run) => RUN,
+        Some(Topic::Example) => EXAMPLE,
+        Some(Topic::Result) => RESULT,
+    }
+}
+
+/// Writes the addressed card to stdout and nothing to stderr. Only a failed
+/// write or flush is not exit 0.
+pub fn cmd_help(tail: &[OsString]) -> i32 {
+    let mut out = std::io::stdout().lock();
+    let card = card(Topic::select(tail));
+    match out.write_all(card.as_bytes()).and_then(|()| out.flush()) {
+        Ok(()) => 0,
+        Err(_) => 2,
+    }
+}
diff --git a/controller/src/interface/commands.rs b/controller/src/interface/commands.rs
new file mode 100644
index 00000000..681d0803
--- /dev/null
+++ b/controller/src/interface/commands.rs
@@ -0,0 +1,122 @@
+//! Top-level commands and help topics.
+
+use std::ffi::{OsStr, OsString};
+
+enumerated!(
+    /// A first argument the dispatcher recognizes.
+    Command {
+        Help,
+        Run,
+        Example,
+        TestInput,
+        Runner,
+        VersionFlag,
+        Version,
+    }
+);
+
+/// What the dispatcher does with the arguments after a command.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Tail {
+    /// The first argument addresses a help topic; the rest are discarded.
+    Topic,
+    /// `run_args` governs every argument.
+    RunArguments,
+    /// Any argument is refused.
+    RefusesAny,
+    /// Arguments are accepted and ignored.
+    Discards,
+    /// The command's own parser receives the arguments; its definitions are
+    /// not enumerated here.
+    Unenumerated,
+}
+
+pub struct CommandDef {
+    pub spelling: &'static str,
+    pub tail: Tail,
+}
+
+impl Command {
+    pub const fn def(self) -> CommandDef {
+        let (spelling, tail) = match self {
+            Command::Help => ("help", Tail::Topic),
+            Command::Run => ("run", Tail::RunArguments),
+            Command::Example => ("example", Tail::RefusesAny),
+            Command::TestInput => ("test-input", Tail::Unenumerated),
+            Command::Runner => ("runner", Tail::Unenumerated),
+            Command::VersionFlag => ("--version", Tail::Discards),
+            Command::Version => ("version", Tail::Discards),
+        };
+        CommandDef { spelling, tail }
+    }
+
+    /// The command a first argument names: an exact comparison of the whole
+    /// argument, so a differently cased or non-UTF-8 argument names none.
+    pub fn recognize(argument: &OsStr) -> Option<Command> {
+        Command::ALL
+            .iter()
+            .copied()
+            .find(|command| argument == OsStr::new(command.def().spelling))
+    }
+}
+
+/// A tail the command's rule refused.
+#[derive(Debug, PartialEq, Eq)]
+pub struct TailRefused;
+
+impl Tail {
+    /// The arguments the command's handler receives.
+    pub fn admit(self, arguments: &[OsString]) -> Result<&[OsString], TailRefused> {
+        match self {
+            Tail::Topic | Tail::RunArguments | Tail::Unenumerated => Ok(arguments),
+            Tail::Discards => Ok(&[]),
+            Tail::RefusesAny if arguments.is_empty() => Ok(arguments),
+            Tail::RefusesAny => Err(TailRefused),
+        }
+    }
+}
+
+enumerated!(
+    /// A help topic: one card beside the base card.
+    Topic {
+        Run,
+        Example,
+        Result,
+    }
+);
+
+/// Where a topic's address comes from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Address {
+    /// The topic describes a command and shares its spelling.
+    Command(Command),
+    /// The topic has a spelling of its own.
+    Own(&'static str),
+}
+
+impl Topic {
+    pub const fn source(self) -> Address {
+        match self {
+            Topic::Run => Address::Command(Command::Run),
+            Topic::Example => Address::Command(Command::Example),
+            Topic::Result => Address::Own("result"),
+        }
+    }
+
+    pub const fn address(self) -> &'static str {
+        match self.source() {
+            Address::Command(command) => command.def().spelling,
+            Address::Own(spelling) => spelling,
+        }
+    }
+
+    /// The topic the argument after `help` addresses. Only that argument is
+    /// read; an absent, unregistered or non-UTF-8 one addresses no topic.
+    pub fn select(tail: &[OsString]) -> Option<Topic> {
+        let argument = tail.first()?;
+        Topic::ALL
+            .iter()
+            .copied()
+            .find(|topic| argument.as_os_str() == OsStr::new(topic.address()))
+    }
+}
diff --git a/controller/src/interface/mod.rs b/controller/src/interface/mod.rs
new file mode 100644
index 00000000..edc6b5af
--- /dev/null
+++ b/controller/src/interface/mod.rs
@@ -0,0 +1,26 @@
+//! The definitions that govern the command line and the run result.
+//!
+//! Dispatch, help selection, `run`'s argument parsing, every reader of the
+//! runner-kind vocabulary and run result selection consume these tables.
+//! `build.rs` includes the same files to render the help cards and write the
+//! interface inventory, so a card states a spelling only because the code
+//! that admits it holds that spelling. The module uses `std` alone.
+
+/// An enum whose `ALL` lists every variant in declaration order.
+macro_rules! enumerated {
+    ($(#[$meta:meta])* $name:ident { $($(#[$variant_meta:meta])* $variant:ident),+ $(,)? }) => {
+        $(#[$meta])*
+        #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+        pub enum $name { $($(#[$variant_meta])* $variant),+ }
+        impl $name {
+            // build.rs enumerates tables the binary only indexes.
+            #[allow(dead_code)]
+            pub const ALL: &'static [$name] = &[$($name::$variant),+];
+        }
+    };
+}
+
+pub mod commands;
+pub mod result;
+pub mod run_args;
+pub mod runner_kind;
diff --git a/controller/src/interface/result.rs b/controller/src/interface/result.rs
new file mode 100644
index 00000000..a972d6ca
--- /dev/null
+++ b/controller/src/interface/result.rs
@@ -0,0 +1,235 @@
+//! Selection of the `run` result: the outcome label, `ok`, and the one exit
+//! status that is both the result's exit field and the process status.
+
+enumerated!(
+    /// An outcome label the controller itself selects.
+    Label {
+        BadRequest,
+        ToolError,
+        Finished,
+        RunnerResponseUnavailable,
+    }
+);
+
+impl Label {
+    pub const fn spelling(self) -> &'static str {
+        match self {
+            Label::BadRequest => "bad_request",
+            Label::ToolError => "tool_error",
+            Label::Finished => "finished",
+            Label::RunnerResponseUnavailable => "runner_response_unavailable",
+        }
+    }
+}
+
+enumerated!(
+    /// Why client or reply admission refused a capture.
+    Refusal {
+        MissingRunnerClient,
+        UnsupportedRunnerClient,
+        MalformedRunnerClient,
+        RunnerReplyTruncated,
+        UnsupportedRunnerResponse,
+        MalformedRunnerResponse,
+        XpcError,
+        XpcTimeout,
+        XpcAcquisitionFailed,
+        XpcSubmissionRefused,
+        XpcProtocolError,
+        RunnerClientError,
+    }
+);
+
+impl Refusal {
+    pub const fn spelling(self) -> &'static str {
+        match self {
+            Refusal::MissingRunnerClient => "missing_runner_client",
+            Refusal::UnsupportedRunnerClient => "unsupported_runner_client",
+            Refusal::MalformedRunnerClient => "malformed_runner_client",
+            Refusal::RunnerReplyTruncated => "runner_reply_truncated",
+            Refusal::UnsupportedRunnerResponse => "unsupported_runner_response",
+            Refusal::MalformedRunnerResponse => "malformed_runner_response",
+            Refusal::XpcError => "xpc_error",
+            Refusal::XpcTimeout => "xpc_timeout",
+            Refusal::XpcAcquisitionFailed => "xpc_acquisition_failed",
+            Refusal::XpcSubmissionRefused => "xpc_submission_refused",
+            Refusal::XpcProtocolError => "xpc_protocol_error",
+            Refusal::RunnerClientError => "runner_client_error",
+        }
+    }
+}
+
+/// What the controller concluded about one run, before a result exists.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Disposition<'a> {
+    /// The controller refused the request it read.
+    LocalRequestRefusal,
+    /// The controller could not do its own work, request delivery included.
+    ToolFailure,
+    /// Client or reply admission refused the capture.
+    AdmissionRefusal(Refusal),
+    /// The capture was admitted. `host_outcome` is the admitted host
+    /// reply's label, absent when the completion carries no host reply.
+    /// `integrity_issues` counts the controller's findings about the reply.
+    Admitted {
+        host_outcome: Option<&'a str>,
+        integrity_issues: usize,
+    },
+}
+
+enumerated!(
+    /// The class of a disposition.
+    Class {
+        LocalRequestRefusal,
+        ToolFailure,
+        AdmissionRefusal,
+        Admitted,
+    }
+);
+
+impl Disposition<'_> {
+    pub const fn class(&self) -> Class {
+        match self {
+            Disposition::LocalRequestRefusal => Class::LocalRequestRefusal,
+            Disposition::ToolFailure => Class::ToolFailure,
+            Disposition::AdmissionRefusal(_) => Class::AdmissionRefusal,
+            Disposition::Admitted { .. } => Class::Admitted,
+        }
+    }
+}
+
+/// A row's condition on the admitted host label.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Host {
+    /// The row does not read the host label.
+    Unread,
+    Is(Label),
+    Present,
+    Absent,
+}
+
+/// Where a row's outcome label comes from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Fixed(Label),
+    /// The selected refusal's label.
+    Refusal,
+    /// The admitted host label, retained.
+    HostLabel,
+}
+
+enumerated!(
+    /// The rows of the relation, in selection order: the first row whose
+    /// class and host condition hold is selected.
+    Row {
+        LocalRequestRefusal,
+        ToolFailure,
+        AdmissionRefusal,
+        AdmittedFinished,
+        AdmittedOther,
+        AdmittedUnavailable,
+    }
+);
+
+pub struct RowDef {
+    pub class: Class,
+    pub host: Host,
+    pub outcome: Outcome,
+    pub ok: bool,
+    pub exit: i32,
+}
+
+impl Row {
+    pub const fn def(self) -> RowDef {
+        let (class, host, outcome, ok, exit) = match self {
+            Row::LocalRequestRefusal => (
+                Class::LocalRequestRefusal,
+                Host::Unread,
+                Outcome::Fixed(Label::BadRequest),
+                false,
+                1,
+            ),
+            Row::ToolFailure => (
+                Class::ToolFailure,
+                Host::Unread,
+                Outcome::Fixed(Label::ToolError),
+                false,
+                2,
+            ),
+            Row::AdmissionRefusal => (
+                Class::AdmissionRefusal,
+                Host::Unread,
+                Outcome::Refusal,
+                false,
+                1,
+            ),
+            Row::AdmittedFinished => (
+                Class::Admitted,
+                Host::Is(Label::Finished),
+                Outcome::HostLabel,
+                true,
+                0,
+            ),
+            Row::AdmittedOther => (Class::Admitted, Host::Present, Outcome::HostLabel, false, 1),
+            Row::AdmittedUnavailable => (
+                Class::Admitted,
+                Host::Absent,
+                Outcome::Fixed(Label::RunnerResponseUnavailable),
+                false,
+                1,
+            ),
+        };
+        RowDef {
+            class,
+            host,
+            outcome,
+            ok,
+            exit,
+        }
+    }
+}
+
+/// The selected result. `exit` is the result's exit field and the process
+/// status; nothing else supplies either.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Selection {
+    pub row: Row,
+    pub outcome: String,
+    pub ok: bool,
+    pub exit: i32,
+}
+
+pub fn select(disposition: &Disposition) -> Selection {
+    let (refusal, host_outcome) = match *disposition {
+        Disposition::AdmissionRefusal(refusal) => (Some(refusal), None),
+        Disposition::Admitted { host_outcome, .. } => (None, host_outcome),
+        Disposition::LocalRequestRefusal | Disposition::ToolFailure => (None, None),
+    };
+    let class = disposition.class();
+    for row in Row::ALL.iter().copied() {
+        let def = row.def();
+        let host_holds = match def.host {
+            Host::Unread => true,
+            Host::Is(label) => host_outcome == Some(label.spelling()),
+            Host::Present => host_outcome.is_some(),
+            Host::Absent => host_outcome.is_none(),
+        };
+        if def.class != class || !host_holds {
+            continue;
+        }
+        let outcome = match def.outcome {
+            Outcome::Fixed(label) => Some(label.spelling()),
+            Outcome::Refusal => refusal.map(Refusal::spelling),
+            Outcome::HostLabel => host_outcome,
+        };
+        if let Some(outcome) = outcome {
+            return Selection {
+                row,
+                outcome: outcome.to_string(),
+                ok: def.ok,
+                exit: def.exit,
+            };
+        }
+    }
+    unreachable!("every disposition has a row that supplies its outcome")
+}
