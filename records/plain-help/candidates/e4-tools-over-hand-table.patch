+fn snapbox_step(bin: &Path, step: &serde_json::Value, scratch: &Path) -> Result<(), &'static str> {
+    use snapbox::IntoData;
+    if step.get("stdout_pipe").is_some() {
+        return Err("a stdout without a reader");
+    }
+    let place = |text: &str| text.replace("{scratch}", &scratch.to_string_lossy());
+    let mut command = snapbox::cmd::Command::new(bin)
+        .args(os_arguments(step, scratch).unwrap())
+        .stdin("");
+    for (name, value) in step["env"].as_object().into_iter().flatten() {
+        command = command.env(name, place(value.as_str().unwrap()));
+    }
+    let mut assert = command.assert().code(step["status"].as_i64().unwrap() as i32);
+    if let Some(expected) = step["stdout"].as_str() {
+        assert = assert.stdout_eq(expected.to_string().raw());
+    }
+    match (step["stderr"].as_str(), step["stderr_prefix"].as_str()) {
+        (Some(expected), _) => assert = assert.stderr_eq(expected.to_string().raw()),
+        (None, Some(prefix)) => assert = assert.stderr_eq(format!("{prefix}...\n")),
+        (None, None) => panic!("a step states stderr or stderr_prefix"),
+    }
+    let output = assert.get_output().clone();
+    if let Some(expected) = step["stdout_json"].as_object() {
+        let value: serde_json::Value = serde_json::from_slice(&output.stdout).expect("one JSON document");
+        for (pointer, wanted) in expected {
+            assert_eq!(value.pointer(pointer), Some(wanted), "{pointer}");
+        }
+    }
+    if let Some(name) = step["save_stdout"].as_str() {
+        std::fs::write(scratch.join(name), &output.stdout).unwrap();
+    }
+    Ok(())
+}
+
+/// Runs the corpus through snapbox; returns the cases its command cannot hold.
+fn snapbox_cases(bin: &Path, corpus: &serde_json::Value) -> Vec<String> {
+    let mut unexpressed = Vec::new();
+    for (index, case) in corpus["cases"].as_array().unwrap().iter().enumerate() {
+        let id = case["id"].as_str().unwrap();
+        let scratch = env::temp_dir().join(format!("pw-snapbox-{}-{index}", std::process::id()));
+        std::fs::create_dir_all(&scratch).unwrap();
+        let steps = match case["steps"].as_array() {
+            Some(steps) => steps.clone(),
+            None => vec![case.clone()],
+        };
+        for step in &steps {
+            if let Err(reason) = snapbox_step(bin, step, &scratch) {
+                unexpressed.push(format!("{id}: {reason}"));
+            }
+        }
+        std::fs::remove_dir_all(&scratch).unwrap();
+    }
+    unexpressed
+}
+
+#[test]
+fn interface_cases_hold_under_snapbox() {
+    if !integration_enabled() {
+        return;
+    }
+    let unexpressed = snapbox_cases(&require_pw_bin(), &interface_corpus());
+    eprintln!("snapbox cannot hold {} cases: {unexpressed:?}", unexpressed.len());
+}
+
+#[test]
+fn snapbox_rejects_wrong_status_and_stream() {
+    if !integration_enabled() {
+        return;
+    }
+    let bin = require_pw_bin();
+    let card = "run\nexample\nresult\n";
+    let passes = |status: i64, stdout: &str, stderr: &str| {
+        let corpus = serde_json::json!({"cases": [{"id": "control", "args": ["help"], "status": status,
+                                                    "stdout": stdout, "stderr": stderr}]});
+        let bin = bin.clone();
+        std::panic::catch_unwind(move || snapbox_cases(&bin, &corpus)).is_ok()
+    };
+    assert!(passes(0, card, ""));
+    assert!(!passes(2, card, ""));
+    assert!(!passes(0, "", card));
+}
